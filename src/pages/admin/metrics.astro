---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { slugifyTitle } from "../../lib/site";
import "../../components/studio.css";

// Baked in at build time so every painting has a row without the analytics
// backend. Counts load client-side. Drafts and trashed paintings have no
// buyer page, so they're excluded.
const seed = (await getCollection("paintings"))
  .filter((p) => p.data.trash !== true && p.data.draft !== true)
  .map((p) => ({
    slug: slugifyTitle(p.data.title),
    title: p.data.title,
    sold: p.data.sold,
    draft: p.data.draft === true,
    image: p.data.image.src,
  }))
  .filter((r) => r.title !== "");
const seedJson = JSON.stringify(seed).replace(/</g, "\\u003c");
---

<Layout title="Admin - Metrics" wordmark="admin" backdrop="metrics">
  <main class="admin" id="main">
    <section id="sec-views" class="prose">
      <h2>Metrics</h2>
      <p>
        Most viewed first — the past 30 days. Ties favor what's still for sale.
      </p>
      <p class="metrics-total">
        <strong id="stats-total">—</strong>
        <span>views in the past 30 days</span>
      </p>
      <ul id="stats-body"></ul>
      <p class="hint" id="stats-note"></p>
      <script
        is:inline
        type="application/json"
        id="stats-seed"
        set:html={seedJson}
      />
    </section>
  </main>
</Layout>

<script src="../../components/StatsPanel.ts"></script>

<style>
  #stats-note:empty {
    display: none;
  }
  /* The total is the main figure, so it's large and full ink. */
  .metrics-total {
    margin: 1.5rem 0 2rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .metrics-total strong {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    font-weight: 500;
    font-size: 2.6rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .metrics-total span {
    color: var(--muted);
    font-size: 0.95rem;
  }
  /* Ranked rows: thumbnail, title, count. The count column has a fixed
     width so numbers line up. A thin accent bar under each row shows its
     share relative to the most viewed. */
  #stats-body {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  :global(#stats-body .metric-row) {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 0 0.9rem;
    align-items: center;
    padding-bottom: 0.55rem;
  }
  :global(#stats-body .metric-thumb) {
    width: 3rem;
    height: 3rem;
    object-fit: cover;
    border-radius: 0.5rem;
    grid-row: span 1;
  }
  :global(#stats-body .metric-title) {
    font-weight: 600;
    color: var(--ink);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* As a grid item the title would stretch across the column, making
       empty space hoverable and clickable. Size it to its text. */
    justify-self: start;
  }
  :global(#stats-body .metric-sold) {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85em;
  }
  :global(#stats-body .metric-views) {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    min-width: 2.5rem;
    text-align: right;
  }
  :global(#stats-body .metric-bar) {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    opacity: 0.55;
  }
  :global(#stats-body .metric-row a:hover) {
    text-decoration-color: currentColor;
  }
</style>
