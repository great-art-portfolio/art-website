---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Layout from "../layouts/Layout.astro";
import { CREDITS } from "../lib/credits";

// Full licence texts from the installed packages, read once at build.
// Direct dependencies sit at node_modules/<name>, pnpm included.
const credits = CREDITS.map((c) => ({
  ...c,
  text:
    c.text ??
    readFileSync(
      join(process.cwd(), "node_modules", c.pkg ?? "", "LICENSE"),
      "utf8",
    ).trim(),
}));
---

<Layout
  title="Credits"
  description="The open-source software and fonts this gallery is built with, and their licences."
>
  <main class="credits" id="main">
    <h1>Credits</h1>
    <p>
      This gallery is built with free, open-source software and fonts. Their
      makers ask that their licences travel with them, so here they are, with
      thanks.
    </p>
    <ul>
      {credits.map((c) => (
        <li>
          <h2>
            <a href={c.url} rel="noopener">
              {c.name}
            </a>
          </h2>
          <p>{c.use}</p>
          <details>
            <summary>{c.licence}</summary>
            <pre>{c.text}</pre>
          </details>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .credits {
    max-width: 44rem;
    margin: 0 auto;
    padding: 1rem 1.25rem 4rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1.75rem;
  }
  h2 {
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
  }
  h2 a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.2em;
  }
  li p {
    margin: 0 0 0.35rem;
  }
  summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    width: fit-content;
  }
  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
</style>
