---
import Layout from "../../layouts/Layout.astro";
import "../../components/studio.css";
import { SITE_URL } from "../../lib/site";
import { broadcastDefaults } from "../../../functions/_lib/notify";

// Subject and body start with the standard text. The sign-off and
// unsubscribe aren't editable. The template appends them to every send.
const defaults = broadcastDefaults(SITE_URL);
---

<Layout title="Admin - Email" wordmark="admin" noindex>
  <main class="admin" id="main">
    <section id="sec-email" class="prose">
      <h2>Send email</h2>
      <p class="hint">
        Sends one email to the whole list. Blank fields send the standard note;
        the sign-off and unsubscribe stay on every send. Buyers see it dressed
        in the gallery style.
      </p>
      <label>
        Subject
        <input
          type="text"
          id="email-subject"
          maxlength="200"
          autocomplete="off"
          value={defaults.subject}
        />
      </label>
      <label>
        Body
        <textarea
          id="email-body"
          rows="6"
          maxlength="2000"
          autocomplete="off"
        >{defaults.body}</textarea>
      </label>
      <div id="email-preview" hidden>
        <p class="preview-subject">
          <span>Subject:</span>
          <strong id="email-preview-subject"></strong>
        </p>
        <iframe
          id="email-preview-body"
          title="How the email will look"
          sandbox=""
        ></iframe>
      </div>
      <p class="hint" id="email-preview-fallback" hidden>
        The preview didn't load — the button still sends the standard note.
      </p>
      <div class="row">
        <button type="button" id="email-send">
          Send email to subscribers 📧
        </button>
      </div>
      <p class="hint" id="email-status" role="status"></p>
    </section>
  </main>
</Layout>

<script src="../../components/AdminPanel.ts"></script>

<style>
  /* Left-aligned flex row that wraps on narrow phones. The result line
     below stays hidden until there's a message. */
  #sec-email .row {
    margin-top: 1rem;
    justify-content: start;
  }
  #email-status {
    margin: 0.75rem 0 0;
  }
  #email-status:empty {
    display: none;
  }
  /* The preview is a card so it reads as the message rather than page
     text. The body is the real styled email in a sandboxed iframe. */
  #email-preview {
    margin-top: 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem 1.1rem;
  }
  #email-preview[hidden],
  #email-preview-fallback[hidden] {
    display: none;
  }
  #email-preview .preview-subject {
    margin: 0 0 0.6rem;
  }
  #email-preview .preview-subject span {
    opacity: 0.7;
    margin-right: 0.4rem;
  }
  #email-preview-body {
    display: block;
    width: 100%;
    height: 22rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
  }
</style>
