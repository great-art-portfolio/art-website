---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Not found — Barbara Straka Original Paintings"
  description="This page doesn't exist. Browse the collection of original paintings instead."
>
  <main class="missing" id="main">
    <p class="eyebrow">Off the wall — 404</p>
    <h1>That wall is empty.</h1>
    <p>
      The page you're looking for isn't here — it may have moved. The collection
      is this way:
    </p>
    <p>
      <a href="/#collection" class="btn-primary">Browse the collection</a>
    </p>
  </main>
</Layout>

<style>
  .missing {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-weight: 500;
    margin: 0 0 1rem;
  }
  p {
    color: var(--muted);
  }
</style>
