---
import ClientRouter from "astro/components/ClientRouter.astro";
import Analytics from "../components/Analytics.astro";
import Signature from "../components/Signature.astro";
import AdminWordmark from "../components/AdminWordmark.astro";
import background from "../assets/background-warm.svg";
import { ARTIST_LOCATION, ARTIST_NAME, SITE_URL, siteTitle } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** "signature" on public pages, "admin" on studio pages. */
  wordmark?: "signature" | "admin";
  /** Studio previews are for her eyes only — never indexed. */
  noindex?: boolean;
  /** Alias pages (old slugs) read under the current slug's path. */
  canonical?: string;
}

const {
  title = siteTitle(),
  description = "Original nature and abstract paintings, direct from the artist's studio.",
  image = "/apple-touch-icon.png",
  // "signature" on public pages, "admin" on studio pages.
  wordmark = "signature",
  noindex = false,
  canonical: canonicalOverride,
} = Astro.props;

// Relative paths: the static build bakes pages with a placeholder origin,
// so only the path survives the build correctly on every host.
const selfPath =
  Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, "") : "/";
const canonical = canonicalOverride ?? selfPath;
const year = new Date().getFullYear();
const artistLabel = ARTIST_NAME ?? "The Studio";
// Studio sections live in the header nav now (one nav, not two).
// Rooms match nothing — they keep every door but mark none current.
function adminSection(path: string): string | null {
  const clean = path.length > 1 ? path.replace(/\/$/, "") : path;
  if (clean === "/admin") return "collection";
  if (clean.startsWith("/admin/banner")) return "banner";
  if (clean.startsWith("/admin/views")) return "views";
  if (clean.startsWith("/admin/guide")) return "guide";
  return null;
}
const currentSection = adminSection(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="theme-color"
      content="#faf7f1"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#171512"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(canonical, SITE_URL).href} />
    <meta property="og:image" content={new URL(image, SITE_URL).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Art Gallery</title>
    <ClientRouter />
    <Analytics />
  </head>
  <body>
    <script>
      // Every page fades in on arrival — View Transitions swaps included.
      // Opacity only, never movement: the browser snaps swaps entirely
      // under reduced motion, so this author-run fade is what keeps them
      // smooth there. (Web Animations aren't covered by the transition
      // spec's reduced-motion kill the way pseudo-element keyframes are.)
      // Inline scripts re-run on every swap — wire once.
      if (window.__pageFadeWired !== true) {
        window.__pageFadeWired = true;
        document.addEventListener("astro:after-swap", () => {
          const main = document.getElementById("main");
          if (main !== null && typeof main.animate === "function") {
            main.animate([{ opacity: 0 }, { opacity: 1 }], {
              duration: 220,
              easing: "ease",
            });
          }
        });
      }
    </script>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        <a
          href={wordmark === "admin" ? "/admin" : "/"}
          id="signature"
          aria-label={wordmark === "admin"
            ? "Admin home"
            : "Home — back to the gallery"}
        >
          {wordmark === "admin" ? <AdminWordmark /> : <Signature />}
        </a>
        <div class="nav-links">
          {
            wordmark === "admin" ? (
              <>
                {(
                  [
                    ["collection", "/admin", "Collection"],
                    ["banner", "/admin/banner", "Banner"],
                    ["views", "/admin/views", "Views"],
                    ["guide", "/admin/guide", "Guide"],
                  ] as const
                ).map(([id, href, label]) => (
                  <a
                    href={href}
                    class="sec keep"
                    aria-current={currentSection === id ? "page" : undefined}
                  >
                    {label}
                  </a>
                ))}
                <a
                  href="/"
                  class="keep"
                  id="leave-admin"
                  aria-label="Leave Admin"
                >
                  <span aria-hidden="true" class="leave-full">
                    ← Leave Admin
                  </span>
                  <span aria-hidden="true" class="leave-short">
                    ←
                  </span>
                </a>
                <a href="/admin/paintings/new" class="nav-cta">
                  Add painting
                </a>
              </>
            ) : (
              <>
                <a href="/#collection">Collection</a>
                <a href="/#about">About</a>
                <button type="button" id="notify-nav" class="nav-cta">
                  Notify me
                </button>
              </>
            )
          }
        </div>
      </nav>
    </header>
    {
      /* Studio toast: news finds her wherever she is scrolled. Empty
         means gone entirely (see :empty below); buyer pages never fill
         it. Moved up from the old second nav so one nav is enough. */
      wordmark === "admin" && (
        <p id="admin-status" role="status" data-tone="ok" />
      )
    }

    <img
      id="background"
      src={background.src}
      alt=""
      fetchpriority="high"
      aria-hidden="true"
    />
    <slot />

    <footer class="site-footer">
      <p class="footer-mark">{artistLabel} · {ARTIST_LOCATION}</p>
      <p class="footer-sub">
        Originals are one of a kind — prints of most pieces available on
        request.
      </p>
      <p class="footer-sub">
        <a href="/privacy">Privacy</a> — no cookies, no trackers
        <button type="button" id="install-app" hidden
          ><span>Install the gallery app</span></button
        >
      </p>
      <p class="footer-sub">© {year} {artistLabel}</p>
    </footer>

    {
      wordmark === "signature" && (
        <dialog
          id="notify-dialog"
          aria-labelledby="notify-dialog-title"
          closedby="any"
        >
          <form method="dialog" class="notify-close-row">
            <button
              type="submit"
              id="notify-close"
              aria-label="Close notifications"
            >
              <svg
                viewBox="0 0 16 16"
                width="14"
                height="14"
                aria-hidden="true"
              >
                <path
                  d="M2 2l12 12M14 2L2 14"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
            </button>
          </form>
          <h3 id="notify-dialog-title">Never miss a new painting</h3>
          <p id="notify-push-blurb">
            One tap — your browser tells you when something new is hung.
          </p>
          <button type="button" id="notify-btn" class="btn-primary">
            Notify me with this browser
          </button>
          <div class="email-capture">
            <p>
              Prefer email? One email per new painting, nothing else, and your
              address is never shared. Unsubscribe any time with one click.
            </p>
            <form id="notify-email-form">
              <label>
                Email address
                <input
                  type="email"
                  id="notify-email"
                  name="email"
                  required
                  maxlength="254"
                  autocomplete="email"
                  placeholder="you@example.com"
                />
              </label>
              <div id="notify-turnstile-mount" />
              <button type="submit" class="btn-ghost">
                Join the list <span aria-hidden="true">📨</span>
              </button>
            </form>
          </div>
          <div class="status-wrap" id="notify-status-wrap">
            <p class="hint" id="notify-status" role="status" />
          </div>
        </dialog>
      )
    }

    <script>
      // Offline support: cached gallery shell + artwork, queued posts.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            // Offline mode unavailable — the site still works online.
          });
        });
      }
      // Optional install: never prompts on its own. Only when the browser
      // offers installation does a quiet footer button appear — one tap
      // there shows the browser's own install dialog.
      window.addEventListener("beforeinstallprompt", (e) => {
        e.preventDefault();
        window.__deferredInstall = e;
        const btnEl = document.getElementById("install-app");
        const btn = btnEl instanceof HTMLButtonElement ? btnEl : null;
        if (btn !== null) btn.hidden = false;
      });
      document.addEventListener("click", (e) => {
        const tEl =
          e.target instanceof Element ? e.target.closest("#install-app") : null;
        const t = tEl instanceof HTMLElement ? tEl : null;
        const ask = window.__deferredInstall;
        if (
          t === null ||
          ask === null ||
          ask === undefined ||
          !("prompt" in ask) ||
          typeof ask.prompt !== "function"
        )
          return;
        window.__deferredInstall = null;
        t.hidden = true;
        ask.prompt();
      });
    </script>

    <script>
      // Collector signup lives in a modal, not a page section: the nav
      // "Notify me" and hero buttons open it wherever they appear. No
      // static imports — inline page scripts ship as classic scripts, so
      // `import` kills the whole block; dynamic import() is bundled fine.
      // View Transitions keep this module alive across navigations (it
      // runs once per document), so elements are read live on every use
      // and wiring runs immediately AND on astro:page-load, guarded so a
      // double-fire on the same DOM wires nothing twice.
      // (Inline scripts are plain JS — annotations don't survive astro
      // check, so this stays annotation-free on purpose.)
      function notifyPush() {
        return import("../lib/push");
      }

      let notifyTurnstileToken = "";

      // Spam check, shared with the inquiry form via lib/turnstile-widget.
      function loadNotifyTurnstile() {
        void import("../lib/turnstile-widget").then(({ ensureTurnstile }) =>
          ensureTurnstile("#notify-turnstile-mount", (t) => {
            notifyTurnstileToken = t;
          }),
        );
      }

      // Status words fade in, then fade back out on their own a few
      // seconds later — nothing in the modal lingers. A counter on the
      // element drops a late fade-out when a newer message lands.
      // Sticky messages (a blocked state she must act on) stay until
      // replaced. Fades run under every motion setting: they are opacity
      // only, never movement.
      function notifySay(el = document.body, msg = "", sticky = false) {
        const n = Number(el.dataset.say ?? "0") + 1;
        el.dataset.say = String(n);
        el.textContent = msg;
        const wrap =
          el instanceof HTMLElement ? el.closest(".status-wrap") : null;
        if (wrap !== null) wrap.classList.toggle("open", msg !== "");
        if (typeof el.animate === "function" && msg !== "") {
          // A beat behind the unfold, so words arrive once their room
          // exists instead of squeezing through mid-animation.
          el.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: 200,
            delay: 100,
          });
        }
        if (!sticky && msg !== "") {
          window.setTimeout(() => {
            if (el.dataset.say === String(n)) notifyUnsay(el);
          }, 5000);
        }
      }
      function notifyUnsay(el = document.body) {
        const n = Number(el.dataset.say ?? "0") + 1;
        el.dataset.say = String(n);
        const wrap =
          el instanceof HTMLElement ? el.closest(".status-wrap") : null;
        if (wrap !== null) wrap.classList.remove("open");
        if (el.textContent === "" || typeof el.animate !== "function") {
          el.textContent = "";
          return;
        }
        const out = el.animate([{ opacity: 1 }, { opacity: 0 }], {
          duration: 150,
        });
        out.onfinish = () => {
          if (el.dataset.say === String(n)) el.textContent = "";
        };
      }

      function openNotify() {
        const dlgEl = document.getElementById("notify-dialog");
        const dlg = dlgEl instanceof HTMLDialogElement ? dlgEl : null;
        if (dlg === null) return;
        if (!dlg.open) {
          if (typeof dlg.showModal === "function") dlg.showModal();
          else dlg.setAttribute("open", "");
        }
        // The modal renders hidden until opened — render the spam check
        // on open so it measures correctly. No-op when already rendered.
        loadNotifyTurnstile();
        const closeEl = document.getElementById("notify-close");
        const closeBtn = closeEl instanceof HTMLButtonElement ? closeEl : null;
        if (closeBtn !== null) closeBtn.focus();
      }

      // Email capture needs no browser features — wire it once, always on.
      // Spam: Cloudflare Turnstile when configured, shared with buy form.
      function wireNotifyEmail() {
        const formEl = document.getElementById("notify-email-form");
        const form = formEl instanceof HTMLFormElement ? formEl : null;
        const inputEl = document.getElementById("notify-email");
        const input = inputEl instanceof HTMLInputElement ? inputEl : null;
        const hint = document.getElementById("notify-status");
        if (form === null || input === null || hint === null) return;
        if (form.dataset.wired === "1") return;
        form.dataset.wired = "1";
        loadNotifyTurnstile();
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const email = input.value.trim();
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            notifySay(
              hint,
              "That email doesn't look right — check it and try again.",
            );
            input.focus();
            return;
          }
          notifySay(hint, "Joining…");
          fetch("/api/collectors", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email,
              turnstileToken: notifyTurnstileToken,
            }),
          })
            .then((res) => {
              if (res.ok) {
                notifySay(
                  hint,
                  "You're on the list — one email per new painting.",
                );
                input.value = "";
              } else if (res.status === 400) {
                notifySay(
                  hint,
                  "That email doesn't look right — check it and try again.",
                );
              } else {
                notifySay(hint, "That didn't work — try again in a bit.");
              }
            })
            .catch(() => {
              notifySay(hint, "That didn't work — try again in a bit.");
            });
        });
      }

      async function paintNotify() {
        const btnEl = document.getElementById("notify-btn");
        const btn = btnEl instanceof HTMLButtonElement ? btnEl : null;
        const hint = document.getElementById("notify-status");
        const blurb = document.getElementById("notify-push-blurb");
        if (btn === null || hint === null) return;
        wireNotifyEmail();
        // Email works for everyone; the push button only appears where
        // push can work.
        const s = await notifyPush().then((api) => api.pushState());
        if (s === "unsupported") {
          btn.hidden = true;
          if (blurb !== null) blurb.hidden = true;
          return;
        }
        if (s === "subscribed") {
          btn.textContent = "Notifying this browser — turn off";
          notifyUnsay(hint);
        } else if (s === "denied") {
          btn.textContent = "Browser notifications blocked";
          btn.disabled = true;
          notifySay(
            hint,
            "Notifications for this site are blocked. Go to your browser settings and reset permissions for this website.",
            true,
          );
        } else {
          btn.textContent = "Notify me with this browser";
          btn.disabled = false;
          notifyUnsay(hint);
        }
      }

      function initNotify() {
        const navEl = document.getElementById("notify-nav");
        const nav = navEl instanceof HTMLButtonElement ? navEl : null;
        if (nav !== null && nav.dataset.wired !== "1") {
          nav.dataset.wired = "1";
          nav.addEventListener("click", () => {
            openNotify();
          });
        }
        const heroEl = document.getElementById("notify-hero");
        const hero = heroEl instanceof HTMLButtonElement ? heroEl : null;
        if (hero !== null && hero.dataset.wired !== "1") {
          hero.dataset.wired = "1";
          hero.addEventListener("click", () => {
            openNotify();
          });
        }
        const dlgEl = document.getElementById("notify-dialog");
        const dlg = dlgEl instanceof HTMLDialogElement ? dlgEl : null;
        if (dlg !== null && dlg.dataset.wired !== "1") {
          dlg.dataset.wired = "1";
          // Tapping the backdrop dismisses, like the × button.
          dlg.addEventListener("click", (e) => {
            if (e.target === dlg) dlg.close();
          });
          const btnEl = document.getElementById("notify-btn");
          const btn = btnEl instanceof HTMLButtonElement ? btnEl : null;
          if (btn !== null) {
            btn.addEventListener("click", () => {
              const hint = document.getElementById("notify-status");
              void notifyPush().then((api) =>
                api.pushState().then((state) => {
                  if (state === "subscribed") {
                    void api.unsubscribePush().then(() => void paintNotify());
                  } else {
                    if (hint !== null)
                      notifySay(hint, "Waiting for your browser…");
                    // Repaint first, then report: painting clears the
                    // "Waiting…" line, and the verdict below survives
                    // because nothing runs after it.
                    void api.subscribePush().then(async (result) => {
                      await paintNotify();
                      if (hint === null) return;
                      if (result === "subscribed") {
                        notifySay(
                          hint,
                          "You're on the list — this browser will alert you.",
                        );
                      } else if (result === "cancelled") {
                        notifySay(hint, "Request cancelled.");
                      } else if (result === "blocked") {
                        // paintNotify already said it, in plain words.
                      } else {
                        notifySay(
                          hint,
                          "That didn't work — push alerts aren't set up on the server yet.",
                        );
                      }
                    });
                  }
                }),
              );
            });
          }
        }
        if (dlg !== null) void paintNotify();
      }

      initNotify();
      if (window.__notifyWired !== true) {
        window.__notifyWired = true;
        document.addEventListener("astro:page-load", initNotify);
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --paper: #faf7f1;
    --ink: #23201b;
    --muted: #756a5c;
    --line: #e5dccb;
    --accent: #a44a24;
    --accent-ink: #ffffff;
    /* Delete hover only: a soft clay red, clearly not the brand
       orange and nowhere near alarm red. */
    --danger: #b35545;
    --card: #fffdf8;
    --wash: radial-gradient(120% 60% at 50% -10%, #f1e7d4 0%, transparent 60%);
    --shadow: 0 24px 60px -30px rgb(60 42 20 / 0.35);
    --radius: 0.6rem;
  }
  html {
    scroll-behavior: smooth;
  }
  /* Reserve the scrollbar gutter on every page: the gallery scrolls (gutter
     present) while a short painting page may not (gutter absent), and that
     appear/disappear is what nudges the centered header + footer sideways. */
  html {
    scrollbar-gutter: stable;
  }
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
  body {
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
    background: var(--paper);
    background-image: var(--wash);
    background-attachment: fixed;
    color: var(--ink);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  h1,
  h2,
  .serif {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  ::selection {
    background: color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 50;
    background: var(--ink);
    color: var(--paper);
    padding: 0.6rem 1.2rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: top 0.2s ease;
  }
  .skip:focus-visible {
    top: 0.75rem;
  }

  /* Sticky gallery-style header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .site-nav {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0.8rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  /* Optical left-align: the script's hairline lead-in sits ~5px inboard of
     the SVG edge at rendered size, so the heavy stroke starts right of the
     content edge. This pulls the visual weight back onto it. */
  #signature {
    display: inline-flex;
    color: var(--ink);
    margin-left: -0.25rem;
  }
  /* Logo sizing lives in Signature.astro (scoped CSS here can't reach it). */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.92rem;
  }
  .nav-links a {
    color: var(--ink);
    white-space: nowrap;
    opacity: 0.78;
    text-decoration: underline transparent;
    text-underline-offset: 4px;
    transition:
      opacity 0.2s ease,
      background-color 0.25s ease,
      color 0.25s ease,
      text-decoration-color 0.12s ease,
      border-color 0.25s ease,
      transform 0.2s ease;
  }
  .nav-links a:not(.nav-cta):hover {
    opacity: 1;
    text-decoration-color: currentColor;
  }
  .nav-links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 0.35rem;
  }
  .nav-links .nav-cta {
    opacity: 1;
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    font-weight: 600;
  }
  .nav-links .nav-cta:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
    text-decoration-color: transparent;
    opacity: 1;
  }
  @media (hover: hover) {
    .nav-links .nav-cta:hover {
      transform: translateY(-1px);
    }
  }
  .nav-links .nav-cta:active {
    transform: none;
  }
  .nav-links .nav-cta {
    white-space: nowrap;
    flex-shrink: 0;
  }
  /* The studio "Notify me" is a button wearing the link style — it
     opens the signup modal instead of scrolling anywhere. Same
     transitions as the links, or its hover snaps instead of fading. */
  .nav-links button.nav-cta {
    font: inherit;
    background: transparent;
    cursor: pointer;
    color: var(--ink);
    transition:
      opacity 0.2s ease,
      background-color 0.25s ease,
      color 0.25s ease,
      text-decoration-color 0.12s ease,
      border-color 0.25s ease,
      transform 0.2s ease;
  }
  .nav-links button.nav-cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 0.35rem;
  }
  /* The open studio section reads current: full strength with its
     underline on, no pill, no color flash. */
  .nav-links a[aria-current="page"] {
    opacity: 1;
    text-decoration-color: currentColor;
  }
  /* Way home shrinks to its arrow on phones; the word returns on
     wider screens. */
  #leave-admin .leave-short {
    display: none;
  }
  /* Studio toast, fixed under the sticky header: news finds her
     wherever she is scrolled. Empty (no message) means gone entirely. */
  #admin-status {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    top: max(5rem, env(safe-area-inset-top, 1rem));
    width: min(36rem, calc(100% - 2rem));
    z-index: 40;
    margin: 0;
    padding: 0.8rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    /* Inverted and fully solid: it floats over busy page content, so a
       card-colored pill lets the page bleed through behind the words. */
    background: var(--ink);
    color: var(--paper);
    font-size: 0.95rem;
    box-shadow: var(--shadow);
  }
  /* Opacity-only, both directions: a fade-in on every new message
     (re-triggered from the panel) and a fade-out on its way away.
