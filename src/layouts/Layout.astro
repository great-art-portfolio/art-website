---
import ClientRouter from "astro/components/ClientRouter.astro";
import Analytics from "../components/Analytics.astro";
import Signature from "../components/Signature.astro";
import background from "../assets/background.svg";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Calgary & Abstract Original Paintings",
  description = "Original Calgary and abstract paintings, direct from the artist's studio.",
  image = "/icon.svg",
} = Astro.props;

const canonical = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141210" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🖼️</text></svg>"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Art Gallery</title>
    <ClientRouter />
    <Analytics />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" id="signature" aria-label="Home"><Signature /></a>
      </nav>
    </header>

    <img id="background" src={background.src} alt="" fetchpriority="high" />
    <slot />

    <footer>
      <p>Original paintings from Calgary, Alberta · Secure inquiry checkout · Ships across Canada &amp; the US</p>
      <p><a href="/privacy">Privacy</a> — no cookies, no trackers</p>
    </footer>

    <script>
      // Offline support: cached gallery shell + artwork, queued posts.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            // Offline mode unavailable — the site still works online.
          });
        });
      }
    </script>
  </body>
</html>

<style>
  :root { color-scheme: light dark; }
  html, body { margin: 0; width: 100%; min-height: 100%; }
  body {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    background: #faf7f1;
    color: #1c1a17;
    line-height: 1.5;
  }
  nav { padding: 1.25rem 1.5rem 0.5rem; }
  #signature svg { max-width: min(78vw, 20rem); height: auto; }
  #background { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; object-fit: cover; }
  footer { text-align: center; padding: 2.5rem 1.5rem; font-size: 0.9rem; opacity: 0.75; }
  @media (prefers-color-scheme: dark) {
    body { background: #141210; color: #f2ede4; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
