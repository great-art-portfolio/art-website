---
import Layout from "../layouts/Layout.astro";
---

<Layout title="You're offline">
  <main class="offline">
    <h1>No connection</h1>
    <p>
      The gallery needs internet for new paintings, but anything you've already
      viewed is cached on your device.
    </p>
    <p><a href="/">Try the gallery again</a></p>
  </main>
</Layout>

<style>
  .offline {
    max-width: 36rem;
    margin: 0 auto;
    padding: 3rem 1.25rem;
    text-align: center;
  }
</style>
