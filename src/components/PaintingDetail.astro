---
/**
 * One painting, three rooms. The buyer page, the studio edit page, and the
 * new-painting draft page share this exact layout, so what mom sees while
 * editing is what buyers see — minus the inquiry form, which is disabled
 * with its reason stated wherever she works.
 *
 * Data arrives as plain values (never a content entry), so static buyer
 * pages and dynamic studio routes render the same markup. Buyer behavior
 * (AR, inquiry, lightbox, in-context admin) rides along in the inline
 * script below, which no-ops cleanly wherever its elements are absent.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { PHOTO_WIDTHS, photoSizes } from "../lib/responsive-images";
import { SHOW_PRICES } from "../lib/site";

export interface PaintingDetailData {
  title: string;
  price: number;
  sold: boolean;
  medium: string;
  /** Precomputed "Oil · 24 × 36 in" line (empty when unmeasured). */
  meta: string;
  alt: string;
  description: string;
  /** Tape numbers as display strings ("" when unmeasured). */
  widthIn: string;
  heightIn: string;
  depthIn: string;
  /** Absent in draft mode — the upload tile takes the photo's place. */
  image?: ImageMetadata;
  modelGlb: string;
  modelUsdz: string;
  mdPath: string;
  slug: string;
  draft: boolean;
}

interface Props {
  mode: "buy" | "edit" | "draft";
  data: PaintingDetailData;
  backHref: string;
  backLabel: string;
  /** Buyer pages only: door to this painting's studio room. */
  editHref?: string;
}

const { mode, data, backHref, backLabel, editHref = "" } = Astro.props;
const studio = mode !== "buy";
const priceLabel = `$${data.price.toFixed(2)} CAD`;
const eyebrow = data.draft
  ? "Draft · only you can see this"
  : "Original painting · one of a kind";
---

<main
  class="detail"
  id="main"
  data-mode={mode}
  data-title={data.title}
  data-price-cents={Math.round(data.price * 100)}
  data-glb={data.modelGlb}
  data-usdz={data.modelUsdz}
  data-alt={data.alt}
  data-md-path={data.mdPath}
  data-slug={data.slug}
  data-draft={data.draft ? "1" : ""}
  data-image={data.image?.src ?? ""}
>
  <p class="crumbs"><a href={backHref}>{backLabel}</a></p>
  {
    mode === "buy" && (
      <div id="admin-bar" hidden>
        <span>Admin mode</span>
        <a href={editHref}>Edit in the studio</a>
        <a href="/admin#sec-collection">Studio</a>
      </div>
    )
  }
  <div class="detail-grid">
    <div class="media-col">
      {
        studio && mode === "draft" ? (
          <div>
            <div class="upload-tile">
              <input
                id="de-photo"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/heic"
                capture="environment"
                aria-label="Upload photo"
              />
              <span id="de-photo-empty" aria-hidden="true">
                Upload photo
              </span>
              <img id="de-photo-preview" alt="Photo preview" hidden />
            </div>
            <div class="tile-row" id="de-photo-tools" hidden>
              <button type="button" id="de-rotate-90">
                Rotate ↻
              </button>
              <button type="button" id="de-rotate-270">
                Rotate ↺
              </button>
            </div>
            <p class="hint" id="de-photo-meta" />
          </div>
        ) : (
          <div>
            <div class="frame" id="photo-wrap" title="Tap to view fullscreen">
              {data.image !== undefined && (
                <Image
                  src={data.image}
                  alt={data.alt}
                  width={1200}
                  widths={PHOTO_WIDTHS}
                  sizes={photoSizes()}
                  format="webp"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              )}
              {data.sold && <span class="badge sold">Sold</span>}
            </div>
            {studio && (
              <div class="tile-row">
                <button type="button" id="de-replace">
                  Replace photo
                </button>
                <input
                  id="de-replace-file"
                  type="file"
                  accept="image/jpeg,image/png,image/webp,image/heic"
                  capture="environment"
                  aria-label="Replace photo"
                  hidden
                />
              </div>
            )}
          </div>
        )
      }
      {
        studio && !data.sold && (
          <div id="ar-mount">
            <h2>3D Model Preview</h2>
            {data.modelGlb !== "" ? (
              <>
                <p class="hint">
                  True size — on your phone, point it at the wall where it would
                  hang.
                </p>
                <div id="ar-stage">
                  <div class="ar-skeleton" aria-hidden="true" />
                </div>
              </>
            ) : (
              <>
                <div class="ar-waiting" id="de-ar-waiting">
                  <p>
                    Waiting for a photo — once one arrives, the 3D takes about 5
                    seconds to build. You'll see it here, and on a phone you can
                    also view it in AR.
                  </p>
                </div>
                <div id="ar-stage" hidden />
              </>
            )}
          </div>
        )
      }
    </div>
    <div
      id="lightbox"
      hidden
      role="dialog"
      aria-modal="true"
      aria-label="Painting fullscreen view"
    >
      <img id="lightbox-img" alt="" />
    </div>
    <div class="info">
      <p class="eyebrow">{eyebrow}</p>
      {
        studio ? (
          <>
            <h1 id="pv-title">{data.title === "" ? "Untitled" : data.title}</h1>
            <p class="price" id="pv-price">
              {data.price > 0 ? priceLabel : "Price?"}
            </p>
            <p class="art-meta" id="pv-meta">
              {data.meta}
            </p>
            <div class="desc" id="pv-desc" />
            <div class="studio-fields">
              <h2>Painting details</h2>
              <label>
                Title
                <input
                  id="de-title"
                  type="text"
                  maxlength="120"
                  autocomplete="off"
                  value={data.title}
                />
              </label>
              <label>
                Price (CAD)
                <input
                  id="de-price"
                  type="number"
                  min="1"
                  step="0.01"
                  inputmode="decimal"
                  value={data.price > 0 ? String(data.price) : ""}
                />
              </label>
              <div class="de-row">
                <label>
                  Width (in)
                  <input
                    id="de-w"
                    type="number"
                    min="1"
                    step="0.5"
                    inputmode="decimal"
                    value={data.widthIn}
                  />
                </label>
                <label>
                  Height (in)
                  <input
                    id="de-h"
                    type="number"
                    min="1"
                    step="0.5"
                    inputmode="decimal"
                    value={data.heightIn}
                  />
                </label>
                <label>
                  Depth (in)
                  <input
                    id="de-d"
                    type="number"
                    min="0.5"
                    step="0.5"
                    inputmode="decimal"
                    value={data.depthIn}
                  />
                </label>
              </div>
              <p class="hint">
                Measure with a tape — buyers ask, shippers need it, and the wall
                preview needs it for true size.
              </p>
              <label>
                Medium (optional, e.g. Oil on canvas)
                <input
                  id="de-medium"
                  type="text"
                  maxlength="120"
                  autocomplete="off"
                  value={data.medium}
                />
              </label>
              <label>
                Alt text (describe the art)
                <input
                  id="de-alt"
                  type="text"
                  maxlength="200"
                  autocomplete="off"
                  value={data.alt}
                  aria-describedby="de-alt-hint"
                />
              </label>
              <p class="hint" id="de-alt-hint">
                This box describes the photo for people who can't see it — write
                what the painting looks like and screen readers read it aloud.
                It never shows on the page.
              </p>
              <label class="de-desc-label">
                Description
                <textarea id="de-desc" rows="4" maxlength="2000">
                  {data.description}
                </textarea>
              </label>
            </div>
            <div class="studio-toolbar">
              {mode === "draft" ? (
                <>
                  <button type="button" id="de-save-draft" class="btn-primary">
                    Save draft
                  </button>
                  <button type="button" id="de-publish">
                    Publish painting
                  </button>
                </>
              ) : (
                <>
                  <button type="button" id="de-save" class="btn-primary">
                    Save changes
                  </button>
                  <button type="button" id="de-visibility">
                    {data.draft ? "Publish" : "Unpublish"}
                  </button>
                  <button type="button" id="de-del">
                    Delete
                  </button>
                </>
              )}
              <label class="de-check">
                <input id="de-sold" type="checkbox" checked={data.sold} /> Sold
              </label>
              <span id="de-status" role="status" />
            </div>
          </>
        ) : (
          <>
            <h1>{data.title}</h1>
            {data.sold ? (
              <p class="sold-note">This piece has found a home.</p>
            ) : SHOW_PRICES ? (
              <p class="price">{priceLabel}</p>
            ) : (
              <p class="price-note">
                Price on request — send a note below and the artist will reply.
              </p>
            )}
            {data.meta !== "" && <p class="art-meta">{data.meta}</p>}
            <div class="desc">
              <slot />
            </div>
          </>
        )
      }
      {
        !data.sold && !studio && (
          <>
            <button
              type="button"
              id="inquiry-reveal"
              class="btn-primary"
              hidden
            >
              Interested?
            </button>
            <form id="inquiry-form">
              <h2>Ask about this painting</h2>
              <p class="ship-note">
                Shipping arranged with the artist after purchase.
              </p>
              <label>
                Name{" "}
                <input name="name" type="text" required autocomplete="name" />
              </label>
              <label>
                Email{" "}
                <input
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                />
              </label>
              <label>
                Message{" "}
                <textarea
                  name="message"
                  rows="3"
                  placeholder="Hi, I love this piece…"
                />
              </label>
              <input
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
                class="hp"
                aria-hidden="true"
              />
              <div id="turnstile-mount" />
              <button type="submit" class="btn-primary">
                Send inquiry
              </button>
              <p id="inquiry-status" role="status" />
            </form>
          </>
        )
      }
      {
        studio && mode !== "draft" && !data.sold && (
          <div class="inquiry-off">
            <button type="button" class="btn-primary" disabled>
              Interested?
            </button>
            <p class="hint">
              Off while you edit — buyers see this button on the live page.
            </p>
          </div>
        )
      }
      {
        !studio && !data.sold && data.modelGlb !== "" && (
          <div id="ar-mount">
            <h2>Try it on your wall</h2>
            <p class="hint">
              True size — on your phone, point it at the wall where it would
              hang.
            </p>
            <div id="ar-stage">
              <div class="ar-skeleton" aria-hidden="true" />
            </div>
          </div>
        )
      }
    </div>
  </div>
</main>

<script>
  // NOTE: no define:vars on this block — with it, Astro emits the script
  // raw (dynamic imports stay relative URLs and 404). Page data comes
  // from #main data-* attributes instead, and Vite bundles this properly.
  // View Transitions keep this module alive across gallery → painting
  // navigations (it runs once per document, not once per page), so page
  // data must be read live from #main on every use — eval-time consts go
  // stale and the next painting inherits the previous one's 3D model,
  // inquiry title, and edit path.
  function readPageData() {
    const pageData = document.getElementById("main")?.dataset;
    return {
      title: pageData?.title ?? "",
      priceCents: Number(pageData?.priceCents ?? "0"),
      glb: pageData?.glb ?? "",
      usdz: pageData?.usdz ?? "",
      alt: pageData?.alt ?? "",
      mdPath: pageData?.mdPath ?? "",
    };
  }
  let turnstileToken = "";

  /** Invisible-ish spam check, loaded only if the site key is configured. */
  function loadTurnstile() {
    if (document.getElementById("turnstile-script") !== null) return;
    fetch("/api/status")
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        const raw =
          data !== null &&
          typeof data === "object" &&
          "turnstileSiteKey" in data
            ? data.turnstileSiteKey
            : undefined;
        const key = typeof raw === "string" ? raw : "";
        if (key === "") return;
        if (document.getElementById("turnstile-script") !== null) return;
        const script = document.createElement("script");
        script.id = "turnstile-script";
        script.src =
          "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        script.async = true;
        script.defer = true;
        script.onload = () => {
          const tApi = window.turnstile;
          if (tApi === undefined) return;
          tApi.render("#turnstile-mount", {
            sitekey: key,
            callback: (t) => {
              turnstileToken = t;
            },
          });
        };
        document.head.appendChild(script);
      })
      .catch(() => {
        // Spam check unavailable — the honeypot still guards the form.
      });
  }

  /** "View on your wall" AR viewer (only rendered when models exist). */
  function initAr() {
    const mount = document.getElementById("ar-mount");
    if (mount === null) return;
    const { glb, usdz, alt, title } = readPageData();
    if (glb === "" || mount.dataset.wiredSrc === glb) return;
    mount.dataset.wiredSrc = glb;
    const stage = document.getElementById("ar-stage");
    if (stage === null) return;
    // Instant static preview from the photo already on screen — zero extra
    // bytes. The viewer library (~1.5MB with its decoders) and the model
    // only download once this section scrolls into view.
    const photo = document.querySelector("#photo-wrap img");
    const poster =
      photo instanceof HTMLImageElement
        ? photo.currentSrc === ""
          ? photo.src
          : photo.currentSrc
        : "";
    if (poster !== "") {
      const img = document.createElement("img");
      img.src = poster;
      img.alt = "";
      img.loading = "lazy";
      img.decoding = "async";
      img.style.width = "100%";
      img.style.height = "20rem";
      img.style.objectFit = "contain";
      img.style.borderRadius = "1rem";
      stage.replaceChildren(img);
    }
    const build = () => {
      // Script tag, not import(): Vite dev won't serve /public files as
      // modules. See src/lib/vendor-loader.ts.
      void import("../lib/vendor-loader")
        .then(({ loadModelViewer }) => loadModelViewer())
        .then(() => {
          if (!document.contains(mount)) return;
          const liveStage = document.getElementById("ar-stage");
          if (liveStage === null) return;
          const el = document.createElement("model-viewer");
          el.setAttribute("src", glb);
          if (usdz !== "") el.setAttribute("ios-src", usdz);
          if (poster !== "") el.setAttribute("poster", poster);
          el.setAttribute("loading", "lazy");
          el.setAttribute("ar", "");
          el.setAttribute("ar-modes", "webxr scene-viewer quick-look");
          el.setAttribute("ar-scale", "fixed");
          el.setAttribute("ar-placement", "wall");
          el.setAttribute("camera-controls", "");
          el.setAttribute("alt", alt === "" ? title : alt);
          el.style.width = "100%";
          el.style.height = "20rem";
          el.style.borderRadius = "1rem";
          liveStage.replaceChildren(el);
        })
        .catch(() => {
          mount.hidden = true;
        });
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries, obs) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          obs.disconnect();
          build();
        }
      });
      io.observe(mount);
    } else {
      build();
    }
  }

  // Page scripts only run on full loads — but this layout uses View Transitions,
  // so gallery → painting navigations never re-run them. Everything is wired in
  // initDetail(), called immediately AND on astro:page-load. Guards keep a
  // double-fire on the same DOM from wiring anything twice.
  /** Admin mode: token set in /admin Settings reveals the studio door —
      editing itself happens in the painting's studio room. */
  function initAdmin() {
    const bar = document.getElementById("admin-bar");
    if (bar === null || bar.dataset.wired === "1") return;
    let token;
    try {
      // Remembered per browser (local storage) with a session fallback —
      // mirrors getApiToken() in src/lib/api.ts.
      token =
        localStorage.getItem("ADMIN_API_TOKEN") ??
        sessionStorage.getItem("ADMIN_API_TOKEN") ??
        "";
    } catch {
      return;
    }
    if (token === "") return;
    bar.dataset.wired = "1";
    bar.hidden = false;
  }

  function initDetail() {
    initAr();
    initAdmin();
    // Browsers without Background Sync (iPhones) never replay the outbox
    // on their own — flush on reconnect and page load instead.
    void import("../lib/queue").then(({ armOutboxFlush }) => armOutboxFlush());
    // Inquiries go straight to the artist's email — nothing is stored.
    // Spam: honeypot first, Cloudflare Turnstile when configured.
    const formEl = document.getElementById("inquiry-form");
    const form = formEl instanceof HTMLFormElement ? formEl : null;
    if (form !== null && form.dataset.wired !== "1") {
      form.dataset.wired = "1";
      loadTurnstile();
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        if ((data.get("website") ?? "") !== "") return; // honeypot
        const status = document.getElementById("inquiry-status");
        if (status === null) return;
        status.textContent = "Sending…";
        const live = readPageData();
        void import("../lib/queue").then(({ queuePost }) =>
          queuePost("/api/inquiries", {
            paintingTitle: live.title,
            priceCents: live.priceCents,
            name: String(data.get("name") ?? ""),
            email: String(data.get("email") ?? ""),
            message: String(data.get("message") ?? ""),
            website: "",
            turnstileToken,
          }).then((result) => {
            status.textContent =
              result === "sent"
                ? "Thanks! The artist will reply by email."
                : result === "queued"
                  ? "Saved — it will send automatically when you're back online."
                  : "That didn't go through — check your email address and try again.";
            if (result === "sent") form.reset();
          }),
        );
      });
    }

    // "Interested?" reveals the form (shown openly without JS).
    const reveal = document.getElementById("inquiry-reveal");
    if (reveal !== null && form !== null && reveal.dataset.wired !== "1") {
      reveal.dataset.wired = "1";
      form.hidden = true;
      reveal.hidden = false;
      reveal.addEventListener("click", () => {
        form.hidden = false;
        form.classList.add("revealed");
        reveal.hidden = true;
        const name = form.querySelector('input[name="name"]');
        if (name instanceof HTMLInputElement) name.focus();
      });
    }

    // Tap photo → fullscreen overlay. Document-level listeners are registered
    // once per browser session — the elements they act on are re-queried live.
    if (window.__detailDocWired !== true) {
      window.__detailDocWired = true;
      const close = () => {
        if (document.fullscreenElement !== null) {
          document.exitFullscreen().catch(() => undefined);
        }
        const box = document.getElementById("lightbox");
        if (box !== null) box.hidden = true;
      };
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const box = document.getElementById("lightbox");
          if (box !== null && !box.hidden) close();
        }
      });
      document.addEventListener("fullscreenchange", () => {
        if (document.fullscreenElement === null) {
          const box = document.getElementById("lightbox");
          if (box !== null) box.hidden = true;
        }
      });
    }

    const wrapEl = document.getElementById("photo-wrap");
    const wrap = wrapEl instanceof HTMLElement ? wrapEl : null;
    const box = document.getElementById("lightbox");
    const fullEl = document.getElementById("lightbox-img");
    const full = fullEl instanceof HTMLImageElement ? fullEl : null;
    const photo = wrap !== null ? wrap.querySelector("img") : null;
    if (
      wrap !== null &&
      box !== null &&
      full !== null &&
      photo != null &&
      wrap.dataset.wired !== "1"
    ) {
      wrap.dataset.wired = "1";
      wrap.addEventListener("click", () => {
        full.src = photo.currentSrc === "" ? photo.src : photo.currentSrc;
        full.alt = photo.alt;
        box.hidden = false;
        if (
          typeof box.requestFullscreen === "function" &&
          document.fullscreenEnabled
        ) {
          box.requestFullscreen().catch(() => undefined);
        }
      });
      box.addEventListener("click", () => {
        if (document.fullscreenElement !== null) {
          document.exitFullscreen().catch(() => undefined);
        }
        box.hidden = true;
      });
    }
  }

  initDetail();
  document.addEventListener("astro:page-load", initDetail);
</script>

<style>
  .detail {
    max-width: 76rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .crumbs {
    margin: 0 0 1.5rem;
    font-size: 0.92rem;
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: underline transparent;
    text-underline-offset: 4px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.12s ease;
  }
  .crumbs a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .crumbs a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  /* Admin-mode toolbar: quiet bar, same link treatment as the header. */
  #admin-bar {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    margin: 0 0 1.5rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--card);
    font-size: 0.88rem;
  }
  #admin-bar[hidden] {
    display: none;
  }
  #admin-bar span {
    font-weight: 600;
  }
  #admin-bar a {
    color: var(--muted);
  }
  .detail-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  /* Photo column stacks its pieces (tile, wall preview) with room to
     breathe, so the left side holds content while she scrolls the form. */
  .media-col {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    min-width: 0;
  }
  .media-col > div {
    min-width: 0;
  }
  @media (min-width: 48rem) {
    .detail-grid {
      grid-template-columns: 1.15fr 1fr;
    }
    .info {
      position: sticky;
      top: 5.5rem;
    }
  }
  .frame {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(0.7rem, 2vw, 1.1rem);
    box-shadow: var(--shadow);
    cursor: zoom-in;
  }
  .frame img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.25rem;
  }
  .badge {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: rgb(20 18 15 / 0.82);
    color: #fff;
  }
  .badge.sold {
    background: rgb(140 29 24 / 0.9);
  }
  #lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.94);
    display: grid;
    place-items: center;
    z-index: 50;
    cursor: zoom-out;
    animation: lb-in 0.25s ease;
  }
  #lightbox[hidden] {
    display: none;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
