---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import { formatDimensions } from "../lib/dims";
import { galleryTiles } from "../lib/gallery-layout";
import { formatPriceShort } from "../lib/money";
import {
  GALLERY_WIDTHS,
  SOLD_WIDTHS,
  gallerySizes,
  soldSizes,
} from "../lib/responsive-images";
import {
  SHOW_PRICES,
  compareGalleryOrder,
  isPublished,
  slugifyTitle,
  workCount,
} from "../lib/site";

type Painting = CollectionEntry<"paintings">;
// Captions show the face only. Depth is on the painting page.
const dimsOf = (p: Painting): string =>
  formatDimensions(p.data.widthIn ?? null, p.data.heightIn ?? null, null);

const paintings = (await getCollection("paintings")).filter((p) =>
  isPublished(p.data),
);
// Sorted by the /admin drag order (`order:`), then alphabetically.
const available = paintings
  .filter((p) => !p.data.sold)
  .sort((a, b) =>
    compareGalleryOrder(
      { order: a.data.order ?? null, title: a.data.title },
      { order: b.data.order ?? null, title: b.data.title },
    ),
  );
// Same ordering as Available.
const sold = paintings
  .filter((p) => p.data.sold)
  .sort((a, b) =>
    compareGalleryOrder(
      { order: a.data.order ?? null, title: a.data.title },
      { order: b.data.order ?? null, title: b.data.title },
    ),
  );

// Wide and much larger paintings get bigger tiles (see gallery-layout).
const tiles = galleryTiles(
  available.map((p) => ({
    aspect: p.data.image.width / p.data.image.height,
    widthIn: p.data.widthIn ?? null,
    heightIn: p.data.heightIn ?? null,
  })),
);

const NEW_MS = 7 * 24 * 60 * 60 * 1000;
const isNewStatic = (d: Date): boolean => Date.now() - d.getTime() < NEW_MS;
---

<section class="collection" id="collection" aria-label="Available paintings">
  <div class="gallery" id="gallery-static">
    {available.map((painting, i) => (
      <a
        class:list={["card", tiles[i] !== "normal" && `tile-${tiles[i]}`]}
        href={`/paintings/${slugifyTitle(painting.data.title)}`}
        data-astro-prefetch="hover"
      >
        <span
          class="mat"
          style={`--ar: ${painting.data.image.width / painting.data.image.height}`}
        >
          <Image
            src={painting.data.image}
            alt={painting.data.alt}
            width={1000}
            widths={GALLERY_WIDTHS}
            sizes={gallerySizes(tiles[i])}
            format="webp"
            decoding="async"
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : undefined}
          />
          {isNewStatic(painting.data.dateAdded) && (
            <span class="badge new">New</span>
          )}
        </span>
        <span class="caption">
          <span class="caption-title">{painting.data.title}</span>
          <span class="caption-sub">
            {SHOW_PRICES ? (
              <span class="price">{formatPriceShort(painting.data.price)}</span>
            ) : (
              <span class="ask">Ask about this piece</span>
            )}
            {dimsOf(painting) !== "" && (
              <span class="dims">{dimsOf(painting)}</span>
            )}
          </span>
        </span>
      </a>
    ))}
  </div>
</section>

{sold.length > 0 && (
  <section class="collection collected" id="sold" aria-label="Sold paintings">
    <div class="section-head">
      <h2>Found their homes</h2>
      <p class="count">{workCount(sold.length)} sold</p>
    </div>
    <div class="gallery sold-grid">
      {sold.map((painting) => (
        <a
          class="card"
          href={`/paintings/${slugifyTitle(painting.data.title)}`}
          data-astro-prefetch="hover"
        >
          <span
            class="mat"
            style={`--ar: ${painting.data.image.width / painting.data.image.height}`}
          >
            <Image
              src={painting.data.image}
              alt={painting.data.alt}
              width={700}
              widths={SOLD_WIDTHS}
              loading="lazy"
              sizes={soldSizes()}
              format="webp"
              decoding="async"
            />
            <span class="badge sold">Sold</span>
          </span>
          <span class="caption">
            <span class="caption-title">{painting.data.title}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .collection {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem) 2rem;
    scroll-margin-top: 5rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    margin: 0 0 2rem;
  }
  .section-head h2 {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 400;
    text-wrap: balance;
  }
  .count {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* Two columns on phones, three from 60rem. Each painting keeps its
     shape and captions line up along the bottom of the row. Dense flow
     lets small tiles fill the gaps beside a big one. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1rem;
    align-items: end;
  }
  #gallery-static {
    grid-auto-flow: dense;
  }
  @media (min-width: 40rem) {
    .gallery {
      gap: 3rem 2rem;
    }
  }
  @media (min-width: 60rem) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3.5rem 2.5rem;
    }
  }
  .tile-wide {
    grid-column: span 2;
  }
  .tile-big {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile-big-wide {
    grid-column: 1 / -1;
  }

  .card {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    border-radius: 2px;
    animation: rise 0.5s ease both;
  }
  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .card:nth-child(2) {
    animation-delay: 0.06s;
  }
  .card:nth-child(3) {
    animation-delay: 0.12s;
  }
  .card:nth-child(n + 4) {
    animation-delay: 0.18s;
  }
  .mat {
    position: relative;
    display: block;
    transition: transform 0.35s ease;
  }
  @media (hover: hover) {
    .card:hover .mat {
      transform: translateY(-3px);
    }
  }
  .mat img {
    /* Each photo fits a square as wide as its tile, so a tall painting's
       long side matches a square's and never outgrows a bigger canvas.
       Short screens cap the height at 80vh. Both caps work through the
       width (--ar is the photo's width / height), so the box keeps the
       photo's shape and never letterboxes. A narrower photo sits on the
       left edge, in line with its caption. */
    display: block;
    width: min(100%, calc(100% * var(--ar, 1)));
    max-width: calc(80vh * var(--ar, 1));
    height: auto;
    margin: 0;
    border-radius: 2px;
    background: transparent;
    object-fit: contain;
    box-shadow: var(--shadow);
  }
  .caption {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-top: 0.7rem;
  }
  .caption-title {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    font-size: 1.05rem;
    line-height: 1.3;
    text-decoration: underline transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.12s ease;
  }
  @media (min-width: 40rem) {
    .caption-title {
      font-size: 1.15rem;
    }
  }
  .card:hover .caption-title {
    text-decoration-color: currentColor;
  }
  .caption-sub {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    font-size: 0.9rem;
  }
  .dims {
    color: var(--muted);
  }
  .price + .dims::before,
  .ask + .dims::before {
    content: "\00a0·\00a0";
  }
  /* Reduced motion removes the hover lift. The entrance and caption
     fades still run. This comes after the hover rules so it wins. */
  @media (prefers-reduced-motion: reduce) {
    .card:hover .mat {
      transform: none;
    }
  }
  .badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgb(20 18 15 / 0.82);
    color: #fff;
  }
  .badge.sold {
    background: rgb(140 29 24 / 0.9);
  }
  .badge.new {
    background: rgb(46 110 94 / 0.9);
  }

  /* Sold archive: the same grid, quieter photos. */
  .collected {
    margin-top: 2.5rem;
  }
  .sold-grid img {
    box-shadow: none;
    filter: saturate(0.88);
  }
  .sold-grid .caption-title {
    font-size: 1rem;
  }

  @keyframes rise {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
