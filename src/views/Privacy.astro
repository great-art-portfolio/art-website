---
import Layout from "../layouts/Layout.astro";
import { t } from "../i18n";
import type { Locale } from "../i18n/locales";

interface Props {
  locale?: Locale | undefined;
}
const { locale = "en" } = Astro.props;
const s = t(locale).privacy;
---

<Layout
  title={s.title}
  description={s.description}
  locale={locale}
  alternates="/privacy"
>
  <main class="privacy" id="main">
    <h1>{s.title}</h1>
    <p>{s.intro}</p>
    <h2>{s.collectedTitle}</h2>
    <ul>
      {s.collected.map(([term, detail]) => (
        <li>
          <strong>{term}</strong> {detail}
        </li>
      ))}
    </ul>
    <h2>{s.notTitle}</h2>
    <p>{s.not}</p>
    <h2>{s.choicesTitle}</h2>
    <p>{s.choices}</p>
  </main>
</Layout>

<style>
  .privacy {
    max-width: 44rem;
    margin: 0 auto;
    padding: 1rem 1.25rem 4rem;
  }
</style>
