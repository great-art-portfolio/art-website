---
import Layout from "../../../layouts/Layout.astro";
import PaintingDetail, {
  type PaintingDetailData,
} from "../../../components/PaintingDetail.astro";

const data: PaintingDetailData = {
  title: "",
  price: 0,
  sold: false,
  publishOn: "",
  medium: "",
  meta: "",
  alt: "",
  description: "",
  widthIn: "",
  heightIn: "",
  depthIn: "",
  modelGlb: "",
  modelUsdz: "",
  mdPath: "",
  slug: "",
  draft: true,
};
---

<Layout
  title="Admin - New painting"
  wordmark="admin"
  description="Add a painting to the collection."
>
  <PaintingDetail
    mode="draft"
    data={data}
    backHref="/admin"
    backLabel="← Back to the studio"
  />
</Layout>

<script src="../../../components/StudioPainting.ts"></script>
