---
import { getCollection } from "astro:content";
import PaintingPage from "../../../views/PaintingPage.astro";
import { ENABLED } from "../../../i18n";
import { isPublished, slugifyTitle } from "../../../lib/site";

// Every published painting in every language she has switched on, plus
// one page per old slug after a rename, as in English (they point their
// canonical at the current slug).
export async function getStaticPaths() {
  const paintings = (await getCollection("paintings")).filter((p) =>
    isPublished(p.data),
  );
  const claimed = new Set(paintings.map((p) => slugifyTitle(p.data.title)));
  const slugs: Array<{ id: string; painting: (typeof paintings)[number] }> =
    paintings.map((painting) => ({
      id: slugifyTitle(painting.data.title),
      painting,
    }));
  for (const painting of paintings) {
    for (const alias of (painting.data.slugHistory ?? "")
      .split(",")
      .map((s) => s.trim().toLowerCase())
      .filter((s) => /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(s))) {
      if (claimed.has(alias)) continue;
      claimed.add(alias);
      slugs.push({ id: alias, painting });
    }
  }
  return ENABLED.flatMap((locale) =>
    slugs.map(({ id, painting }) => ({
      params: { locale, id },
      props: { painting },
    })),
  );
}

const { painting } = Astro.props;
const { locale } = Astro.params;
---

<PaintingPage painting={painting} locale={locale} />
