---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDimensions } from "../../lib/dims";
import { SHOW_PRICES } from "../../lib/site";

export async function getStaticPaths() {
  const paintings = await getCollection("paintings");
  return paintings.map((painting) => ({
    params: { id: painting.id },
    props: { painting },
  }));
}

const { painting } = Astro.props;
const { Content } = await render(painting);
const price = `$${painting.data.price.toFixed(2)} CAD`;
const dims = formatDimensions(
  painting.data.widthIn ?? null,
  painting.data.heightIn ?? null,
  painting.data.depthIn ?? null,
);
const meta = [painting.data.medium, dims].filter((s) => s !== undefined && s !== "").join(" · ");
const paintingJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: painting.data.title,
  image: Astro.url.href,
  description: painting.data.alt,
  offers: {
    "@type": "Offer",
    priceCurrency: "CAD",
    price: painting.data.price.toFixed(2),
    availability: painting.data.sold
      ? "https://schema.org/SoldOut"
      : "https://schema.org/InStock",
  },
};
---

<Layout
  title={`${painting.data.title} — ${SHOW_PRICES ? price : "original painting"}`}
  description={painting.data.alt}
>
  <main class="detail" id="main">
    <p class="crumbs"><a href="/">← Back to the collection</a></p>
    <div class="detail-grid">
      <div class="frame" id="photo-wrap" title="Tap to view fullscreen">
        <Image
          src={painting.data.image}
          alt={painting.data.alt}
          width={1200}
          sizes="(min-width: 48rem) 55vw, 92vw"
        />
        {painting.data.sold && <span class="badge sold">Sold</span>}
      </div>
      <div id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Painting fullscreen view"><img id="lightbox-img" alt="" /></div>
      <div class="info">
        <p class="eyebrow">Original painting · one of a kind</p>
        <h1>{painting.data.title}</h1>
        {
          painting.data.sold ? (
            <p class="sold-note">This piece has found a home.</p>
          ) : SHOW_PRICES ? (
            <>
              <p class="price">{price}</p>
              <p class="price-note">Shipping arranged with the artist after purchase.</p>
            </>
          ) : (
            <p class="price-note">Price on request — send a note below and the artist will reply.</p>
          )
        }
        {meta !== "" && <p class="art-meta">{meta}</p>}
        <div class="desc">
          <Content />
        </div>
        {
          !painting.data.sold && (
            <>
              <button type="button" id="inquiry-reveal" class="btn-primary" hidden>Interested?</button>
              <form id="inquiry-form" data-static="true">
                <h2>Ask about this painting</h2>
                <label>Name <input name="name" type="text" required autocomplete="name" /></label>
                <label>Email <input name="email" type="email" required autocomplete="email" /></label>
                <label>Message <textarea name="message" rows="3" placeholder="Hi, I love this piece…" /></label>
                <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
                <button type="submit" class="btn-primary">Send inquiry</button>
                <p id="inquiry-status" role="status"></p>
              </form>
            </>
          )
        }
      </div>
    </div>
  </main>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(paintingJsonLd)} />
</Layout>

<script>
  // Page scripts only run on full loads — but this layout uses View Transitions,
  // so gallery → painting navigations never re-run them. Everything is wired in
  // initDetail(), called immediately AND on astro:page-load. Guards keep a
  // double-fire on the same DOM from wiring anything twice.
  function initDetail(): void {
    // Static (git-era) paintings inquire by email until they are migrated to D1.
    const form = document.getElementById("inquiry-form") as HTMLFormElement | null;
    if (form !== null && form.dataset.wired !== "1") {
      form.dataset.wired = "1";
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const status = document.getElementById("inquiry-status");
        if (status !== null) {
          status.textContent = "Thanks! Email the artist to complete your inquiry — online checkout for these pieces is coming soon.";
        }
      });
    }

    // "Interested?" reveals the form (shown openly without JS).
    const reveal = document.getElementById("inquiry-reveal") as HTMLButtonElement | null;
    if (reveal !== null && form !== null && reveal.dataset.wired !== "1") {
      reveal.dataset.wired = "1";
      form.hidden = true;
      reveal.hidden = false;
      reveal.addEventListener("click", () => {
        form.hidden = false;
        reveal.hidden = true;
        const name = form.querySelector('input[name="name"]') as HTMLInputElement | null;
        name?.focus();
      });
    }

    // Tap photo → fullscreen overlay. Document-level listeners are registered
    // once per browser session — the elements they act on are re-queried live.
    if ((window as unknown as { __detailDocWired?: boolean }).__detailDocWired !== true) {
      (window as unknown as { __detailDocWired?: boolean }).__detailDocWired = true;
      const close = (): void => {
        if (document.fullscreenElement !== null) {
          document.exitFullscreen().catch(() => undefined);
        }
        const box = document.getElementById("lightbox");
        if (box !== null) box.hidden = true;
      };
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const box = document.getElementById("lightbox");
          if (box !== null && !box.hidden) close();
        }
      });
      document.addEventListener("fullscreenchange", () => {
        if (document.fullscreenElement === null) {
          const box = document.getElementById("lightbox");
          if (box !== null) box.hidden = true;
        }
      });
    }

    const wrap = document.getElementById("photo-wrap");
    const box = document.getElementById("lightbox") as HTMLElement | null;
    const full = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const photo = wrap?.querySelector("img") as HTMLImageElement | null | undefined;
    if (wrap !== null && box !== null && full !== null && photo != null && wrap.dataset.wired !== "1") {
      wrap.dataset.wired = "1";
      wrap.addEventListener("click", () => {
        full.src = photo.currentSrc === "" ? photo.src : photo.currentSrc;
        full.alt = photo.alt;
        box.hidden = false;
        if (typeof box.requestFullscreen === "function" && document.fullscreenEnabled) {
          box.requestFullscreen().catch(() => undefined);
        }
      });
      box.addEventListener("click", () => {
        if (document.fullscreenElement !== null) {
          document.exitFullscreen().catch(() => undefined);
        }
        box.hidden = true;
      });
    }
  }

  initDetail();
  document.addEventListener("astro:page-load", initDetail);
</script>

<style>
  .detail { max-width: 72rem; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  .crumbs { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .crumbs a {
    color: var(--muted); text-decoration: underline transparent;
    text-underline-offset: 4px; transition: color 0.2s ease, text-decoration-color 0.25s ease;
  }
  .crumbs a:hover { color: var(--accent); text-decoration-color: currentColor; }
  .crumbs a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 0.25rem; }
  .detail-grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 48rem) {
    .detail-grid { grid-template-columns: 1.15fr 1fr; }
    .info { position: sticky; top: 5.5rem; }
  }
  .frame {
    position: relative; background: var(--card);
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: clamp(0.7rem, 2vw, 1.1rem);
    box-shadow: var(--shadow);
    cursor: zoom-in;
  }
  .frame img { width: 100%; height: auto; display: block; border-radius: 0.25rem; }
  .badge {
    position: absolute; top: 1.2rem; right: 1.2rem;
    padding: 0.3rem 0.8rem; border-radius: 999px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em;
    background: rgb(20 18 15 / 0.82); color: #fff;
  }
  .badge.sold { background: rgb(140 29 24 / 0.9); }
  #lightbox { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.94); display: grid; place-items: center; z-index: 50; cursor: zoom-out; }
  #lightbox[hidden] { display: none; }
  #lightbox img { max-width: 100vw; max-height: 100vh; object-fit: contain; border-radius: 0; }
  .eyebrow {
    margin: 0 0 0.6rem; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
  }
  h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 500; margin: 0 0 0.75rem; text-wrap: balance; }
  .price { font-family: Georgia, serif; font-size: 1.6rem; color: var(--accent); margin: 0; }
  .price-note { font-size: 0.92rem; color: var(--muted); margin: 0.3rem 0 0; }
  .art-meta { font-size: 0.95rem; color: var(--muted); margin: 0.75rem 0 0; }
  .sold-note {
    display: inline-block; margin: 0; padding: 0.4rem 1rem; border-radius: 999px;
    background: rgb(140 29 24 / 0.1); color: #8c1d18; font-weight: 600; font-size: 0.95rem;
  }
  @media (prefers-color-scheme: dark) {
    .sold-note { color: #e89a8a; }
  }
  .desc { margin: 1.25rem 0 0; color: var(--muted); }
  .desc :global(p) { margin: 0 0 0.75rem; }
  #inquiry-reveal { margin-top: 1.75rem; width: 100%; }
  form { display: grid; gap: 0.65rem; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  form[hidden] { display: none; }
  form h2 { font-size: 1.25rem; font-weight: 500; margin: 0 0 0.25rem; }
  label { display: grid; gap: 0.3rem; font-size: 0.88rem; font-weight: 600; }
  input, textarea {
    font: inherit; font-weight: 400; font-size: 0.95rem;
    padding: 0.6rem 0.75rem; border-radius: 0.5rem;
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
    width: 100%; box-sizing: border-box;
  }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .hp { position: absolute; left: -9999px; }
  .btn-primary {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3rem; border-radius: 0.75rem; border: 0;
    background: var(--ink); color: var(--paper);
    font: inherit; font-weight: 600; cursor: pointer; padding: 0.7rem 1.5rem;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.2s ease;
  }
  .btn-primary:hover { background: var(--accent); color: var(--accent-ink); transform: translateY(-1px); }
  .btn-primary:active { transform: none; }
  .btn-primary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #inquiry-status { font-size: 0.92rem; color: var(--muted); margin: 0.25rem 0 0; min-height: 1.2em; }
</style>
