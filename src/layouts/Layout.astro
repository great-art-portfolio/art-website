---
import ClientRouter from "astro/components/ClientRouter.astro";
import Analytics from "../components/Analytics.astro";
import Signature from "../components/Signature.astro";
import background from "../assets/background.svg";
import { ARTIST_LOCATION, ARTIST_NAME, siteTitle } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = siteTitle(),
  description = "Original nature and abstract paintings, direct from the artist's studio.",
  image = "/icon.svg",
} = Astro.props;

const canonical = Astro.url.href;
const year = new Date().getFullYear();
const artistLabel = ARTIST_NAME ?? "The Studio";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171512" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🖼️</text></svg>"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Art Gallery</title>
    <ClientRouter />
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        <a href="/" id="signature" aria-label="Home — back to the gallery"><Signature /></a>
        <div class="nav-links">
          <a href="/#collection">Collection</a>
          <a href="/#about">About</a>
          <a href="/#notify" class="nav-cta">Notify me</a>
        </div>
      </nav>
    </header>

    <img id="background" src={background.src} alt="" fetchpriority="high" aria-hidden="true" />
    <slot />

    <footer class="site-footer">
      <p class="footer-mark">{artistLabel} · {ARTIST_LOCATION}</p>
      <p class="footer-sub">Every work is a one-of-a-kind original — no prints, no reproductions.</p>
      <p class="footer-sub"><a href="/privacy">Privacy</a> — no cookies, no trackers</p>
      <p class="footer-sub">© {year} {artistLabel}</p>
    </footer>

    <script>
      // Offline support: cached gallery shell + artwork, queued posts.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            // Offline mode unavailable — the site still works online.
          });
        });
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --paper: #faf7f1;
    --ink: #23201b;
    --muted: #756a5c;
    --line: #e5dccb;
    --accent: #a44a24;
    --accent-ink: #ffffff;
    --card: #fffdf8;
    --wash: radial-gradient(120% 60% at 50% -10%, #f1e7d4 0%, transparent 60%);
    --shadow: 0 24px 60px -30px rgb(60 42 20 / 0.35);
    --radius: 0.6rem;
  }
  html { scroll-behavior: smooth; }
  html, body { margin: 0; width: 100%; min-height: 100%; }
  body {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--paper);
    background-image: var(--wash);
    background-attachment: fixed;
    color: var(--ink);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, .serif {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  ::selection { background: color-mix(in srgb, var(--accent) 25%, transparent); }

  /* Sticky gallery-style header */
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .site-nav {
    max-width: 72rem; margin: 0 auto;
    padding: 0.8rem 1.5rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  #signature { display: inline-flex; color: var(--ink); }
  #signature svg { max-width: min(44vw, 11rem); height: auto; }
  .nav-links { display: flex; align-items: center; gap: 1.25rem; font-size: 0.92rem; }
  .nav-links a { color: var(--ink); text-decoration: none; opacity: 0.78; }
  .nav-links a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
  .nav-links .nav-cta {
    opacity: 1; border: 1px solid var(--ink); border-radius: 999px;
    padding: 0.35rem 1rem; font-weight: 600;
  }
  .nav-links .nav-cta:hover { background: var(--ink); color: var(--paper); text-decoration: none; }
  @media (max-width: 38rem) {
    .nav-links a:not(.nav-cta) { display: none; }
  }

  #background {
    position: fixed; inset: 0; width: 100%; height: 100%;
    z-index: -1; object-fit: cover; opacity: 0.55; pointer-events: none;
    /* Slow ambient drift — transform-only, so it never triggers repaints.
       prefers-reduced-motion switches it off (see below). */
    animation: blob-drift 28s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes blob-drift {
    from { transform: scale(1.05) translate(1.5%, -1%) rotate(-1deg); }
    to { transform: scale(1.16) translate(-2.5%, 2.5%) rotate(1.5deg); }
  }

  .site-footer {
    text-align: center; padding: 3.5rem 1.5rem 3rem;
    border-top: 1px solid var(--line);
    margin-top: 2rem;
  }
  .footer-mark { font-family: Georgia, serif; font-size: 1.1rem; margin: 0 0 0.4rem; }
  .footer-sub { font-size: 0.88rem; color: var(--muted); margin: 0.25rem 0; }
  .footer-sub a { color: var(--accent); }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #171512;
      --ink: #ece5d8;
      --muted: #a89e8e;
      --line: #35302a;
      --accent: #d08159;
      --card: #211c16;
      --wash: radial-gradient(120% 60% at 50% -10%, #2a241d 0%, transparent 60%);
      --shadow: 0 24px 60px -30px rgb(0 0 0 / 0.8);
    }
    #background { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
