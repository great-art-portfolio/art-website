---
import ClientRouter from "astro/components/ClientRouter.astro";
import Analytics from "../components/Analytics.astro";
import Signature from "../components/Signature.astro";
import AdminWordmark from "../components/AdminWordmark.astro";
import background from "../assets/background-warm.svg";
import { ARTIST_LOCATION, ARTIST_NAME, siteTitle } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = siteTitle(),
  description = "Original nature and abstract paintings, direct from the artist's studio.",
  image = "/apple-touch-icon.png",
  // "signature" on public pages, "admin" on studio pages.
  wordmark = "signature",
} = Astro.props;

const canonical = Astro.url.href;
const year = new Date().getFullYear();
const artistLabel = ARTIST_NAME ?? "The Studio";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171512" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Art Gallery</title>
    <ClientRouter />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        <a href="/" id="signature" aria-label={wordmark === "admin" ? "Admin home" : "Home — back to the gallery"}>
          {wordmark === "admin" ? <AdminWordmark /> : <Signature />}
        </a>
        <div class="nav-links">
          {wordmark === "admin" ? (
            <>
              <a href="/" class="keep">← Gallery</a>
              <a href="/admin/gallery" class="keep">Collection</a>
              <a href="/admin#sec-add" class="nav-cta">Add painting</a>
            </>
          ) : (
            <>
              <a href="/#collection">Collection</a>
              <a href="/#about">About</a>
              <a href="/#notify" class="nav-cta">Notify me</a>
            </>
          )}
        </div>
      </nav>
    </header>

    <img id="background" src={background.src} alt="" fetchpriority="high" aria-hidden="true" />
    <slot />

    <footer class="site-footer">
      <p class="footer-mark">{artistLabel} · {ARTIST_LOCATION}</p>
      <p class="footer-sub">Originals are one of a kind — prints of most pieces available on request.</p>
      <p class="footer-sub"><a href="/privacy">Privacy</a> — no cookies, no trackers
        <button type="button" id="install-app" hidden>Install the gallery app</button>
      </p>
      <p class="footer-sub">© {year} {artistLabel}</p>
    </footer>

    <script>
      // Offline support: cached gallery shell + artwork, queued posts.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            // Offline mode unavailable — the site still works online.
          });
        });
      }
      // Optional install: never prompts on its own. Only when the browser
      // offers installation does a quiet footer button appear — one tap
      // there shows the browser's own install dialog.
      var deferredInstall = null;
      window.addEventListener("beforeinstallprompt", (e) => {
        e.preventDefault();
        deferredInstall = e;
        var btn = document.getElementById("install-app");
        if (btn !== null) btn.hidden = false;
      });
      document.addEventListener("click", (e) => {
        var t = e.target;
        if (t === null || t.id !== "install-app" || deferredInstall === null) return;
        var ask = deferredInstall;
        deferredInstall = null;
        t.hidden = true;
        ask.prompt();
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --paper: #faf7f1;
    --ink: #23201b;
    --muted: #756a5c;
    --line: #e5dccb;
    --accent: #a44a24;
    --accent-ink: #ffffff;
    --card: #fffdf8;
    --wash: radial-gradient(120% 60% at 50% -10%, #f1e7d4 0%, transparent 60%);
    --shadow: 0 24px 60px -30px rgb(60 42 20 / 0.35);
    --radius: 0.6rem;
  }
  html { scroll-behavior: smooth; }
  /* Reserve the scrollbar gutter on every page: the gallery scrolls (gutter
     present) while a short painting page may not (gutter absent), and that
     appear/disappear is what nudges the centered header + footer sideways. */
  html { scrollbar-gutter: stable; }
  html, body { margin: 0; width: 100%; min-height: 100%; }
  body {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--paper);
    background-image: var(--wash);
    background-attachment: fixed;
    color: var(--ink);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, .serif {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  ::selection { background: color-mix(in srgb, var(--accent) 25%, transparent); }
  .skip {
    position: absolute; left: 1rem; top: -4rem; z-index: 50;
    background: var(--ink); color: var(--paper);
    padding: 0.6rem 1.2rem; border-radius: 0.5rem; text-decoration: none;
    transition: top 0.2s ease;
  }
  .skip:focus-visible { top: 0.75rem; }

  /* Sticky gallery-style header */
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .site-nav {
    max-width: 76rem; margin: 0 auto;
    padding: 0.8rem 1.5rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  /* Optical left-align: the script's hairline lead-in sits ~5px inboard of
     the SVG edge at rendered size, so the heavy stroke starts right of the
     content edge. This pulls the visual weight back onto it. */
  #signature { display: inline-flex; color: var(--ink); margin-left: -0.25rem; }
  /* Logo sizing lives in Signature.astro (scoped CSS here can't reach it). */
  .nav-links { display: flex; align-items: center; gap: 1.25rem; font-size: 0.92rem; }
  .nav-links a {
    color: var(--ink); opacity: 0.78;
    text-decoration: underline transparent; text-underline-offset: 4px;
    transition: opacity 0.2s ease, background-color 0.25s ease, color 0.25s ease,
      text-decoration-color 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }
  .nav-links a:not(.nav-cta):hover { opacity: 1; text-decoration-color: currentColor; }
  .nav-links a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 0.35rem; }
  .nav-links .nav-cta {
    opacity: 1; border: 1px solid var(--ink); border-radius: 999px;
    padding: 0.35rem 1rem; font-weight: 600;
  }
  .nav-links .nav-cta:hover {
    background-color: var(--accent); border-color: var(--accent); color: var(--accent-ink);
    text-decoration-color: transparent; opacity: 1;
  }
  @media (hover: hover) {
    .nav-links .nav-cta:hover { transform: translateY(-1px); }
  }
  .nav-links .nav-cta:active { transform: none; }
  .nav-links .nav-cta { white-space: nowrap; flex-shrink: 0; }
  @media (max-width: 38rem) {
    /* The studio keeps its way home: .keep links stay visible. */
    .nav-links a:not(.nav-cta):not(.keep) { display: none; }
    .site-nav { padding: 0.7rem 1rem; gap: 0.5rem; }
    #signature { min-width: 0; }
    .nav-links { gap: 0.75rem; }
    .nav-links .nav-cta { padding: 0.32rem 0.9rem; font-size: 0.85rem; }
  }

  #background {
    position: fixed; inset: 0; width: 100%; height: 100%;
    z-index: -1; object-fit: cover; opacity: 0.35; pointer-events: none;
    /* Slow ambient drift — transform-only, so it never triggers repaints.
       prefers-reduced-motion switches it off (see below). */
    animation: blob-drift 42s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes blob-drift {
    from { transform: scale(1) translate(0, 0); }
    to { transform: scale(1.08) translate(-1.5%, 2%); }
  }

  .site-footer {
    text-align: center; padding: 3.5rem 1.5rem 3rem;
    border-top: 1px solid var(--line);
    margin-top: 2rem;
  }
  .footer-mark { font-family: Georgia, serif; font-size: 1.1rem; margin: 0 0 0.4rem; }
  .footer-sub { font-size: 0.88rem; color: var(--muted); margin: 0.25rem 0; }
  .footer-sub a {
    color: var(--accent); text-decoration: underline transparent;
    text-underline-offset: 3px; transition: text-decoration-color 0.25s ease;
  }
  .footer-sub a:hover { text-decoration-color: currentColor; }
  .footer-sub a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 0.25rem; }
  /* Quiet install option: reads as footer text until tapped. */
  #install-app {
    font: inherit; color: var(--accent); background: none; border: 0; padding: 0;
    text-decoration: underline transparent; text-underline-offset: 3px; cursor: pointer;
  }
  #install-app::before { content: "· "; color: var(--muted); }
  #install-app:hover { text-decoration-color: currentColor; }
  #install-app:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 0.25rem; }
  #install-app[hidden] { display: none; }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #171512;
      --ink: #ece5d8;
      --muted: #a89e8e;
      --line: #35302a;
      --accent: #d08159;
      --card: #211c16;
      --wash: radial-gradient(120% 60% at 50% -10%, #2a241d 0%, transparent 60%);
      --shadow: 0 24px 60px -30px rgb(0 0 0 / 0.8);
    }
    #background { opacity: 0.22; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
