---
import Layout from "../layouts/Layout.astro";
import { SHOW_PRICES } from "../lib/site";
---

<Layout title="Painting">
  <main class="detail">
    <p class="crumbs"><a href="/">← Back to the collection</a></p>
    <div class="detail-grid" id="art-detail" data-show-prices={SHOW_PRICES ? "1" : "0"} hidden>
      <div class="frame" id="art-frame" title="Tap to view it fullscreen.">
        <img id="art-image" alt="" />
      </div>
      <div class="info">
        <p class="eyebrow">Original painting · one of a kind</p>
        <h1 id="art-title"></h1>
        <p class="price" id="art-price"></p>
        <p class="price-note" id="art-price-note"></p>
        <p class="dims" id="art-dims"></p>
        <p class="desc" id="art-desc"></p>
        <p class="hint">Tap the photo to view it fullscreen.</p>
        <div id="ar-mount" hidden>
          <h2>Try it on your wall</h2>
          <p class="hint">True size — point your phone at the wall where it would hang.</p>
          <div id="ar-stage"></div>
        </div>
        <div class="row">
          <button type="button" id="buy-now" class="btn-ghost">Buy now</button>
        </div>
        <button type="button" id="inquiry-reveal" class="btn-primary" hidden>Interested?</button>
        <form id="inquiry-form">
          <h2>Ask about this painting</h2>
          <label>Name <input name="name" type="text" required autocomplete="name" /></label>
          <label>Email <input name="email" type="email" required autocomplete="email" /></label>
          <label>Message <textarea name="message" rows="3" placeholder="Hi, I love this piece…"></textarea></label>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <div id="turnstile-mount"></div>
          <button type="submit" class="btn-primary">Send inquiry</button>
          <p id="inquiry-status" role="status"></p>
        </form>
      </div>
    </div>
  </main>
  <div id="lightbox" hidden><img id="lightbox-img" alt="" /></div>
  <main class="detail" id="art-missing" hidden>
    <h1>That painting isn't here</h1>
    <p>It may have sold and been archived. <a href="/">Back to the gallery</a></p>
  </main>
</Layout>

<script>
  import { api, type ApiPainting } from "../lib/api";
  import { armOutboxFlush, queuePost } from "../lib/queue";
  import { formatCAD } from "../lib/money";
  import { formatDimensions } from "../lib/dims";

  armOutboxFlush();

  // Everything below runs in initArt(), called immediately AND on
  // astro:page-load (View-Transitions navigations don't re-run page scripts).
  // Guards keep a double-fire on the same DOM from wiring anything twice;
  // the view-count post fires once per painting via data-loaded-slug.
  function initArt(): void {
    const detail = document.getElementById("art-detail") as HTMLElement | null;
    if (detail === null) return;
    const slug = new URLSearchParams(window.location.search).get("slug") ?? "";
    const showPrices = detail.dataset.showPrices !== "0";

    let turnstileToken = "";

    interface TurnstileApi {
      render: (target: string, opts: { sitekey: string; callback: (t: string) => void }) => string;
      reset: (id: string) => void;
    }

    // Invisible-ish spam check (Cloudflare Turnstile). Absent until configured.
    if (document.getElementById("turnstile-script") === null) {
      fetch("/api/status")
        .then((res) => (res.ok ? (res.json() as Promise<{ turnstileSiteKey: string }>) : null))
        .then((data) => {
          if (data === null || data.turnstileSiteKey === "") return;
          if (document.getElementById("turnstile-script") !== null) return;
          const script = document.createElement("script");
          script.id = "turnstile-script";
          script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
          script.async = true;
          script.defer = true;
          script.onload = () => {
            const tApi = (window as unknown as { turnstile?: TurnstileApi }).turnstile;
            if (tApi === undefined) return;
            tApi.render("#turnstile-mount", {
              sitekey: (data as { turnstileSiteKey: string }).turnstileSiteKey,
              callback: (t: string) => {
                turnstileToken = t;
              },
            });
          };
          document.head.appendChild(script);
        })
        .catch(() => {
          // Spam check unavailable — the honeypot still guards the form.
        });
    }

    async function load(): Promise<void> {
      if (detail!.dataset.loadedSlug === slug) return;
      let painting: ApiPainting;
      try {
        const res = await fetch(`/api/paintings/${encodeURIComponent(slug)}`);
        if (!res.ok) throw new Error("not found");
        painting = ((await res.json()) as { painting: ApiPainting }).painting;
      } catch {
        (document.getElementById("art-missing") as HTMLElement).hidden = false;
        return;
      }
      detail!.dataset.loadedSlug = slug;
      document.title = `${painting.title} · Art Gallery`;
      const img = document.getElementById("art-image") as HTMLImageElement;
      img.src = painting.image_url;
      img.alt = painting.alt === "" ? painting.title : painting.alt;
      (document.getElementById("art-title") as HTMLElement).textContent = painting.title;
      const priceEl = document.getElementById("art-price") as HTMLElement;
      const priceNote = document.getElementById("art-price-note") as HTMLElement;
      if (painting.status === "sold") {
        priceEl.textContent = "Sold";
        priceEl.classList.add("is-sold");
        priceNote.textContent = "This piece has found a home.";
      } else if (showPrices) {
        priceEl.textContent = `${formatCAD(painting.price_cents)} CAD`;
        priceNote.textContent = "Shipping arranged with the artist after purchase.";
      } else {
        priceEl.textContent = "";
        priceNote.textContent = "Price on request — send a note below and the artist will reply.";
      }
      (document.getElementById("art-dims") as HTMLElement).textContent = formatDimensions(
        painting.width_in,
        painting.height_in,
        painting.depth_in,
      );
      const withAr = painting.model_glb_url !== "" ? painting : null;
      if (withAr !== null) {
        const mount = document.getElementById("ar-mount") as HTMLElement;
        mount.hidden = false;
        void import("@google/model-viewer")
          .then(() => {
            const stage = document.getElementById("ar-stage") as HTMLElement;
            stage.innerHTML = "";
            const el = document.createElement("model-viewer") as unknown as HTMLElement;
            el.setAttribute("src", withAr.model_glb_url);
            if (withAr.model_usdz_url !== "") {
              el.setAttribute("ios-src", withAr.model_usdz_url);
            }
            el.setAttribute("ar", "");
            el.setAttribute("ar-modes", "webxr scene-viewer quick-look");
            el.setAttribute("ar-scale", "fixed");
            el.setAttribute("ar-placement", "wall");
            el.setAttribute("camera-controls", "");
            el.setAttribute("alt", withAr.alt === "" ? withAr.title : withAr.alt);
            el.style.width = "100%";
            el.style.height = "20rem";
            el.style.borderRadius = "1rem";
            stage.appendChild(el);
          })
          .catch(() => {
            mount.hidden = true;
          });
      }
      (document.getElementById("art-desc") as HTMLElement).textContent = painting.description;
      detail!.hidden = false;
      // Fire-and-forget, offline-safe view count.
      void queuePost("/api/views", { slug: painting.slug });
      armLightbox();
      armReveal();
      wireForm(painting);
      wireBuy(painting);
    }

    /** "Interested?" reveals the inquiry form (shown openly without JS). */
    function armReveal(): void {
      const btn = document.getElementById("inquiry-reveal") as HTMLButtonElement;
      const form = document.getElementById("inquiry-form") as HTMLFormElement;
      if (btn.dataset.wired === "1") return;
      btn.dataset.wired = "1";
      form.hidden = true;
      btn.hidden = false;
      btn.addEventListener("click", () => {
        form.hidden = false;
        btn.hidden = true;
        const name = form.querySelector('input[name="name"]') as HTMLInputElement | null;
        name?.focus();
      });
    }

    /** Tap photo → fullscreen overlay (Fullscreen API where available). */
    function armLightbox(): void {
      if ((window as unknown as { __artDocWired?: boolean }).__artDocWired !== true) {
        (window as unknown as { __artDocWired?: boolean }).__artDocWired = true;
        const closeBox = (): void => {
          if (document.fullscreenElement !== null) {
            document.exitFullscreen().catch(() => {
              // Already closed — just hide the overlay.
            });
          }
          (document.getElementById("lightbox") as HTMLElement).hidden = true;
        };
        document.addEventListener("keydown", (e) => {
          const box = document.getElementById("lightbox") as HTMLElement | null;
          if (e.key === "Escape" && box !== null && !box.hidden) closeBox();
        });
        document.addEventListener("fullscreenchange", () => {
          if (document.fullscreenElement === null) {
            const box = document.getElementById("lightbox") as HTMLElement | null;
            if (box !== null) box.hidden = true;
          }
        });
      }
      const frame = document.getElementById("art-frame") as HTMLElement;
      if (frame.dataset.wired === "1") return;
      frame.dataset.wired = "1";
      const img = document.getElementById("art-image") as HTMLImageElement;
      const box = document.getElementById("lightbox") as HTMLElement;
      const full = document.getElementById("lightbox-img") as HTMLImageElement;
      frame.addEventListener("click", () => {
        full.src = img.src;
        full.alt = img.alt;
        box.hidden = false;
        if (typeof box.requestFullscreen === "function" && document.fullscreenEnabled) {
          box.requestFullscreen().catch(() => {
            // Overlay alone is fine.
          });
        }
      });
      box.addEventListener("click", () => {
        if (document.fullscreenElement !== null) {
          document.exitFullscreen().catch(() => {
            // Already closed — just hide the overlay.
          });
        }
        box.hidden = true;
      });
    }

    function wireForm(painting: ApiPainting): void {
      const form = document.getElementById("inquiry-form") as HTMLFormElement;
      if (form.dataset.wired === "1") return;
      form.dataset.wired = "1";
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        if (((data.get("website") as string) ?? "") !== "") return; // honeypot
        const status = document.getElementById("inquiry-status") as HTMLElement;
        status.textContent = "Sending…";
        queuePost("/api/inquiries", {
          paintingId: painting.id,
          name: String(data.get("name") ?? ""),
          email: String(data.get("email") ?? ""),
          message: String(data.get("message") ?? ""),
          website: "",
          turnstileToken,
        }).then((result) => {
          status.textContent =
            result === "sent"
              ? "Thanks! The artist will reply by email."
              : result === "queued"
                ? "Saved — it will send automatically when you're back online."
                : "That didn't go through — check your email address and try again.";
          if (result === "sent") form.reset();
        });
      });
    }

    function wireBuy(painting: ApiPainting): void {
      const buy = document.getElementById("buy-now") as HTMLButtonElement;
      if (buy.dataset.wired === "1") return;
      buy.dataset.wired = "1";
      buy.addEventListener("click", () => {
        const status = document.getElementById("inquiry-status") as HTMLElement;
        status.textContent = "Opening checkout…";
        api
          .checkout(painting.id)
          .then((url) => {
            window.location.href = url;
          })
          .catch((err: unknown) => {
            status.textContent = `Online checkout isn't on yet — use the inquiry form above. (${(err as Error).message})`;
          });
      });
    }

    void load();
  }

  initArt();
  document.addEventListener("astro:page-load", initArt);
</script>

<style>
  .detail { max-width: 72rem; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  .detail[hidden] { display: none; }
  .crumbs { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .detail-grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 48rem) {
    .detail-grid { grid-template-columns: 1.15fr 1fr; }
    .info { position: sticky; top: 5.5rem; }
  }
  .frame {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    padding: clamp(0.7rem, 2vw, 1.1rem);
    box-shadow: var(--shadow);
    cursor: zoom-in;
  }
  .frame img { width: 100%; height: auto; display: block; border-radius: 0.25rem; }
  #lightbox { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.94); display: grid; place-items: center; z-index: 50; cursor: zoom-out; }
  #lightbox[hidden] { display: none; }
  #lightbox img { max-width: 100vw; max-height: 100vh; object-fit: contain; }
  .eyebrow {
    margin: 0 0 0.6rem; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
  }
  h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 500; margin: 0 0 0.75rem; text-wrap: balance; }
  h1:empty { display: none; }
  .price { font-family: Georgia, serif; font-size: 1.6rem; color: var(--accent); margin: 0; }
  .price:empty { display: none; }
  .price.is-sold { color: var(--muted); }
  .price-note { font-size: 0.92rem; color: var(--muted); margin: 0.3rem 0 0; }
  .price-note:empty { display: none; }
  .dims { color: var(--muted); margin: 0.5rem 0 0; font-size: 0.95rem; }
  .dims:empty { display: none; }
  .desc { margin: 1.25rem 0 0; color: var(--muted); }
  .desc:empty { display: none; }
  .hint { font-size: 0.85rem; color: var(--muted); }
  #ar-mount { margin-block: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  #ar-mount h2 { font-size: 1.25rem; font-weight: 500; margin: 0 0 0.25rem; }
  #ar-mount .hint { margin: 0 0 0.75rem; }
  .row { margin-block: 1rem; }
  form { display: grid; gap: 0.65rem; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  form[hidden] { display: none; }
  #inquiry-reveal { margin-top: 1.75rem; width: 100%; }
  form h2 { font-size: 1.25rem; font-weight: 500; margin: 0 0 0.25rem; }
  label { display: grid; gap: 0.3rem; font-size: 0.88rem; font-weight: 600; }
  input, textarea {
    font: inherit; font-weight: 400; font-size: 0.95rem;
    padding: 0.6rem 0.75rem; border-radius: 0.5rem;
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
    width: 100%; box-sizing: border-box;
  }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .hp { position: absolute; left: -9999px; }
  .btn-primary {
    min-height: 3rem; border-radius: 0.75rem; border: 0;
    background: var(--ink); color: var(--paper);
    font: inherit; font-weight: 600; cursor: pointer; padding: 0.7rem 1.5rem;
    transition: background 0.2s ease;
  }
  .btn-primary:hover { background: var(--accent); color: var(--accent-ink); }
  .btn-ghost {
    min-height: 2.9rem; border-radius: 0.75rem;
    border: 1px solid var(--line); background: transparent; color: var(--ink);
    font: inherit; font-weight: 600; cursor: pointer; padding: 0.6rem 1.4rem;
  }
  .btn-ghost:hover { border-color: var(--ink); }
  #inquiry-status { font-size: 0.92rem; color: var(--muted); margin: 0.25rem 0 0; min-height: 1.2em; }
</style>
