---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import { formatDimensions } from "../lib/dims";
import {
  GALLERY_WIDTHS,
  SOLD_WIDTHS,
  gallerySizes,
  soldSizes,
} from "../lib/responsive-images";
import { SHOW_PRICES, slugifyTitle, workCount } from "../lib/site";
import { isExpired, localToday, parseAnnouncement } from "../lib/banner";
import bannerRaw from "../content/announcement.txt?raw";

type Painting = CollectionEntry<"paintings">;
const dimsOf = (p: Painting): string =>
  formatDimensions(p.data.widthIn ?? null, p.data.heightIn ?? null, p.data.depthIn ?? null);

const paintings = await getCollection("paintings");
const available = paintings.filter((p) => !p.data.sold);
const sold = paintings.filter((p) => p.data.sold);

// One homepage banner at a time, edited from /admin (git). Empty = hidden.
// Expired at build time = not rendered; expiry between deploys is hidden
// by the script below (data-expires).
const banner = parseAnnouncement(bannerRaw);
const announcement = isExpired(banner.expires, localToday()) ? "" : banner.text;
const NEW_MS = 21 * 24 * 60 * 60 * 1000;
const isNewStatic = (d: Date): boolean => Date.now() - d.getTime() < NEW_MS;

const priceLabel = (price: number): string => `$${price.toFixed(2)} CAD`;
---

{announcement !== "" && <p class="announce" data-expires={banner.expires ?? ""}>{announcement}</p>}

<script>
  // Time-limited banners hide themselves once past their end date, so a
  // forgotten banner doesn't linger until the next site update.
  var bannerEl = document.querySelector(".announce[data-expires]");
  if (bannerEl !== null) {
    var end = bannerEl.getAttribute("data-expires");
    if (end !== null && end !== "") {
      var now = new Date();
      var pad = function (n) { return (n < 10 ? "0" : "") + n; };
      var today = now.getFullYear() + "-" + pad(now.getMonth() + 1) + "-" + pad(now.getDate());
      if (today > end) bannerEl.remove();
    }
  }
</script>

<section class="collection" id="collection" aria-label="Available paintings">
  <div class="section-head">
    <div>
      <p class="eyebrow">The collection</p>
      <h2>Available works</h2>
    </div>
    <p class="count">{workCount(available.length)} · each one of a kind</p>
  </div>

  <div class="gallery" id="gallery-static">
    {
      available.map((painting, i) => (
        <a class="card" href={`/paintings/${slugifyTitle(painting.data.title)}`}>
          <span class="mat">
            <Image
              src={painting.data.image}
              alt={painting.data.alt}
              width={1000}
              widths={GALLERY_WIDTHS}
              sizes={gallerySizes()}
              format="webp"
              decoding="async"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
            />
            {isNewStatic(painting.data.dateAdded) && <span class="badge new">New</span>}
          </span>
          <span class="caption">
            <span class="caption-title">{painting.data.title}</span>
            <span class="caption-sub">
              {SHOW_PRICES ? (
                <span class="price">{priceLabel(painting.data.price)}</span>
              ) : (
                <span class="ask">Ask about this piece →</span>
              )}
              {dimsOf(painting) !== "" && <span class="dims">{dimsOf(painting)}</span>}
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>

{
  sold.length > 0 && (
    <section class="collection collected" id="sold" aria-label="Sold paintings">
      <div class="section-head">
        <div>
          <p class="eyebrow">Collected</p>
          <h2>Found their homes</h2>
        </div>
        <p class="count">{workCount(sold.length)} sold</p>
      </div>
      <div class="gallery sold-grid">
        {sold.map((painting) => (
          <a class="card" href={`/paintings/${slugifyTitle(painting.data.title)}`}>
            <span class="mat">
              <Image
                src={painting.data.image}
                alt={painting.data.alt}
                width={700}
                widths={SOLD_WIDTHS}
                loading="lazy"
                sizes={soldSizes()}
                format="webp"
                decoding="async"
              />
              <span class="badge sold">Sold</span>
            </span>
            <span class="caption">
              <span class="caption-title">{painting.data.title}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .announce {
    max-width: 76rem; margin: 0 auto 1.5rem; padding: 0.8rem 1.5rem;
    text-align: center; font-size: 0.95rem;
    color: var(--ink); background: var(--card);
    border: 1px solid var(--line); border-radius: var(--radius);
  }
  .collection {
    max-width: 76rem; margin: 0 auto;
    padding: 1rem 1.5rem 2rem;
    scroll-margin-top: 5rem;
  }
  .section-head {
    display: flex; align-items: end; justify-content: space-between; gap: 1rem;
    margin: 0 0 2.5rem; padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .eyebrow {
    margin: 0 0 0.35rem; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
  }
  .section-head h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 500; }
  .count { margin: 0; font-size: 0.9rem; color: var(--muted); white-space: nowrap; }

  .gallery { display: grid; gap: 3rem 2.5rem; align-items: start; }
  #gallery-static {
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    #gallery-static { grid-template-columns: repeat(2, 1fr); gap: 3.5rem 2.5rem; }
  }
  /* Desktop: editorial rhythm — a large feature, an offset companion, then trios. */
  @media (min-width: 60rem) {
    #gallery-static { grid-template-columns: repeat(12, 1fr); }
    #gallery-static > .card:nth-child(1) { grid-column: span 7; }
    #gallery-static > .card:nth-child(2) { grid-column: span 5; margin-top: 5rem; }
    #gallery-static > .card:nth-child(n + 3) { grid-column: span 4; }
    #gallery-static > .card:nth-child(n + 6) { margin-top: 2.5rem; }
  }

  .card {
    display: block; color: inherit; text-decoration: none;
    border-radius: var(--radius);
    animation: rise 0.5s ease both;
  }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .card:nth-child(2) { animation-delay: 0.06s; }
  .card:nth-child(3) { animation-delay: 0.12s; }
  .card:nth-child(n + 4) { animation-delay: 0.18s; }
  .mat {
    position: relative; display: block;
    background: var(--card); border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(0.6rem, 1.5vw, 0.9rem);
    box-shadow: var(--shadow);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  @media (hover: hover) {
    .card:hover .mat { transform: translateY(-4px); }
  }
  .mat img {
    width: 100%; height: auto; display: block; border-radius: 0.25rem;
    background: #eee;
    /* Future extreme portraits: cap height instead of letting one tall
       card stretch its row. object-fit keeps the art undistorted. */
    max-height: 80vh; object-fit: contain;
  }
  .caption { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.9rem 0.25rem 0; }
  .caption-title {
    font-family: Georgia, serif; font-size: 1.2rem;
    text-decoration: underline transparent; text-underline-offset: 4px;
    transition: text-decoration-color 0.25s ease;
  }
  .card:hover .caption-title { text-decoration-color: currentColor; }
  .caption-sub { font-size: 0.95rem; }
  .price { font-weight: 700; color: var(--accent); }
  .ask { color: var(--accent); font-weight: 600; }
  .caption-sub { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: baseline; }
  .dims { font-size: 0.88rem; color: var(--muted); }
  .muted { color: var(--muted); }
  .badge {
    position: absolute; top: 1.1rem; right: 1.1rem;
    padding: 0.3rem 0.8rem; border-radius: 999px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em;
    background: rgb(20 18 15 / 0.82); color: #fff;
  }
  .badge.sold { background: rgb(140 29 24 / 0.9); }
  .badge.new { background: rgb(46 110 94 / 0.9); }

  /* Sold archive: smaller, quieter, uniform. */
  .collected { margin-top: 1rem; }
  .sold-grid { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 2rem; }
  @media (min-width: 60rem) {
    .sold-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .sold-grid .mat { box-shadow: none; }
  .sold-grid img { filter: saturate(0.88); }
  .sold-grid .caption-title { font-size: 1.02rem; }

  /* Opacity-only entrance: the taste filter flags slide-up-on-scroll as
     AI-slop, and even on load a rise reads busier than a quiet fade. */
  @keyframes rise {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
