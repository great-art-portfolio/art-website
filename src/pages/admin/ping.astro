---
import Layout from "../../layouts/Layout.astro";
import "../../components/studio.css";
---

<Layout title="Admin - Ping" wordmark="admin" noindex>
  <main class="admin" id="main">
    <section id="sec-tickle" class="prose">
      <h2>Ping subscribers</h2>
      <p class="hint">
        Sends a browser ping to subscribers (no email). Add a line if you like —
        otherwise buyers see the standard note. Preview on this device shows the
        real system ping on this browser only — nothing goes to subscribers.
      </p>
      <label
        >Message (optional)
        <input
          type="text"
          id="tickle-body"
          maxlength="180"
          autocomplete="off"
          placeholder="Blank: Something new in the gallery — tap to see it"
        />
      </label>
      <div class="row">
        <button type="button" id="tickle-send">Ping subscribers</button>
        <button type="button" id="tickle-preview-send"
          >Preview on this device</button
        >
      </div>
      <div id="tickle-preview" aria-label="How the ping will look">
        <img src="/favicon.png" alt="" width="40" height="40" />
        <p>
          <strong>Something new in the gallery</strong>
          <span id="tickle-preview-body">Tap to see it.</span>
        </p>
      </div>
      <p class="hint" id="tickle-status" role="status"></p>
    </section>
  </main>
</Layout>

<script src="../../components/AdminPanel.ts"></script>

<style>
  /* The button hugs the left — a flex row that wraps on narrow phones.
     Its result sits below, hidden until it has something to say. */
  #sec-tickle .row {
    margin-top: 1rem;
    justify-content: start;
  }
  #tickle-status {
    margin: 0.75rem 0 0;
  }
  #tickle-status:empty {
    display: none;
  }
  /* The ping preview wears the notification shape: her icon, the
     fixed title, the line she's typing. Blank shows the standard
     note, exactly what buyers get. */
  #tickle-preview {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    margin-top: 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    max-width: 26rem;
  }
  #tickle-preview img {
    flex-shrink: 0;
    border-radius: 8px;
  }
  #tickle-preview p {
    margin: 0;
    min-width: 0;
  }
  #tickle-preview strong {
    display: block;
    font-size: 0.95rem;
  }
  #tickle-preview span {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
</style>
