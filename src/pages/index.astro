---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
import { ARTIST_LOCATION, ARTIST_NAME, TAGLINE } from "../lib/site";
import { isExpired, localToday, parseAnnouncement } from "../lib/banner";
import bannerRaw from "../content/announcement.txt?raw";

// The header wordmark already carries the artist's name, so the hero
// headline stays generic instead of repeating "by …".
const headlineHtml = "Original paintings, from the studio";

// One studio note at a time, set from /admin (git). Empty = hidden.
// Expired at build time = not rendered; expiry between deploys is hidden
// by the script below (data-expires).
const banner = parseAnnouncement(bannerRaw);
const announcement = isExpired(banner.expires, localToday()) ? "" : banner.text;
---

<Layout>
  <main id="main">
    <section class:list={["hero", announcement !== "" && "hero-note"]}>
      <div class="hero-main">
        <p class="eyebrow">{TAGLINE} · {ARTIST_LOCATION}</p>
        <h1 set:html={headlineHtml} />
        <p class="lede">
          Nature and abstract originals, painted by hand and sold directly from
          the studio. What you see is the actual painting — and when an original
          sells, only its prints remain.
        </p>
        <div class="hero-ctas">
          <a href="#collection" class="btn-primary">Browse the collection</a>
          <button type="button" class="btn-ghost" id="notify-hero"
            >Get notified of new work</button
          >
        </div>
      </div>
      {
        announcement !== "" && (
          <aside class="announce" data-expires={banner.expires ?? ""}>
            {announcement}
          </aside>
        )
      }
      <dl class="hero-meta">
        <div>
          <dt>Originals &amp; prints</dt><dd>painted once, printed to order</dd>
        </div>
        <div><dt>Direct</dt><dd>from the studio, no gallery markup</dd></div>
        <div>
          <dt>Shipped with care</dt><dd>arranged together after purchase</dd>
        </div>
      </dl>
    </section>

    <Gallery />

    <section class="about" id="about">
      <div class="about-inner">
        <p class="eyebrow">From the studio</p>
        <h2>Painted in {ARTIST_LOCATION}</h2>
        <p>
          {ARTIST_NAME} paints nature and abstraction from her Calgary studio — prairie
          light, quiet water, and colour studies that sit somewhere between landscape
          and feeling. Every piece here starts as an original — most are also available
          as prints. When an original sells, it's gone for good — though its prints
          live on.
        </p>
        <p>
          See something you love? Open the painting and tap <strong
            >Interested?</strong
          > — your note goes straight to the artist. Pieces are sold directly, so
          the price you see is the price — shipping is arranged together after purchase.
        </p>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Time-limited studio notes hide themselves once past their end date,
  // so a forgotten note doesn't linger until the next site update. Every
  // expired node goes: baked and preview can share the page in dev.
  // (Inline scripts are plain JS — annotations don't survive astro check,
  // so this stays annotation-free on purpose.)
  const notes = document.querySelectorAll(".announce[data-expires]");
  const now = new Date();
  const today =
    now.getFullYear() +
    "-" +
    String(now.getMonth() + 1).padStart(2, "0") +
    "-" +
    String(now.getDate()).padStart(2, "0");
  for (const note of notes) {
    const end = note.getAttribute("data-expires");
    if (end !== null && end !== "" && today > end) note.remove();
  }
  // Dev-only banner preview: the studio keeps banner wording in this
  // browser when there is no publishing backend, so it can be tried on
  // the homepage for real — in the same side card the real note uses.
  try {
    const raw = window.localStorage.getItem("studio-banner-preview-v1");
    if (raw !== null) {
      const preview = JSON.parse(raw);
      const text =
        preview !== null && typeof preview === "object"
          ? String(preview.text ?? "")
          : "";
      const expires =
        preview !== null && typeof preview === "object"
          ? String(preview.expires ?? "")
          : "";
      const now = new Date();
      const today =
        now.getFullYear() +
        "-" +
        String(now.getMonth() + 1).padStart(2, "0") +
        "-" +
        String(now.getDate()).padStart(2, "0");
      if (text.trim() !== "" && (expires === "" || today <= expires)) {
        let el = document.querySelector(".announce");
        if (el === null) {
          const hero = document.querySelector("#main .hero");
          const main = document.querySelector("#main .hero-main");
          if (hero !== null && main !== null) {
            el = document.createElement("aside");
            el.className = "announce";
            hero.classList.add("hero-note");
            main.insertAdjacentElement("afterend", el);
          }
        }
        if (el !== null) {
          el.textContent = text.trim().slice(0, 280);
          if (expires !== "") el.setAttribute("data-expires", expires);
          else el.removeAttribute("data-expires");
        }
      }
    }
  } catch {
    // No preview stored — the baked note (if any) stands.
  }
</script>

<style>
  .hero {
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 6.5rem) 1.5rem 3rem;
  }
  /* With a studio note, the hero splits: words left, the note card
     right. Without one the hero is exactly as before. */
  .hero-note {
    display: grid;
    gap: 2rem;
    align-content: start;
  }
  @media (min-width: 60rem) {
    .hero-note {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 0 3rem;
      align-items: center;
    }
    .hero-note .hero-meta {
      grid-column: 1 / -1;
    }
  }
  /* The studio note: a taped-up card, not a full-width bar — the kind
     of thing pinned to a studio wall. Narrow enough that short news
     never leaves a wide empty box. */
  .announce {
    position: relative;
    margin: 0;
    width: fit-content;
    max-width: 22rem;
    box-sizing: border-box;
    justify-self: center;
    transform: rotate(-1.2deg);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    box-shadow: var(--shadow);
    padding: 1.4rem 1.3rem 1.1rem;
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    font-size: 1.08rem;
  }
  /* One masking-tape strip holding the note up. */
  .announce::before {
    content: "";
    position: absolute;
    top: -0.7rem;
    left: 50%;
    width: 5.5rem;
    height: 1.4rem;
    transform: translateX(-50%) rotate(-4deg);
    background: color-mix(in srgb, var(--accent) 28%, transparent);
    opacity: 0.85;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
  }
  /* Reduced motion keeps the note planted straight. */
  @media (prefers-reduced-motion: reduce) {
    .announce {
      transform: none;
    }
  }
  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero h1 {
    margin: 0 0 1.25rem;
    font-weight: 500;
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    max-width: 16ch;
    text-wrap: balance;
  }
  .hero h1 .nobr {
    white-space: nowrap;
  }
  .lede {
    margin: 0 0 2rem;
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 38rem;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 3rem;
  }
  .btn-primary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    text-align: center;
    min-height: 3rem;
    border-radius: 0.75rem;
    padding: 0.75rem 1.7rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.2s ease;
  }
  /* Lift only where a real hover pointer exists — on touch it would stick after tap. */
  @media (hover: hover) {
    .btn-primary:hover,
    .btn-ghost:hover {
      transform: translateY(-1px);
    }
  }
  /* Reduced motion kills the button lifts; color fades still transition. */
  @media (prefers-reduced-motion: reduce) {
    .btn-primary:hover,
    .btn-ghost:hover {
      transform: none;
    }
  }
  .btn-primary:active,
  .btn-ghost:active {
    transform: none;
  }
  .btn-primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .btn-ghost:hover {
    border-color: var(--ink);
  }
  .btn-primary:focus-visible,
  .btn-ghost:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .btn-primary {
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
  }
  .btn-ghost {
    border: 1px solid var(--line);
    color: var(--ink);
    background: transparent;
  }
  button.btn-primary,
  button.btn-ghost {
    font: inherit;
    font-weight: 600;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .hero-meta div {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin: 0;
  }
  /* Narrow: a real two-column grid so every description starts at the same
     edge instead of trailing its (variably wrapping) term. */
  @media (max-width: 40rem) {
    .hero-meta {
      display: grid;
      gap: 0.75rem;
    }
    .hero-meta div {
      display: grid;
      grid-template-columns: 7.5rem 1fr;
      gap: 0.25rem 1rem;
      align-items: baseline;
    }
    .hero-meta dd {
      text-wrap: pretty;
    }
  }
  .hero-meta dt {
    font-weight: 700;
    font-size: 0.9rem;
  }
  .hero-meta dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .about {
    max-width: 76rem;
    margin: 1rem auto 0;
    padding: 0 1.5rem 3rem;
    scroll-margin-top: 5rem;
  }
  .about-inner {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    max-width: 44rem;
  }
  .about-inner h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
  }
  .about-inner p {
    margin: 0 0 1rem;
    color: var(--muted);
  }
  .about-inner p:last-child {
    margin-bottom: 0;
  }
  .about-inner strong {
    color: var(--ink);
  }
</style>
