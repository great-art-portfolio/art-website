---
import { Picture } from "astro:assets";
import { publicPaintings, type Painting } from "../lib/collection";
import { sizeFor } from "../lib/dims";
import { desktopSlots, galleryTiles } from "../lib/gallery-layout";
import { formatPriceCAD } from "../lib/money";
import {
  GALLERY_WIDTHS,
  SOLD_WIDTHS,
  featuredSizes,
  gallerySizes,
  soldSizes,
} from "../lib/responsive-images";
import { SHOW_PRICES, slugifyTitle } from "../lib/site";
import { t } from "../i18n";
import { paintingWordsIn } from "../i18n/content";
import { localePath, type Locale } from "../i18n/locales";

interface Props {
  /** "featured" renders only the newest painting, for the homepage's top
   * section (anything slotted in, like the studio note, is pinned to it).
   * "grid" renders the collection without it, then the sold archive. */
  view?: "grid" | "featured" | undefined;
  locale?: Locale | undefined;
}
const { view = "grid", locale = "en" } = Astro.props;
const s = t(locale);

const dimsOf = (p: Painting): string =>
  sizeFor(
    locale,
    p.data.widthIn ?? null,
    p.data.heightIn ?? null,
    p.data.depthIn ?? null,
  );
// Her title and alt text in this language, once the studio has
// translated them.
const words = (p: Painting) =>
  paintingWordsIn(locale, p.filePath ?? "", {
    title: p.data.title,
    description: p.body ?? "",
    alt: p.data.alt,
    medium: p.data.medium ?? "",
  });
const pageOf = (p: Painting): string =>
  localePath(locale, `/paintings/${slugifyTitle(p.data.title)}`);

const { available, sold, featured } = await publicPaintings();
// The newest painting hangs up top, so the grid skips it.
const hung = available.filter((p) => p !== featured);

const NEW_MS = 7 * 24 * 60 * 60 * 1000;
const isNewStatic = (d: Date): boolean => Date.now() - d.getTime() < NEW_MS;

const priceLabel = (price: number): string =>
  formatPriceCAD(Math.round(price * 100));

// Much larger paintings, and wide ones, get bigger slots in the staggered
// layout so a 30 × 30 in canvas reads bigger than a 12 × 12 in one, and the
// desktop rows are packed so they always fill the width (see
// gallery-layout).
const tileInputs = hung.map((p) => ({
  aspect: p.data.image.width / p.data.image.height,
  widthIn: p.data.widthIn ?? null,
  heightIn: p.data.heightIn ?? null,
}));
const tiles = galleryTiles(tileInputs);
const slots = desktopSlots(tileInputs, tiles);
const slotClass = (i: number): string[] => {
  const s = slots[i];
  if (s === undefined) return [];
  return [
    `span-${s.span}`,
    s.start !== null ? `start-${s.start}` : "",
    s.lift > 0 ? `lift-${s.lift}` : "",
  ].filter((c) => c !== "");
};
---

{view === "featured" && featured !== undefined && (
  <figure class="feature">
    <a
      class="card feature-card"
      href={pageOf(featured)}
      data-astro-prefetch="hover"
    >
      <span
        class="mat"
        transition:name={`painting-${slugifyTitle(featured.data.title)}`}
      >
        <Picture
          src={featured.data.image}
          alt={words(featured).alt}
          width={1000}
          widths={GALLERY_WIDTHS}
          sizes={featuredSizes()}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          decoding="async"
          loading="eager"
          fetchpriority="high"
          style={`--ar: ${(featured.data.image.width / featured.data.image.height).toFixed(4)}`}
        />
      </span>
      {/* "Newest painting" sits under the painting's bottom-right corner,
          level with the title, so the painting's top lines up with the
          headline column. */}
      <span class="caption">
        <span class="caption-head">
          <span class="caption-title">{words(featured).title}</span>
          <span class="kicker">{s.gallery.newest}</span>
        </span>
        <span class="caption-sub">
          {SHOW_PRICES ? (
            <span class="price">{priceLabel(featured.data.price)}</span>
          ) : (
            <span class="ask">{s.gallery.ask}</span>
          )}
          {dimsOf(featured) !== "" && (
            <span class="dims">{dimsOf(featured)}</span>
          )}
        </span>
      </span>
    </a>
    <slot />
  </figure>
)}

{view === "grid" && (
  <section
    class="collection"
    id="collection"
    aria-label={s.gallery.availableLabel}
  >
    <div class="section-head">
      <div>
        <p class="eyebrow">{s.gallery.eyebrow}</p>
        <h2>{s.gallery.title}</h2>
      </div>
      <p class="count">{s.gallery.count(available.length)}</p>
    </div>

    <div class="gallery" id="gallery-static">
      {hung.map((painting, i) => (
        <a
          class:list={[
            "card",
            tiles[i] !== "normal" && `tile-${tiles[i]}`,
            ...slotClass(i),
          ]}
          href={pageOf(painting)}
          data-astro-prefetch="hover"
        >
          <span
            class="mat"
            transition:name={`painting-${slugifyTitle(painting.data.title)}`}
          >
            <Picture
              src={painting.data.image}
              alt={words(painting).alt}
              width={1000}
              widths={GALLERY_WIDTHS}
              sizes={gallerySizes(tiles[i] ?? "normal", slots[i]?.span ?? 4)}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              decoding="async"
              loading={featured === undefined && i === 0 ? "eager" : "lazy"}
              fetchpriority={
                featured === undefined && i === 0 ? "high" : undefined
              }
            />
            {isNewStatic(painting.data.dateAdded) && (
              <span
                class="badge new"
                data-new-until={painting.data.dateAdded.getTime() + NEW_MS}
              >
                {s.gallery.new}
              </span>
            )}
          </span>
          <span class="caption">
            <span class="caption-title">{words(painting).title}</span>
            <span class="caption-sub">
              {SHOW_PRICES ? (
                <span class="price">{priceLabel(painting.data.price)}</span>
              ) : (
                <span class="ask">{s.gallery.ask}</span>
              )}
              {dimsOf(painting) !== "" && (
                <span class="dims">{dimsOf(painting)}</span>
              )}
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>
)}

{view === "grid" && sold.length > 0 && (
  <section
    class="collection collected"
    id="sold"
    aria-label={s.gallery.soldLabel}
  >
    <div class="section-head">
      <div>
        <p class="eyebrow">{s.gallery.soldEyebrow}</p>
        <h2>{s.gallery.soldTitle}</h2>
      </div>
      <p class="count">{s.gallery.soldCount(sold.length)}</p>
    </div>
    <div class="gallery sold-grid">
      {sold.map((painting) => (
        <a class="card" href={pageOf(painting)} data-astro-prefetch="hover">
          <span
            class="mat"
            transition:name={`painting-${slugifyTitle(painting.data.title)}`}
          >
            <Picture
              src={painting.data.image}
              alt={words(painting).alt}
              width={700}
              widths={SOLD_WIDTHS}
              loading="lazy"
              sizes={soldSizes()}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              decoding="async"
            />
            <span class="badge sold">{s.gallery.sold}</span>
          </span>
          <span class="caption">
            <span class="caption-title">{words(painting).title}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
)}

<script>
  // The build marks paintings added in the past week, but the next deploy
  // can be weeks away, so the browser drops a badge once its week is up.
  function expireNewBadges() {
    const now = Date.now();
    for (const el of document.querySelectorAll(".badge.new[data-new-until]")) {
      if (el instanceof HTMLElement && Number(el.dataset.newUntil) <= now)
        el.remove();
    }
  }
  expireNewBadges();
  document.addEventListener("astro:page-load", expireNewBadges);
</script>

<style>
  .collection {
    max-width: 76rem;
    margin: 0 auto;
    padding: 1rem 1.5rem 2rem;
    scroll-margin-top: 5rem;
  }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0 0 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .section-head > div {
    min-width: 0;
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
  .section-head h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 500;
    text-wrap: balance;
  }
  .count {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .gallery {
    display: grid;
    gap: 3rem 2.5rem;
    align-items: start;
  }
  #gallery-static {
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    #gallery-static {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5rem 2.5rem;
    }
  }
  /* Desktop: rows packed by desktopSlots (lib/gallery-layout) on a
     12-column grid. Each card carries its span, a start column when it's
     centered alone, and a drop for the stagger (7+5, 4+4+4, 5+7, 4+4+4,
     with big and wide paintings at 8 beside a 4). Every row fills the
     width, so cards flow in order. */
  @media (min-width: 60rem) {
    #gallery-static {
      grid-template-columns: repeat(12, 1fr);
    }
    #gallery-static > .span-4 {
      grid-column: span 4;
    }
    #gallery-static > .span-5 {
      grid-column: span 5;
    }
    #gallery-static > .span-6 {
      grid-column: span 6;
    }
    #gallery-static > .span-7 {
      grid-column: span 7;
    }
    #gallery-static > .span-8 {
      grid-column: span 8;
    }
    #gallery-static > .span-12 {
      grid-column: 1 / -1;
    }
    #gallery-static > .start-3 {
      grid-column: 3 / span 8;
    }
    #gallery-static > .start-4 {
      grid-column: 4 / span 6;
    }
    #gallery-static > .lift-1 {
      margin-top: 2.5rem;
    }
    #gallery-static > .lift-2 {
      margin-top: 5rem;
    }
  }
  /* Two columns: bigger paintings take both. */
  @media (min-width: 40rem) and (max-width: 59.99rem) {
    #gallery-static {
      grid-auto-flow: dense;
    }
    #gallery-static > .card:is(.tile-big, .tile-wide, .tile-big-wide) {
      grid-column: 1 / -1;
    }
  }

  /* One column as wide as the mat, centered in the slot. The mat is as
     wide as its painting, which fills the slot unless the height cap
     stops a tall one first; then the mat hugs it instead of leaving empty
     mat beside it. The caption takes the mat's width without widening it. */
  .card {
    display: grid;
    grid-template-columns: minmax(0, max-content);
    justify-content: center;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius);
    animation: rise 0.5s ease both;
  }
  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .card:nth-child(2) {
    animation-delay: 0.06s;
  }
  .card:nth-child(3) {
    animation-delay: 0.12s;
  }
  .card:nth-child(n + 4) {
    animation-delay: 0.18s;
  }
  /* The newest painting, in the homepage's top section. */
  .feature {
    position: relative;
    margin: 0;
  }
  .caption-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }
  .kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .mat {
    position: relative;
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(0.6rem, 1.5vw, 0.9rem);
    box-shadow: var(--shadow);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }
  @media (hover: hover) {
    .card:hover .mat {
      transform: translateY(-4px);
    }
  }
  /* The newest painting holds its size before the photo arrives, so the
     page below doesn't jump when it loads. The width is the one the
     browser would draw anyway: its sizes slot (featuredSizes), or less
     when 80vh of height caps it. */
  .feature {
    --slot: 92vw;
  }
  @media (min-width: 60rem) {
    .feature {
      --slot: 44vw;
    }
  }
  @media (min-width: 76rem) {
    .feature {
      --slot: 530px;
    }
  }
  /* AVIF first, WebP for older browsers: the <picture> wrapper stays out of
     layout so the img is still the mat's own child. */
  .mat :global(picture) {
    display: contents;
  }
  .feature .mat img {
    width: min(var(--slot), calc(80vh * var(--ar)));
    aspect-ratio: var(--ar);
  }
  .mat img {
    /* Size the box to the photo rather than the column. With both max
       sizes set it keeps the photo's aspect ratio, so there's no
       letterboxing. Narrower photos are centered. */
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 80vh;
    margin: 0 auto;
    display: block;
    border-radius: 0.25rem;
    background: transparent;
    object-fit: contain;
  }
  .caption {
    contain: inline-size;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.9rem 0.25rem 0;
  }
  .caption-title {
    font-family: var(--serif);
    font-size: 1.2rem;
    text-decoration: underline transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.12s ease;
  }
  .card:hover .caption-title {
    text-decoration-color: currentColor;
  }
  /* Reduced motion removes the entrance and hover lift. The caption fade
     still runs. This comes after the hover rules so it wins. */
  @media (prefers-reduced-motion: reduce) {
    .card {
      animation: none;
    }
    .card:hover .mat {
      transform: none;
    }
  }
  .caption-sub {
    font-size: 0.95rem;
  }
  .price {
    font-weight: 700;
    color: var(--accent);
  }
  .ask {
    color: var(--accent);
    font-weight: 600;
  }
  .caption-sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }
  .dims {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
  .badge {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: rgb(20 18 15 / 0.82);
    color: #fff;
  }
  .badge.sold {
    background: rgb(140 29 24 / 0.9);
  }
  .badge.new {
    background: rgb(46 110 94 / 0.9);
  }

  /* Sold archive: smaller uniform cards. */
  .collected {
    margin-top: 1rem;
  }
  .sold-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 2rem;
  }
  @media (min-width: 60rem) {
    .sold-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .sold-grid .mat {
    box-shadow: none;
  }
  .sold-grid img {
    filter: saturate(0.88);
  }
  .sold-grid .caption-title {
    font-size: 1.02rem;
  }

  /* Opacity-only entrance. A slide-up looked busier than a fade. */
  @keyframes rise {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
