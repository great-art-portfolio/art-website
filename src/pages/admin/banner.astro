---
import Layout from "../../layouts/Layout.astro";
import "../../components/studio.css";
---

<Layout title="Admin - Banner" wordmark="admin" backdrop="banner">
  <main class="admin" id="main">
    <section id="sec-banner" class="prose">
      <h2>Homepage banner</h2>
      <aside id="banner-preview" hidden></aside>
      <label
        >Announcement
        <input
          id="f-announce"
          type="text"
          maxlength="280"
          autocomplete="off"
          placeholder="Find me at the Lilac Festival this Sunday!"
        />
      </label>
      <div class="row banner-line">
        <label
          >Show until
          <select id="f-duration">
            <option value="">No end date</option>
            <option value="1">1 day</option>
            <option value="3">3 days</option>
            <option value="7" selected>7 days</option>
            <option value="14">2 weeks</option>
          </select>
        </label>
        <button type="button" id="announce-save" class="primary"
          >Update banner</button
        >
        <button type="button" id="announce-clear" hidden>
          Remove banner
        </button>
      </div>
      <p class="hint" id="announce-meta"></p>
    </section>
  </main>
</Layout>

<script src="../../components/AdminPanel.ts"></script>

<style>
  /* Desktop: Show-until, Update, and Remove share one row, bottoms
     level with the dropdown; the status sits below all three. The row
     wraps on narrow phones. */
  #sec-banner .banner-line {
    margin-top: 1.25rem;
    align-items: end;
  }
  /* The shared .row grows labels to fill — the dropdown hugs instead,
     so empty space never answers the pointer. */
  #sec-banner .banner-line > label {
    flex: 0 0 auto;
  }
  #announce-meta {
    margin: 0.75rem 0 0;
  }
  #announce-meta:empty {
    display: none;
  }
  /* Three words at most ("No end date") — no reason to span the
     column. The label is a grid, so auto width alone still stretches:
     park it to the start. */
  #f-duration {
    width: auto;
    max-width: 100%;
    justify-self: start;
  }
  /* The label itself hugs the dropdown too: a full-width label
     forwards hover to the select from anywhere in the row, so the
     control answers the pointer from empty space. */
  #sec-banner label:has(#f-duration) {
    width: fit-content;
  }
  /* Author display:inline-flex beats the UA [hidden] rule — re-hide the
     Remove button until a banner exists to remove. */
  #announce-clear[hidden] {
    display: none;
  }
  /* The live preview twins the homepage note — warm paper, tape
     strip, the site's own sans voice — so what she types is what
     buyers see. Empty means nothing showing, so the note stays out
     of the way. */
  #banner-preview {
    position: relative;
    max-width: 24rem;
    box-sizing: border-box;
    margin: 1.75rem 0 2rem;
    rotate: -0.8deg;
    border-radius: 2px;
    background: linear-gradient(180deg, #fffdf8, #fdf6e9);
    padding: 1.4rem 1.25rem 1.1rem;
    color: #23201b;
    font-size: 1.05rem;
    line-height: 1.6;
    box-shadow:
      0 1px 2px rgb(35 32 27 / 0.1),
      0 10px 24px -14px rgb(35 32 27 / 0.35);
  }
  #banner-preview::before {
    content: "";
    position: absolute;
    top: -0.75rem;
    left: 50%;
    width: 5.5rem;
    height: 1.5rem;
    translate: -50% 0;
    rotate: -2deg;
    background: linear-gradient(
      180deg,
      rgb(233 220 196 / 0.9),
      rgb(226 210 182 / 0.75)
    );
    box-shadow: 0 1px 2px rgb(35 32 27 / 0.14);
  }
  #banner-preview[hidden] {
    display: none;
  }
</style>
