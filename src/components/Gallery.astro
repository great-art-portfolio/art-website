---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const paintings = await getCollection("paintings");
const available = paintings.filter((p) => !p.data.sold);
const sold = paintings.filter((p) => p.data.sold);
const ordered = [...available, ...sold];
const NEW_MS = 21 * 24 * 60 * 60 * 1000;
const isNewStatic = (d: Date): boolean => Date.now() - d.getTime() < NEW_MS;
---

<p id="announce-bar" class="announce" hidden></p>

<div class="gallery" id="gallery-static">
  {
    ordered.map((painting) => (
      <a class="card" href={`/paintings/${painting.id}`} aria-label={painting.data.title}>
        <span class="thumb">
          <Image
            src={painting.data.image}
            alt={painting.data.alt}
            width={900}
            loading="lazy"
          />
          {painting.data.sold && <span class="badge sold">Sold</span>}
          {!painting.data.sold && isNewStatic(painting.data.dateAdded) && (
            <span class="badge new">New</span>
          )}
        </span>
      </a>
    ))
  }
</div>

<div class="gallery" id="gallery-new" hidden></div>

<script>
  // Paintings added from the phone (D1/R2) render here; static ones above.
  async function loadNew() {
    try {
      const res = await fetch("/api/settings");
      if (res.ok) {
        const text = ((await res.json()) as { announcement: string }).announcement.trim();
        if (text !== "") {
          const bar = document.getElementById("announce-bar");
          if (bar !== null) {
            bar.textContent = text;
            bar.hidden = false;
          }
        }
      }
    } catch {
      // Announcement is decoration — the gallery works without it.
    }
    let paintings: Array<{
      slug: string; title: string; price_cents: number;
      alt: string; image_url: string; status: string; created_at: string;
    }>;
    try {
      const res = await fetch("/api/paintings");
      if (!res.ok) return;
      paintings = ((await res.json()) as { paintings: typeof paintings }).paintings;
    } catch {
      return;
    }
    if (paintings.length === 0) return;
    const wrap = document.getElementById("gallery-new");
    if (wrap === null) return;
    wrap.hidden = false;
    const fresh = Date.now() - 21 * 24 * 60 * 60 * 1000;
    wrap.innerHTML = paintings
      .map(
        (p) => `<a class="card" href="/art?slug=${encodeURIComponent(p.slug)}" aria-label="${p.title.replace(/"/g, "&quot;")}">
          <span class="thumb">
            <img src="${encodeURI(p.image_url)}" alt="${p.alt.replace(/"/g, "&quot;")}" loading="lazy" />
            ${p.status === "sold" ? `<span class="badge sold">Sold</span>` : ""}
            ${p.status !== "sold" && Date.parse(p.created_at) > fresh ? `<span class="badge new">New</span>` : ""}
          </span>
        </a>`,
      )
      .join("");
  }
  void loadNew();
</script>

<style>
  .announce {
    max-width: 62rem; margin: 0 auto 1.25rem; padding: 0.7rem 1.25rem;
    text-align: center; font-size: 0.95rem;
    color: var(--ink); background: var(--card);
    border-block: 1px solid var(--line);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
    padding: 0 1.25rem 3rem;
    max-width: 64rem;
    margin: 0 auto;
  }
  @media (min-width: 60rem) {
    .gallery { grid-template-columns: repeat(2, 1fr); gap: 1.75rem; }
  }
  .card {
    display: block; border-radius: 0.35rem; overflow: hidden;
    background: var(--card); border: 1px solid var(--line);
    animation: rise 0.45s ease both;
    transition: box-shadow 0.25s ease;
  }
  .card:hover { box-shadow: 0 14px 34px -18px rgb(0 0 0 / 0.45); }
  .thumb { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; }
  .thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.5s ease;
  }
  .card:hover .thumb img { transform: scale(1.03); }
  .badge {
    position: absolute; top: 0.7rem; right: 0.7rem;
    padding: 0.28rem 0.7rem; border-radius: 999px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em;
    background: rgb(20 18 15 / 0.82); color: #fff;
  }
  .badge.sold { background: rgb(140 29 24 / 0.88); }
  .badge.new { background: rgb(46 110 94 / 0.88); }
  @keyframes rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
</style>
