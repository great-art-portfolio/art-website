---
import Layout from "../../layouts/Layout.astro";
import "../../components/studio.css";
import { SITE_URL } from "../../lib/site";
import { broadcastDefaults } from "../../../functions/_lib/notify";

// Subject and body start with the standard text. The sign-off and
// unsubscribe aren't editable. The template appends them to every send.
const defaults = broadcastDefaults(SITE_URL);
---

<Layout title="Admin - Email" wordmark="admin" noindex>
  <main class="admin" id="main">
    <section id="sec-list" class="prose">
      <h2>Your email list</h2>
      <p class="hint" id="list-summary" role="status">
        Loading your list…
      </p>
      <form id="list-add" class="row" novalidate>
        <label>
          Add someone
          <input
            type="email"
            id="list-add-email"
            autocomplete="off"
            placeholder="name@example.com"
          />
        </label>
        <button type="submit" id="list-add-send">
          Send them a confirm email
        </button>
      </form>
      <p class="hint">
        They join once they tap the link in that email. That tap is their yes,
        which Canada's anti-spam law asks for.
      </p>
      <p class="hint" id="list-status" role="status"></p>
      <label id="list-search-wrap" hidden>
        Find someone
        <input
          type="search"
          id="list-search"
          autocomplete="off"
          placeholder="Type part of an address"
        />
      </label>
      <ul id="list-people"></ul>
      <nav id="list-pager" aria-label="List pages" hidden>
        <button type="button" id="list-newer">
          ‹ Newer
        </button>
        <span id="list-range"></span>
        <button type="button" id="list-older">
          Older ›
        </button>
      </nav>
      <h3>What the free plan allows</h3>
      <p class="hint">
        You use
        <a href="https://resend.com" target="_blank" rel="noopener">
          Resend
        </a>
        to send emails. Its free plan allows:
      </p>
      <ul class="limits">
        <li>
          New-painting emails: as many as you like, to up to 1,000 people. Past
          1,000, sending pauses until someone is removed or the plan is upgraded
          ($20 a month).
        </li>
        <li>
          Everything else (buyer notes to you, sign-up confirmations): up to 100
          a day and 3,000 a month.
        </li>
      </ul>
    </section>
    <section id="sec-email" class="prose">
      <h2>Send email</h2>
      <p class="hint">
        Sends one email to the whole list. Blank fields send the standard note;
        the sign-off and unsubscribe stay on every send. Buyers see it dressed
        in the gallery style.
      </p>
      <label>
        Subject
        <input
          type="text"
          id="email-subject"
          maxlength="200"
          autocomplete="off"
          value={defaults.subject}
        />
      </label>
      <label>
        Body
        <textarea
          id="email-body"
          rows="6"
          maxlength="2000"
          autocomplete="off"
        >{defaults.body}</textarea>
      </label>
      <div id="email-preview" hidden>
        <p class="preview-subject">
          <span>Subject:</span>
          <strong id="email-preview-subject"></strong>
        </p>
        <iframe
          id="email-preview-body"
          title="How the email will look"
          sandbox=""
        ></iframe>
      </div>
      <p class="hint" id="email-preview-fallback" hidden>
        The preview didn't load — the button still sends the standard note.
      </p>
      <div class="row">
        <button type="button" id="email-send">
          Send email to subscribers 📧
        </button>
      </div>
      <p class="hint" id="email-status" role="status"></p>
    </section>
  </main>
</Layout>

<script src="../../components/AdminPanel.ts"></script>

<style>
  /* The list reads as lines of text: an address, when they joined, and a
     quiet Remove. Rows are script-built, so their rules are :global(). */
  #list-people {
    list-style: none;
    padding: 0;
    margin: 1rem 0 2rem;
    display: grid;
    gap: 0.35rem;
  }
  #list-people :global(li) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
  #list-people :global(.who) {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  #list-people :global(.when) {
    color: var(--muted);
    font-size: 0.88rem;
  }
  #list-people :global(li.off .who) {
    color: var(--muted);
    font-weight: 400;
  }
  #list-people :global(li[hidden]) {
    display: none;
  }
  #list-people :global(.list-remove) {
    margin-left: auto;
    min-height: 2.4rem;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
  }
  /* On a phone the address and its date stack, with Remove beside them. */
  @media (max-width: 40rem) {
    #list-people {
      gap: 0.9rem;
    }
    #list-people :global(li) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 0.75rem;
      align-items: center;
    }
    #list-people :global(.who) {
      grid-column: 1;
    }
    #list-people :global(.when) {
      grid-column: 1;
      grid-row: 2;
    }
    #list-people :global(.list-remove) {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin-left: 0;
    }
  }
  /* The button lines up with the field, not its label. */
  #list-add {
    align-items: end;
  }
  #list-status:empty {
    display: none;
  }
  #list-search-wrap[hidden],
  #list-pager[hidden] {
    display: none;
  }
  /* Newer and Older sit either side of where she is in the list. */
  #list-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: -1rem 0 2rem;
  }
  #list-range {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  #list-pager button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  #sec-list .limits {
    padding-left: 1.1rem;
    color: var(--muted);
  }
  #sec-list .limits li + li {
    margin-top: 0.4rem;
  }
  #sec-list + #sec-email {
    margin-top: 2.5rem;
  }
  /* Left-aligned flex row that wraps on narrow phones. The result line
     below stays hidden until there's a message. */
  #sec-email .row {
    margin-top: 1rem;
    justify-content: start;
  }
  #email-status {
    margin: 0.75rem 0 0;
  }
  #email-status:empty {
    display: none;
  }
  /* The preview is a card so it reads as the message rather than page
     text. The body is the real styled email in a sandboxed iframe. */
  #email-preview {
    margin-top: 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem 1.1rem;
  }
  #email-preview[hidden],
  #email-preview-fallback[hidden] {
    display: none;
  }
  #email-preview .preview-subject {
    margin: 0 0 0.6rem;
  }
  #email-preview .preview-subject span {
    opacity: 0.7;
    margin-right: 0.4rem;
  }
  #email-preview-body {
    display: block;
    width: 100%;
    height: 22rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
  }
</style>
