---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { SOLD_WIDTHS, soldSizes } from "../../lib/responsive-images";
import { SHOW_PRICES, slugifyTitle } from "../../lib/site";

const paintings = await getCollection("paintings");
const available = paintings.filter((p) => !p.data.sold);
const sold = paintings.filter((p) => p.data.sold);
const priceLabel = (price: number): string => `$${price.toFixed(2)} CAD`;
---

<Layout title="Studio collection — Admin" wordmark="admin">
  <main class="studio" id="main">
    <p class="crumbs"><a href="/admin">← Back to the studio</a></p>
    <p class="eyebrow">Artist studio</p>
    <h1>Collection</h1>
    <p class="hint">Tap a painting to open it — editing and deleting live on its page.</p>
    <p class="notice" id="studio-notice" hidden>
      This studio page needs your session — open <a href="/admin">/admin</a> first.
    </p>

    <div id="studio-grid">
      <h2>Available</h2>
      <div class="studio-grid">
        {
          available.map((painting) => (
            <a
              class="card"
              href={`/paintings/${slugifyTitle(painting.data.title)}`}
              data-astro-prefetch="hover"
            >
              <span class="mat">
                <Image
                  src={painting.data.image}
                  alt=""
                  width={700}
                  widths={SOLD_WIDTHS}
                  sizes={soldSizes()}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="caption">
                <span class="caption-title">{painting.data.title}</span>
                {SHOW_PRICES && <span class="price">{priceLabel(painting.data.price)}</span>}
              </span>
            </a>
          ))
        }
      </div>

      {sold.length > 0 && (
        <>
          <h2>Collected</h2>
          <div class="studio-grid">
            {sold.map((painting) => (
              <a
                class="card"
                href={`/paintings/${slugifyTitle(painting.data.title)}`}
                data-astro-prefetch="hover"
              >
                <span class="mat">
                  <Image
                    src={painting.data.image}
                    alt=""
                    width={700}
                    widths={SOLD_WIDTHS}
                    sizes={soldSizes()}
                    format="webp"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="badge sold">Sold</span>
                </span>
                <span class="caption">
                  <span class="caption-title">{painting.data.title}</span>
                </span>
              </a>
            ))}
          </div>
        </>
      )}
    </div>

    <div class="row">
      <button type="button" id="leave-admin">Leave admin</button>
    </div>
  </main>
</Layout>

<script>
  // Studio gate + way out. Plain script (no imports): the token lives in
  // local storage ("remember this browser") with a session fallback.
  // Access guards this route in production; this covers Access-off rooms.
  var grid = document.getElementById("studio-grid");
  var notice = document.getElementById("studio-notice");
  var token = "";
  try {
    token =
      window.localStorage.getItem("ADMIN_API_TOKEN") ||
      window.sessionStorage.getItem("ADMIN_API_TOKEN") ||
      "";
  } catch (err) {
    token = "";
  }
  if (token === "" && grid !== null && notice !== null) {
    grid.hidden = true;
    notice.hidden = false;
  }
  var leave = document.getElementById("leave-admin");
  if (leave !== null) {
    leave.addEventListener("click", function () {
      try {
        window.localStorage.removeItem("ADMIN_API_TOKEN");
        window.sessionStorage.removeItem("ADMIN_API_TOKEN");
      } catch (err) {
        // Storage blocked — navigating away still ends the visit.
      }
      window.location.href = "/";
    });
  }
</script>

<style>
  .studio { max-width: 76rem; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  .crumbs { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .crumbs a { color: var(--muted); }
  .eyebrow {
    margin: 0 0 0.6rem; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
  }
  .studio h1 {
    font-family: Georgia, "Iowan Old Style", Charter, serif; font-weight: 500;
    font-size: clamp(2rem, 5vw, 2.75rem); margin: 0 0 0.5rem;
  }
  .hint { color: var(--muted); margin: 0 0 1.5rem; }
  .notice {
    padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: 0.75rem;
    background: var(--card); margin: 0 0 1.5rem;
  }
  .notice[hidden] { display: none; }
  #studio-grid[hidden] { display: none; }
  #studio-grid h2 {
    font-family: Georgia, "Iowan Old Style", Charter, serif; font-weight: 500;
    font-size: 1.4rem; margin: 2rem 0 1rem;
  }
  .studio-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem;
  }
  @media (min-width: 60rem) {
    .studio-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .card { display: block; color: inherit; text-decoration: none; border-radius: var(--radius); }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .mat {
    position: relative; display: block;
    background: var(--card); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 0.6rem;
  }
  .mat img { width: 100%; height: auto; display: block; border-radius: 0.25rem; background: #eee; }
  .badge {
    position: absolute; top: 1rem; right: 1rem;
    padding: 0.3rem 0.8rem; border-radius: 999px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em;
    background: rgb(20 18 15 / 0.82); color: #fff;
  }
  .badge.sold { background: rgb(140 29 24 / 0.9); }
  .caption { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.75rem 0.25rem 0; }
  .caption-title { font-family: Georgia, serif; font-size: 1.05rem; }
  .price { font-weight: 700; color: var(--accent); font-size: 0.92rem; }
  .row { margin-top: 2.5rem; }
  .row button {
    font: inherit; font-weight: 600; cursor: pointer;
    padding: 0.65rem 1.4rem; border-radius: 0.6rem;
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
  }
  .row button:hover { border-color: var(--ink); }
  .row button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
