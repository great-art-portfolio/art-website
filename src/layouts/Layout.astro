---
import ClientRouter from "astro/components/ClientRouter.astro";
// Handwritten font for the pinned studio note. Self-hosted so it works
// offline and makes no third-party requests.
import "@fontsource/caveat/600.css";
// Fraunces (SIL OFL) for headings and painting titles. The optical-size
// axis gives display sizes their high-contrast cut; only the Latin files
// a page uses are downloaded.
import "@fontsource-variable/fraunces/opsz.css";
import Analytics from "../components/Analytics.astro";
import Signature from "../components/Signature.astro";
import AdminWordmark from "../components/AdminWordmark.astro";
import background from "../assets/background-warm.svg";
import backgroundCollection from "../assets/background-studio-collection.svg";
import backgroundBanner from "../assets/background-studio-banner.svg";
import backgroundMetrics from "../assets/background-studio-metrics.svg";
import backgroundGuide from "../assets/background-studio-guide.svg";
import {
  ARTIST_LOCATION,
  ARTIST_NAME,
  pageTitle,
  SITE_URL,
  siteTitle,
} from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string | undefined;
  /** "signature" on public pages, "admin" on studio pages. */
  wordmark?: "signature" | "admin";
  /** Set on studio previews so search engines don't index them. */
  noindex?: boolean;
  /** Canonical path for alias pages served under old slugs. */
  canonical?: string;
  /** Background wash for studio pages. Other pages use "warm". */
  backdrop?: "warm" | "collection" | "banner" | "metrics" | "guide";
}

const {
  title = siteTitle(),
  description = "Original nature and abstract paintings, direct from the artist's studio.",
  image = "/apple-touch-icon.png",
  wordmark = "signature",
  noindex = false,
  canonical: canonicalOverride,
  backdrop = "warm",
} = Astro.props;

// Each studio page gets its own wash, drawn with the same layer and opacity
// as the default.
const backdropSrc = (
  {
    warm: background,
    collection: backgroundCollection,
    banner: backgroundBanner,
    metrics: backgroundMetrics,
    guide: backgroundGuide,
  } as const
)[backdrop].src;

// Use the path only. The static build renders with a placeholder origin,
// so a full URL would be wrong on every real host.
// Pages build as name.html (astro.config), and the URL keeps the suffix.
const selfPath = Astro.url.pathname.replace(/(\/index)?\.html$|\/$/, "") || "/";
const canonical = canonicalOverride ?? selfPath;
const year = new Date().getFullYear();
const artistLabel = ARTIST_NAME ?? "The Studio";
// Maps a studio path to its header nav section. Painting rooms return null,
// so no section is marked current.
function adminSection(path: string): string | null {
  const clean = path.length > 1 ? path.replace(/\/$/, "") : path;
  if (clean === "/admin") return "collection";
  if (clean.startsWith("/admin/banner")) return "banner";
  if (clean.startsWith("/admin/ping")) return "ping";
  if (clean.startsWith("/admin/email")) return "email";
  if (clean.startsWith("/admin/metrics")) return "metrics";
  if (clean.startsWith("/admin/guide")) return "guide";
  if (clean.startsWith("/admin/qr-codes")) return "qr";
  return null;
}
const currentSection = adminSection(selfPath);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="theme-color"
      content="#faf7f1"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#171512"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(canonical, SITE_URL).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(canonical, SITE_URL).href} />
    <meta property="og:image" content={new URL(image, SITE_URL).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle(title, wordmark === "admin")}</title>
    <ClientRouter />
    <Analytics />
  </head>
  <body>
    <script>
      // Fade #main in on every page load and View Transitions swap. Under
      // reduced motion the browser skips view transitions entirely, and
      // this Web Animations fade still runs, so swaps stay smooth. Inline
      // scripts re-run on every swap, so wire this once.
      if (window.__pageFadeWired !== true) {
        window.__pageFadeWired = true;
        document.addEventListener("astro:after-swap", () => {
          const main = document.getElementById("main");
          if (main !== null && typeof main.animate === "function") {
            main.animate([{ opacity: 0 }, { opacity: 1 }], {
              duration: 220,
              easing: "ease",
            });
          }
        });
      }
    </script>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header
      class="site-header"
      data-scroll-bar={wordmark === "admin" ? undefined : ""}
    >
      <nav
        class:list={["site-nav", { studio: wordmark === "admin" }]}
        aria-label="Main"
      >
        <a
          href={wordmark === "admin" ? "/admin" : "/"}
          id="signature"
          aria-label={
            wordmark === "admin" ? "Admin home" : "Home — back to the gallery"
          }
        >
          {wordmark === "admin" ? <AdminWordmark /> : <Signature />}
        </a>
        <div class="nav-links">
          {wordmark === "admin" ? (
            <>
              {(
                [
                  ["collection", "/admin", "Collection"],
                  ["banner", "/admin/banner", "Banner"],
                  ["ping", "/admin/ping", "Ping"],
                  ["email", "/admin/email", "Email"],
                  ["metrics", "/admin/metrics", "Metrics"],
                  ["qr", "/admin/qr-codes", "QR codes"],
                  ["guide", "/admin/guide", "Guide"],
                ] as const
              ).map(([id, href, label]) => (
                <a
                  href={href}
                  class="sec keep"
                  aria-current={currentSection === id ? "page" : undefined}
                >
                  {label}
                </a>
              ))}
              <a
                href="/"
                class="keep"
                id="leave-admin"
                aria-label="Leave Admin"
              >
                <span aria-hidden="true" class="leave-full">
                  ← Leave Admin
                </span>
                <span aria-hidden="true" class="leave-short">
                  ←
                </span>
              </a>
              <a href="/admin/paintings/new" class="nav-cta">
                Add painting
              </a>
            </>
          ) : (
            <>
              <a href="/#collection">Collection</a>
              <a href="/#about">About</a>
              <button type="button" id="notify-nav" class="nav-cta">
                Notify me
              </button>
            </>
          )}
        </div>
      </nav>
    </header>
    {
      /* Studio toast, fixed under the header. It's hidden while empty;
         only studio pages fill it. */
      wordmark === "admin" && (
        <p id="admin-status" role="status" data-tone="ok" />
      )
    }

    <img
      id="background"
      src={backdropSrc}
      alt=""
      fetchpriority="high"
      aria-hidden="true"
      transition:persist={backdrop}
    />
    <slot />

    <footer class="site-footer">
      <p class="footer-mark">
        {artistLabel} · {ARTIST_LOCATION}
      </p>
      <p class="footer-sub">
        <a href="/privacy">Privacy</a> — no cookies, no trackers
        <button type="button" id="install-app" hidden>
          <span>Install the gallery app</span>
        </button>
      </p>
      <p class="footer-sub">
        © {year} {artistLabel}
      </p>
    </footer>

    {wordmark === "signature" && (
      <dialog
        id="notify-dialog"
        aria-labelledby="notify-dialog-title"
        closedby="closerequest"
      >
        <form method="dialog" class="notify-close-row">
          <button
            type="submit"
            id="notify-close"
            aria-label="Close notifications"
          >
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path
                d="M2 2l12 12M14 2L2 14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </form>
        <h2 id="notify-dialog-title">Never miss a new painting</h2>
        <p>
          Get an email when a new painting is hung or an event comes up.
          Unsubscribe any time with one click.
        </p>
        <form id="notify-email-form" class="email-capture">
          <label>
            Email address
            <input
              type="email"
              id="notify-email"
              name="email"
              required
              maxlength="254"
              autocomplete="email"
              placeholder="you@example.com"
            />
          </label>
          <div id="notify-turnstile-mount" />
          <button type="submit" class="btn-primary">
            Join the list <span aria-hidden="true">📬</span>
          </button>
          <div class="notify-more">
            <button type="button" id="notify-btn" class="text-btn" hidden>
              Or get alerts in this browser
            </button>
            <button type="button" id="notify-email-leave" class="text-btn">
              Leave the list
            </button>
          </div>
        </form>
        <div class="status-wrap" id="notify-status-wrap">
          <p class="hint" id="notify-status" role="status" />
        </div>
        <p class="toast" id="notify-toast" role="status" />
      </dialog>
    )}

    <script>
      // Service worker: caches the gallery shell and artwork, and queues
      // posts made offline.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            // Offline mode is unavailable. The site still works online.
          });
        });
      }
      // Install is opt-in. When the browser offers installation, a footer
      // button appears that opens the browser's install dialog.
      window.addEventListener("beforeinstallprompt", (e) => {
        e.preventDefault();
        window.__deferredInstall = e;
        const btnEl = document.getElementById("install-app");
        const btn = btnEl instanceof HTMLButtonElement ? btnEl : null;
        if (btn !== null) btn.hidden = false;
      });
      document.addEventListener("click", (e) => {
        const tEl =
          e.target instanceof Element ? e.target.closest("#install-app") : null;
        const t = tEl instanceof HTMLElement ? tEl : null;
        const ask = window.__deferredInstall;
        if (
          t === null ||
          ask === null ||
          ask === undefined ||
          !("prompt" in ask) ||
          typeof ask.prompt !== "function"
        )
          return;
        window.__deferredInstall = null;
        t.hidden = true;
        ask.prompt();
      });
    </script>
    <script>
      // Collector signup modal, opened by the nav "Notify me" and hero
      // buttons. Use dynamic import() only: this block ships as a classic
      // script, where a static `import` breaks it.
      // View Transitions keep this script alive across navigations, so
      // elements are looked up on each use. Wiring runs immediately and on
      // astro:page-load, guarded against wiring the same DOM twice.
      function notifyPush() {
        return import("../lib/push");
      }

      // Spam check, shared with the inquiry form via lib/turnstile-widget.
      // Tokens are single-use, so Join and Leave each take their own.
      function loadNotifyTurnstile() {
        void import("../lib/turnstile-widget").then(({ ensureTurnstile }) =>
          ensureTurnstile("#notify-turnstile-mount"),
        );
      }

      async function notifyToken() {
        const { takeTurnstileToken } = await import("../lib/turnstile-widget");
        return await takeTurnstileToken("#notify-turnstile-mount");
      }

      const NOTIFY_CHECK_MSG =
        "One more step — finish the quick check above, then try again.";

      // Shows a status message that fades in and later out. The fade is
      // opacity-only so reduced motion keeps it. A counter skips a stale
      // fade-out when a newer message arrives. Sticky messages stay until
      // replaced.
      function notifySay(el = document.body, msg = "", sticky = false) {
        const n = Number(el.dataset.say ?? "0") + 1;
        el.dataset.say = String(n);
        el.textContent = msg;
        const wrap =
          el instanceof HTMLElement ? el.closest(".status-wrap") : null;
        if (wrap !== null) wrap.classList.toggle("open", msg !== "");
        if (typeof el.animate === "function" && msg !== "") {
          // Delayed until the wrapper has unfolded.
          el.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: 200,
            delay: 100,
          });
        }
        if (!sticky && msg !== "") {
          window.setTimeout(() => {
            if (el.dataset.say === String(n)) notifyUnsay(el);
          }, 5000);
        }
      }
      function notifyUnsay(el = document.body) {
        const n = Number(el.dataset.say ?? "0") + 1;
        el.dataset.say = String(n);
        const wrap =
          el instanceof HTMLElement ? el.closest(".status-wrap") : null;
        if (wrap !== null) wrap.classList.remove("open");
        if (el.textContent === "" || typeof el.animate !== "function") {
          el.textContent = "";
          return;
        }
        const out = el.animate([{ opacity: 1 }, { opacity: 0 }], {
          duration: 150,
        });
        out.onfinish = () => {
          if (el.dataset.say === String(n)) el.textContent = "";
        };
      }

      function openNotify() {
        const dlgEl = document.getElementById("notify-dialog");
        const dlg = dlgEl instanceof HTMLDialogElement ? dlgEl : null;
        if (dlg === null) return;
        if (!dlg.open) {
          if (typeof dlg.showModal === "function") dlg.showModal();
          else dlg.setAttribute("open", "");
        }
        // Reset on each open so a push failure from earlier gets retried.
        pushDeadThisVisit = false;
        void paintNotify();
        // Render Turnstile on open, since it mismeasures inside a hidden
        // modal. Repeat calls do nothing.
        loadNotifyTurnstile();
        const closeEl = document.getElementById("notify-close");
        const closeBtn = closeEl instanceof HTMLButtonElement ? closeEl : null;
        if (closeBtn !== null) closeBtn.focus();
      }

      // Email signup works in every browser. It uses Cloudflare Turnstile
      // when configured, shared with the inquiry form.
      function wireNotifyEmail() {
        const formEl = document.getElementById("notify-email-form");
        const form = formEl instanceof HTMLFormElement ? formEl : null;
        const inputEl = document.getElementById("notify-email");
        const input = inputEl instanceof HTMLInputElement ? inputEl : null;
        const hint = document.getElementById("notify-status");
        if (form === null || input === null || hint === null) return;
        if (form.dataset.wired === "1") return;
        form.dataset.wired = "1";
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const email = input.value.trim();
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            notifySay(
              hint,
              "That email doesn't look right — check it and try again.",
            );
            input.focus();
            return;
          }
          notifySay(hint, "Joining…");
          notifyToken()
            .then((turnstileToken) =>
              fetch("/api/collectors", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email, turnstileToken }),
              }),
            )
            .then((res) => {
              if (res.ok) {
                res
                  .json()
                  .then((data) => {
                    const d =
                      data !== null && typeof data === "object" ? data : null;
                    if (
                      d !== null &&
                      "devConfirmUrl" in d &&
                      typeof d.devConfirmUrl === "string" &&
                      d.devConfirmUrl !== ""
                    ) {
                      // Dev mock list only. Show the confirm link so the
                      // loop can be finished locally. notifySay animates
                      // the wrapper in, then the text is replaced with the
                      // link. It's sticky so it doesn't fade before use.
                      notifySay(hint, "open the confirm page", true);
                      hint.textContent = "";
                      const go = document.createElement("a");
                      go.href = d.devConfirmUrl;
                      go.textContent = "open the confirm page";
                      go.addEventListener("click", (e) => {
                        e.stopPropagation();
                      });
                      hint.appendChild(go);
                    } else {
                      notifySay(
                        hint,
                        "Check your inbox — one tap confirms it.",
                      );
                    }
                  })
                  .catch(() => {
                    notifySay(hint, "Check your inbox — one tap confirms it.");
                  });
                input.value = "";
              } else if (res.status === 403) {
                notifySay(hint, NOTIFY_CHECK_MSG);
              } else if (res.status === 400) {
                notifySay(
                  hint,
                  "That email doesn't look right — check it and try again.",
                );
              } else {
                notifySay(hint, "That didn't work — try again in a bit.");
              }
            })
            .catch(() => {
              notifySay(hint, "That didn't work — try again in a bit.");
            });
        });
        // Leaving by typed address needs the spam check too (an emailed
        // link carries its own proof instead). The reply is the same
        // whether or not the address was on the list.
        const leaveEl = document.getElementById("notify-email-leave");
        const leave = leaveEl instanceof HTMLButtonElement ? leaveEl : null;
        if (leave !== null) {
          leave.addEventListener("click", () => {
            const email = input.value.trim();
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
              notifySay(hint, "Type the address first, then Leave the list.");
              input.focus();
              return;
            }
            notifySay(hint, "Leaving…");
            notifyToken()
              .then((turnstileToken) =>
                fetch("/api/collectors", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    action: "unsubscribe",
                    email,
                    turnstileToken,
                  }),
                }),
              )
              .then((res) => {
                if (res.ok) {
                  notifySay(hint, "Done — that address is off the list.");
                  input.value = "";
                } else if (res.status === 403) {
                  notifySay(hint, NOTIFY_CHECK_MSG);
                } else {
                  notifySay(hint, "That didn't work — try again in a bit.");
                }
              })
              .catch(() => {
                notifySay(hint, "That didn't work — try again in a bit.");
              });
          });
        }
      }

      // Opening the modal repaints while an earlier paint may still be
      // waiting on push state, so only the latest run writes. Browser
      // alerts are a quiet second line under the email form, offered only
      // where they can work: unsupported, blocked, or a push service that
      // failed this visit hides the line, and email covers everyone. A
      // reopen offers it again. data-push marks the paint as settled.
      let paintSeq = 0;
      let pushDeadThisVisit = false;
      async function paintNotify() {
        const btnEl = document.getElementById("notify-btn");
        const btn = btnEl instanceof HTMLButtonElement ? btnEl : null;
        const dlg = document.getElementById("notify-dialog");
        if (btn === null || dlg === null) return;
        wireNotifyEmail();
        const run = ++paintSeq;
        const s = await notifyPush().then((api) => api.pushState());
        if (run !== paintSeq) return;
        btn.hidden = s === "unsupported" || s === "denied" || pushDeadThisVisit;
        btn.textContent =
          s === "subscribed"
            ? "This browser alerts you · turn off"
            : "Or get alerts in this browser";
        dlg.dataset.push = s;
      }

      // Toast for the signup card, used for copy confirmations so they
      // don't overwrite the status line.
      let notifyToastTimer = 0;
      function notifyToast(msg = "") {
        const toastEl = document.getElementById("notify-toast");
        const toast = toastEl instanceof HTMLElement ? toastEl : null;
        if (toast === null) return;
        window.clearTimeout(notifyToastTimer);
        toast.textContent = msg;
        toast.classList.add("show");
        notifyToastTimer = window.setTimeout(() => {
          toast.classList.remove("show");
          toast.textContent = "";
        }, 2500);
      }
      // Copies the status line and confirms with a toast. The Clipboard API
      // needs a secure context. Without it, the text can still be selected.
      function copyNotifyStatus(hint = document.body) {
        const text = (hint.textContent ?? "").trim();
        if (text === "") return;
        if (
          typeof navigator.clipboard === "undefined" ||
          typeof navigator.clipboard.writeText !== "function"
        ) {
          notifyToast("Couldn't copy — select the text instead.");
          return;
        }
        navigator.clipboard.writeText(text).then(
          () => notifyToast("Copied."),
          () => notifyToast("Couldn't copy — select the text instead."),
        );
      }

      function initNotify() {
        const navEl = document.getElementById("notify-nav");
        const nav = navEl instanceof HTMLButtonElement ? navEl : null;
        if (nav !== null && nav.dataset.wired !== "1") {
          nav.dataset.wired = "1";
          nav.addEventListener("click", () => {
            openNotify();
          });
        }
        const heroEl = document.getElementById("notify-hero");
        const hero = heroEl instanceof HTMLButtonElement ? heroEl : null;
        if (hero !== null && hero.dataset.wired !== "1") {
          hero.dataset.wired = "1";
          hero.addEventListener("click", () => {
            openNotify();
          });
        }
        const dlgEl = document.getElementById("notify-dialog");
        const dlg = dlgEl instanceof HTMLDialogElement ? dlgEl : null;
        if (dlg !== null && dlg.dataset.wired !== "1") {
          dlg.dataset.wired = "1";
          // A backdrop tap closes the modal. A text selection dragged past
          // the card edge also fires a click on the dialog, so ignore clicks
          // while text is selected.
          dlg.addEventListener("click", (e) => {
            if (e.target !== dlg) return;
            const sel = window.getSelection();
            if (sel !== null && sel.toString() !== "") return;
            dlg.close();
          });
          // Selecting text by hand is fiddly in the card, so a tap copies it.
          const hintEl = document.getElementById("notify-status");
          const hint = hintEl instanceof HTMLElement ? hintEl : null;
          if (hint !== null && hint.dataset.copyWired !== "1") {
            hint.dataset.copyWired = "1";
            hint.title = "Tap to copy this message";
            hint.addEventListener("click", () => {
              copyNotifyStatus(hint);
            });
          }
          const btnEl = document.getElementById("notify-btn");
          const btn = btnEl instanceof HTMLButtonElement ? btnEl : null;
          if (btn !== null) {
            btn.addEventListener("click", () => {
              const hint = document.getElementById("notify-status");
              void notifyPush().then((api) =>
                api.pushState().then((state) => {
                  if (state === "subscribed") {
                    void api.unsubscribePush().then(() => void paintNotify());
                  } else {
                    // Sticky because the permission prompt can stay open
                    // past the normal fade. The result replaces it.
                    if (hint !== null)
                      notifySay(hint, "Waiting for your browser…", true);
                    // Repaint before reporting. The repaint clears the
                    // "Waiting…" line, and the result is written last.
                    void api.subscribePush().then(async (result) => {
                      if (result === "nopushservice") pushDeadThisVisit = true;
                      await paintNotify();
                      if (hint === null) return;
                      if (result === "nopushservice") {
                        notifySay(
                          hint,
                          "This browser can't do alerts — email works everywhere.",
                        );
                      } else if (result === "subscribed") {
                        notifySay(
                          hint,
                          "You're on the list — this browser will alert you.",
                        );
                      } else if (result === "cancelled") {
                        notifySay(hint, "Request cancelled.");
                      } else if (result === "blocked") {
                        notifySay(
                          hint,
                          "Your browser blocked alerts — email works everywhere.",
                        );
                      } else if (result === "unavailable") {
                        notifySay(
                          hint,
                          "Browser alerts need the live site — this preview can't register this browser.",
                        );
                      } else {
                        notifySay(
                          hint,
                          "That didn't work — push alerts aren't set up on the server yet.",
                        );
                      }
                    });
                  }
                }),
              );
            });
          }
        }
        // Paint now so the box opens settled. The push module is small;
        // Cloudflare's spam check waits for the box to open.
        if (dlg !== null) void paintNotify();
      }

      initNotify();
      if (window.__notifyWired !== true) {
        window.__notifyWired = true;
        document.addEventListener("astro:page-load", initNotify);
      }

      // Public pages: the header is clear at the top of the page and the
      // translucent bar fills in with the scroll itself over the first
      // 80px (--bar goes 0 to 1), so it moves as fast as the page does.
      // The header is replaced on every navigation, so look it up on each
      // call.
      function syncScrollBar() {
        const header = document.querySelector(".site-header[data-scroll-bar]");
        if (!(header instanceof HTMLElement)) return;
        const bar = Math.min(Math.max(window.scrollY / 80, 0), 1);
        header.style.setProperty("--bar", bar.toFixed(3));
        header.toggleAttribute("data-scrolled", bar > 0);
      }
      let scrollBarQueued = false;
      function queueScrollBar() {
        if (scrollBarQueued) return;
        scrollBarQueued = true;
        window.requestAnimationFrame(() => {
          scrollBarQueued = false;
          syncScrollBar();
        });
      }
      syncScrollBar();
