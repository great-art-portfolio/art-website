# HSTS: browsers treat barbart.ca as HTTPS-only for a year, which closes
# downgrade attacks. No includeSubDomains, so it applies to this host only.
/*
  Strict-Transport-Security: max-age=31536000
  # No other site may show these pages inside a frame (clickjacking on Buy
  # now and the inquiry form). The studio's own email preview is same-site.
  # No plugins, and no <base> tag can point the page's links elsewhere.
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'
  X-Frame-Options: SAMEORIGIN
  # Files are only ever what their type says (an uploaded file can't be
  # read as a script).
  X-Content-Type-Options: nosniff
  # Nothing here uses the camera API, microphone, location or payments in
  # the page (Stripe checkout is its own site).
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin

# Studio pages stay out of search results even if a public crawler hits one.
/admin
  X-Robots-Tag: noindex

/admin/*
  X-Robots-Tag: noindex

# Confirm and unsubscribe links carry single-use tokens in the URL query;
# never forward those query strings to other origins.
/email/*
  Referrer-Policy: no-referrer

/:locale/email/*
  Referrer-Policy: no-referrer

# Build output under /_astro has a content hash in every name, so a file
# never changes: browsers keep it a year instead of rechecking every 4 hours.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Wall-preview models keep their name when a size changes, so they're
# rechecked hourly rather than kept for a year.
/models/*
  Cache-Control: public, max-age=3600

# The vendored 3D viewer changes only with a site update.
/js/*
  Cache-Control: public, max-age=86400
