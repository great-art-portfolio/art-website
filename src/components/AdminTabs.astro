---
/**
 * Studio tab bar, shared by every /admin page: Collection, Banner,
 * Views, Guide. Also carries the toast line — one per page, so news
 * finds her wherever she is scrolled.
 */
interface Props {
  current: "collection" | "banner" | "views" | "guide";
}
const { current } = Astro.props;
const tabs = [
  { id: "collection", href: "/admin", label: "Collection" },
  { id: "banner", href: "/admin/banner", label: "Banner" },
  { id: "views", href: "/admin/views", label: "Views" },
  { id: "guide", href: "/admin/guide", label: "Guide" },
] as const;
---

<p id="admin-status" role="status" data-tone="ok"></p>
<nav class="admin-tabs" aria-label="Studio sections">
  {
    tabs.map((t) => (
      <a
        href={t.href}
        aria-current={t.id === current ? "page" : undefined}
        class:list={[{ active: t.id === current }]}
      >
        {t.label}
      </a>
    ))
  }
</nav>

<style>
  /* Toast fixed to the viewport, under the sticky header: news finds
     her wherever she is scrolled. Empty (no message) means gone
     entirely. */
  #admin-status {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    top: max(5rem, env(safe-area-inset-top, 1rem));
    width: min(36rem, calc(100% - 2rem));
    z-index: 40;
    margin: 0;
    padding: 0.8rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    /* Inverted and fully solid: it floats over busy page content, so a
       card-colored pill lets the page bleed through behind the words. */
    background: var(--ink);
    color: var(--paper);
    font-size: 0.95rem;
    box-shadow: var(--shadow);
  }
  /* Opacity-only, both directions: a fade-in on every new message
     (re-triggered from the panel) and a fade-out on its way away.
     No travel — so it runs under every motion setting. */
  #admin-status.toast-in {
    animation: toast-in 0.25s ease;
  }
  @keyframes toast-in {
    from {
      opacity: 0;
    }
  }
  #admin-status.toast-out {
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  #admin-status[data-tone="error"] {
    border-color: var(--danger);
  }
  /* The status line starts empty (no blurb) and only appears once the
     studio has something to say. */
  #admin-status:empty {
    display: none;
  }
  /* Section tabs: quiet pills, the open page filled. One row that wraps
     instead of scrolling sideways on a phone. */
  .admin-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
  }
  .admin-tabs a {
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .admin-tabs a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .admin-tabs a.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .admin-tabs a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
