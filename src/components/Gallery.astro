---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import { formatDimensions } from "../lib/dims";
import {
  GALLERY_WIDTHS,
  SOLD_WIDTHS,
  gallerySizes,
  soldSizes,
} from "../lib/responsive-images";
import {
  SHOW_PRICES,
  compareGalleryOrder,
  isPublished,
  slugifyTitle,
  workCount,
} from "../lib/site";

type Painting = CollectionEntry<"paintings">;
const dimsOf = (p: Painting): string =>
  formatDimensions(
    p.data.widthIn ?? null,
    p.data.heightIn ?? null,
    p.data.depthIn ?? null,
  );

const paintings = (await getCollection("paintings")).filter((p) =>
  isPublished(p.data),
);
// Homepage follows the /admin drag order (frontmatter `order:`);
// unordered works trail alphabetically.
const available = paintings
  .filter((p) => !p.data.sold)
  .sort((a, b) =>
    compareGalleryOrder(
      { order: a.data.order ?? null, title: a.data.title },
      { order: b.data.order ?? null, title: b.data.title },
    ),
  );
// Sold follows the same /admin drag order as Available (frontmatter
// `order:`); unordered works trail alphabetically.
const sold = paintings
  .filter((p) => p.data.sold)
  .sort((a, b) =>
    compareGalleryOrder(
      { order: a.data.order ?? null, title: a.data.title },
      { order: b.data.order ?? null, title: b.data.title },
    ),
  );

const NEW_MS = 7 * 24 * 60 * 60 * 1000;
const isNewStatic = (d: Date): boolean => Date.now() - d.getTime() < NEW_MS;

const priceLabel = (price: number): string => `$${price.toFixed(2)} CAD`;
---

<section class="collection" id="collection" aria-label="Available paintings">
  <div class="section-head">
    <div>
      <p class="eyebrow">The collection</p>
      <h2>Available works</h2>
    </div>
    <p class="count">{workCount(available.length)} · each one of a kind</p>
  </div>

  <div class="gallery" id="gallery-static">
    {
      available.map((painting, i) => (
        <a
          class="card"
          href={`/paintings/${slugifyTitle(painting.data.title)}`}
          data-astro-prefetch="hover"
        >
          <span class="mat">
            <Image
              src={painting.data.image}
              alt={painting.data.alt}
              width={1000}
              widths={GALLERY_WIDTHS}
              sizes={gallerySizes()}
              format="webp"
              decoding="async"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
            />
            {isNewStatic(painting.data.dateAdded) && (
              <span class="badge new">New</span>
            )}
          </span>
          <span class="caption">
            <span class="caption-title">{painting.data.title}</span>
            <span class="caption-sub">
              {SHOW_PRICES ? (
                <span class="price">{priceLabel(painting.data.price)}</span>
              ) : (
                <span class="ask">Ask about this piece →</span>
              )}
              {dimsOf(painting) !== "" && (
                <span class="dims">{dimsOf(painting)}</span>
              )}
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>

{
  sold.length > 0 && (
    <section class="collection collected" id="sold" aria-label="Sold paintings">
      <div class="section-head">
        <div>
          <p class="eyebrow">Collected</p>
          <h2>Found their homes</h2>
        </div>
        <p class="count">{workCount(sold.length)} sold</p>
      </div>
      <div class="gallery sold-grid">
        {sold.map((painting) => (
          <a
            class="card"
            href={`/paintings/${slugifyTitle(painting.data.title)}`}
            data-astro-prefetch="hover"
          >
            <span class="mat">
              <Image
                src={painting.data.image}
                alt={painting.data.alt}
                width={700}
                widths={SOLD_WIDTHS}
                loading="lazy"
                sizes={soldSizes()}
                format="webp"
                decoding="async"
              />
              <span class="badge sold">Sold</span>
            </span>
            <span class="caption">
              <span class="caption-title">{painting.data.title}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .collection {
    max-width: 76rem;
    margin: 0 auto;
    padding: 1rem 1.5rem 2rem;
    scroll-margin-top: 5rem;
  }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0 0 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .section-head > div {
    min-width: 0;
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
  .section-head h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 500;
    text-wrap: balance;
  }
  .count {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .gallery {
    display: grid;
    gap: 3rem 2.5rem;
    align-items: start;
  }
  #gallery-static {
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    #gallery-static {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5rem 2.5rem;
    }
  }
  /* Desktop: repeating editorial rhythm on a 12-column grid. Each
     10-card cycle tiles exactly (7+5, 4+4+4, 5+7, 4+4+4), alternating a
     feature-left pair, a trio with the middle pushed down, a mirrored
     feature-right pair, and a trio with the edges pushed down. */
  @media (min-width: 60rem) {
    #gallery-static {
      grid-template-columns: repeat(12, 1fr);
    }
    #gallery-static > .card:nth-child(10n + 1) {
      grid-column: span 7;
    }
    #gallery-static > .card:nth-child(10n + 2) {
      grid-column: span 5;
      margin-top: 5rem;
    }
    #gallery-static > .card:nth-child(10n + 3),
    #gallery-static > .card:nth-child(10n + 5),
    #gallery-static > .card:nth-child(10n + 9) {
      grid-column: span 4;
    }
    #gallery-static > .card:nth-child(10n + 4) {
      grid-column: span 4;
      margin-top: 2.5rem;
    }
    #gallery-static > .card:nth-child(10n + 6) {
      grid-column: span 5;
      margin-top: 5rem;
    }
    #gallery-static > .card:nth-child(10n + 7) {
      grid-column: span 7;
    }
    #gallery-static > .card:nth-child(10n + 8),
    #gallery-static > .card:nth-child(10n + 10) {
      grid-column: span 4;
      margin-top: 2.5rem;
    }
  }

  .card {
    display: block;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius);
    animation: rise 0.5s ease both;
  }
  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .card:nth-child(2) {
    animation-delay: 0.06s;
  }
  .card:nth-child(3) {
    animation-delay: 0.12s;
  }
  .card:nth-child(n + 4) {
    animation-delay: 0.18s;
  }
  .mat {
    position: relative;
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(0.6rem, 1.5vw, 0.9rem);
    box-shadow: var(--shadow);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }
  @media (hover: hover) {
    .card:hover .mat {
      transform: translateY(-4px);
    }
  }
  .mat img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.25rem;
    background: #eee;
    /* Future extreme portraits: cap height instead of letting one tall
       card stretch its row. object-fit keeps the art undistorted. */
    max-height: 80vh;
    object-fit: contain;
  }
  .caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.9rem 0.25rem 0;
  }
  .caption-title {
    font-family: Georgia, serif;
    font-size: 1.2rem;
    text-decoration: underline transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.12s ease;
  }
  .card:hover .caption-title {
    text-decoration-color: currentColor;
  }
  /* Reduced motion kills the rise-and-lift; the caption underline fade
     still transitions. Lives after the hover rules so it wins ties. */
  @media (prefers-reduced-motion: reduce) {
    .card {
      animation: none;
    }
    .card:hover .mat {
      transform: none;
    }
  }
  .caption-sub {
    font-size: 0.95rem;
  }
  .price {
    font-weight: 700;
    color: var(--accent);
  }
  .ask {
    color: var(--accent);
    font-weight: 600;
  }
  .caption-sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }
  .dims {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
  .badge {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: rgb(20 18 15 / 0.82);
    color: #fff;
  }
  .badge.sold {
    background: rgb(140 29 24 / 0.9);
  }
  .badge.new {
    background: rgb(46 110 94 / 0.9);
  }

  /* Sold archive: smaller, quieter, uniform. */
  .collected {
    margin-top: 1rem;
  }
  .sold-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 2rem;
  }
  @media (min-width: 60rem) {
    .sold-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .sold-grid .mat {
    box-shadow: none;
  }
  .sold-grid img {
    filter: saturate(0.88);
  }
  .sold-grid .caption-title {
    font-size: 1.02rem;
  }

  /* Opacity-only entrance: the taste filter flags slide-up-on-scroll as
     AI-slop, and even on load a rise reads busier than a quiet fade. */
  @keyframes rise {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
