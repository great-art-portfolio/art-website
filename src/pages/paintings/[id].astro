---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDimensions } from "../../lib/dims";
import { PHOTO_WIDTHS, photoSizes } from "../../lib/responsive-images";
import { SHOW_PRICES, slugifyTitle } from "../../lib/site";

export async function getStaticPaths() {
  const paintings = await getCollection("paintings");
  return paintings.map((painting) => ({
    params: { id: slugifyTitle(painting.data.title) },
    props: { painting },
  }));
}

const { painting } = Astro.props;
const { Content } = await render(painting);
const price = `$${painting.data.price.toFixed(2)} CAD`;
const dims = formatDimensions(
  painting.data.widthIn ?? null,
  painting.data.heightIn ?? null,
  painting.data.depthIn ?? null,
);
const meta = [painting.data.medium, dims].filter((s) => s !== undefined && s !== "").join(" · ");
const paintingJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: painting.data.title,
  image: Astro.url.href,
  description: painting.data.alt,
  offers: {
    "@type": "Offer",
    priceCurrency: "CAD",
    price: painting.data.price.toFixed(2),
    availability: painting.data.sold
      ? "https://schema.org/SoldOut"
      : "https://schema.org/InStock",
  },
};
---

<Layout
  title={`${painting.data.title} — ${painting.data.sold ? "Sold" : "Original Painting"}`}
  description={painting.data.alt}
>
  <main
    class="detail"
    id="main"
    data-title={painting.data.title}
    data-price-cents={Math.round(painting.data.price * 100)}
    data-glb={painting.data.modelGlb ?? ""}
    data-usdz={painting.data.modelUsdz ?? ""}
    data-alt={painting.data.alt}
    data-md-path={`src/content/paintings/${painting.id.endsWith(".md") ? painting.id : `${painting.id}.md`}`}
  >
    <p class="crumbs"><a href="/">← Back to the collection</a></p>
    <div id="admin-bar" hidden>
      <span>Admin mode</span>
      <button type="button" id="admin-edit-toggle">Edit this painting</button>
      <a href="/admin#sec-collection">Studio</a>
    </div>
    <div id="admin-edit" hidden></div>
    <div class="detail-grid">
      <div class="frame" id="photo-wrap" title="Tap to view fullscreen">
        <Image
          src={painting.data.image}
          alt={painting.data.alt}
          width={1200}
          widths={PHOTO_WIDTHS}
          sizes={photoSizes()}
          format="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        {painting.data.sold && <span class="badge sold">Sold</span>}
      </div>
      <div id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Painting fullscreen view"><img id="lightbox-img" alt="" /></div>
      <div class="info">
        <p class="eyebrow">Original painting · one of a kind</p>
        <h1>{painting.data.title}</h1>
        {
          painting.data.sold ? (
            <p class="sold-note">This piece has found a home.</p>
          ) : SHOW_PRICES ? (
            <p class="price">{price}</p>
          ) : (
            <p class="price-note">Price on request — send a note below and the artist will reply.</p>
          )
        }
        {meta !== "" && <p class="art-meta">{meta}</p>}
        <div class="desc">
          <Content />
        </div>
        {
          !painting.data.sold && (
            <>
              <button type="button" id="inquiry-reveal" class="btn-primary" hidden>Interested?</button>
              <form id="inquiry-form">
                <h2>Ask about this painting</h2>
                <p class="ship-note">Shipping arranged with the artist after purchase.</p>
                <label>Name <input name="name" type="text" required autocomplete="name" /></label>
                <label>Email <input name="email" type="email" required autocomplete="email" /></label>
                <label>Message <textarea name="message" rows="3" placeholder="Hi, I love this piece…" /></label>
                <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
                <div id="turnstile-mount"></div>
                <button type="submit" class="btn-primary">Send inquiry</button>
                <p id="inquiry-status" role="status"></p>
              </form>
            </>
          )
        }
        {
          !painting.data.sold && (painting.data.modelGlb ?? "") !== "" && (
            <div id="ar-mount">
              <h2>Try it on your wall</h2>
              <p class="hint">True size — on your phone, point it at the wall where it would hang.</p>
              <div id="ar-stage"><div class="ar-skeleton" aria-hidden="true"></div></div>
            </div>
          )
        }
      </div>
    </div>
  </main>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(paintingJsonLd)} />
</Layout>

<script>
  // NOTE: no define:vars on this block — with it, Astro emits the script
  // raw (dynamic imports stay relative URLs and 404). Page data comes
  // from #main data-* attributes instead, and Vite bundles this properly.
  // View Transitions keep this module alive across gallery → painting
  // navigations (it runs once per document, not once per page), so page
  // data must be read live from #main on every use — eval-time consts go
  // stale and the next painting inherits the previous one's 3D model,
  // inquiry title, and edit path.
  function readPageData() {
    const pageData = document.getElementById("main").dataset;
    return {
      title: pageData.title ?? "",
      priceCents: Number(pageData.priceCents ?? "0"),
      glb: pageData.glb ?? "",
      usdz: pageData.usdz ?? "",
      alt: pageData.alt ?? "",
      mdPath: pageData.mdPath ?? "",
    };
  }
  let turnstileToken = "";

  /** Invisible-ish spam check, loaded only if the site key is configured. */
  function loadTurnstile() {
    if (document.getElementById("turnstile-script") !== null) return;
    fetch("/api/status")
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (data === null || data.turnstileSiteKey === "") return;
        if (document.getElementById("turnstile-script") !== null) return;
        const script = document.createElement("script");
        script.id = "turnstile-script";
        script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        script.async = true;
        script.defer = true;
        script.onload = () => {
          const tApi = window.turnstile;
          if (tApi === undefined) return;
          tApi.render("#turnstile-mount", {
            sitekey: data.turnstileSiteKey,
            callback: (t) => {
              turnstileToken = t;
            },
          });
        };
        document.head.appendChild(script);
      })
      .catch(() => {
        // Spam check unavailable — the honeypot still guards the form.
      });
  }

  /** "View on your wall" AR viewer (only rendered when models exist). */
  function initAr() {
    const mount = document.getElementById("ar-mount");
    if (mount === null) return;
    const { glb, usdz, alt, title } = readPageData();
    if (glb === "" || mount.dataset.wiredSrc === glb) return;
    mount.dataset.wiredSrc = glb;
    const stage = document.getElementById("ar-stage");
    if (stage === null) return;
    // Instant static preview from the photo already on screen — zero extra
    // bytes. The viewer library (~1.5MB with its decoders) and the model
    // only download once this section scrolls into view.
    const photo = document.querySelector("#photo-wrap img");
    const poster =
      photo instanceof HTMLImageElement
        ? photo.currentSrc === ""
          ? photo.src
          : photo.currentSrc
        : "";
    if (poster !== "") {
      const img = document.createElement("img");
      img.src = poster;
      img.alt = "";
      img.loading = "lazy";
      img.decoding = "async";
      img.style.width = "100%";
      img.style.height = "20rem";
      img.style.objectFit = "contain";
      img.style.borderRadius = "1rem";
      stage.replaceChildren(img);
    }
    const build = () => {
      // Script tag, not import(): Vite dev won't serve /public files as
      // modules. See src/lib/vendor-loader.ts.
      void import("../../lib/vendor-loader")
        .then(({ loadModelViewer }) => loadModelViewer())
        .then(() => {
          if (!document.contains(mount)) return;
          const liveStage = document.getElementById("ar-stage");
          if (liveStage === null) return;
          const el = document.createElement("model-viewer");
          el.setAttribute("src", glb);
          if (usdz !== "") el.setAttribute("ios-src", usdz);
          if (poster !== "") el.setAttribute("poster", poster);
          el.setAttribute("loading", "lazy");
          el.setAttribute("ar", "");
          el.setAttribute("ar-modes", "webxr scene-viewer quick-look");
          el.setAttribute("ar-scale", "fixed");
          el.setAttribute("ar-placement", "wall");
          el.setAttribute("camera-controls", "");
          el.setAttribute("alt", alt === "" ? title : alt);
          el.style.width = "100%";
          el.style.height = "20rem";
          el.style.borderRadius = "1rem";
          liveStage.replaceChildren(el);
        })
        .catch(() => {
          mount.hidden = true;
        });
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries, obs) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          obs.disconnect();
          build();
        }
      });
      io.observe(mount);
    } else {
      build();
    }
  }

  // Page scripts only run on full loads — but this layout uses View Transitions,
  // so gallery → painting navigations never re-run them. Everything is wired in
  // initDetail(), called immediately AND on astro:page-load. Guards keep a
  // double-fire on the same DOM from wiring anything twice.
  /** Admin mode: token set in /admin Settings reveals an edit toolbar
      so paintings are edited in context while browsing. */
  function initAdmin() {
    const bar = document.getElementById("admin-bar");
    if (bar === null || bar.dataset.wired === "1") return;
    let token = null;
    try {
      // Remembered per browser (local storage) with a session fallback —
      // mirrors getApiToken() in src/lib/api.ts.
      token =
        localStorage.getItem("ADMIN_API_TOKEN") ??
        sessionStorage.getItem("ADMIN_API_TOKEN");
    } catch {
      return;
    }
    if (token === null || token === "") return;
    bar.dataset.wired = "1";
    bar.hidden = false;
    const toggle = document.getElementById("admin-edit-toggle");
    const panel = document.getElementById("admin-edit");
    if (toggle === null || panel === null) return;
    toggle.addEventListener("click", () => {
      if (!panel.hidden) {
        panel.hidden = true;
        toggle.textContent = "Edit this painting";
        return;
      }
      toggle.textContent = "Close";
      toggle.disabled = true;
      const liveMdPath = readPageData().mdPath;
      Promise.all([import("../../lib/api"), import("../../lib/painting-edit")])
        .then(([apiMod, editMod]) =>
          apiMod.api.getPaintingFile(liveMdPath).then((content) => {
            toggle.disabled = false;
            if (content === null) {
              panel.innerHTML = "<p>Couldn't load this painting's file.</p>";
              panel.hidden = false;
              return;
            }
            const p = editMod.parsePainting(content);
            if (p === null) {
              panel.innerHTML = "<p>Couldn't read this painting's file.</p>";
              panel.hidden = false;
              return;
            }
            renderAdminEdit(apiMod.api, editMod, panel, toggle, liveMdPath, content, p);
          }),
        )
        .catch(() => {
          toggle.disabled = false;
          panel.innerHTML = "<p>Editing needs the live site — this is a preview.</p>";
          panel.hidden = false;
        });
    });
  }

  function escHtml(s) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
  }

  function renderAdminEdit(api, editMod, panel, toggle, path, content, p) {
    panel.innerHTML =
      `<label>Title <input id="ae-title" type="text" maxlength="120" value="${escHtml(p.title)}" /></label>` +
      `<label>Price (CAD) <input id="ae-price" type="number" min="1" step="0.01" inputmode="decimal" value="${escHtml(p.price)}" /></label>` +
      `<label>Alt text <input id="ae-alt" type="text" maxlength="200" value="${escHtml(p.alt)}" /></label>` +
      `<label>Description <textarea id="ae-desc" rows="3" maxlength="2000">${escHtml(p.description)}</textarea></label>` +
      `<div class="ae-row">` +
      `<label>W (in) <input id="ae-w" type="number" min="1" step="0.5" inputmode="decimal" value="${escHtml(p.widthIn)}" /></label>` +
      `<label>H (in) <input id="ae-h" type="number" min="1" step="0.5" inputmode="decimal" value="${escHtml(p.heightIn)}" /></label>` +
      `<label>D (in) <input id="ae-d" type="number" min="0.5" step="0.5" inputmode="decimal" value="${escHtml(p.depthIn)}" /></label>` +
      `</div>` +
      `<label class="ae-check"><input id="ae-sold" type="checkbox"${p.sold ? " checked" : ""} /> Sold</label>` +
      `<div class="ae-row"><button type="button" id="ae-save" class="btn-primary">Save</button> ` +
      `<button type="button" id="ae-del">Delete…</button> ` +
      `<span id="ae-status" role="status"></span></div>`;
    panel.hidden = false;
    const val = (id) => document.getElementById(id).value.trim();
    document.getElementById("ae-save").addEventListener("click", () => {
      const title = val("ae-title");
      const price = Number(val("ae-price"));
      const status = document.getElementById("ae-status");
      if (title === "" || !(Number.isFinite(price) && price > 0)) {
        status.textContent = "Title and a valid price are required.";
        return;
      }
      status.textContent = "Saving… (live in a few minutes)";
      const baseEdits = {
        title,
        price: price.toFixed(2),
        alt: val("ae-alt"),
        description: document.getElementById("ae-desc").value,
        widthIn: val("ae-w"),
        heightIn: val("ae-h"),
        depthIn: val("ae-d"),
        sold: document.getElementById("ae-sold").checked,
      };
      // Dimension fixes (or a missing preview) rebuild the AR models
      // from the repo photo in the same commit.
      void import("../../lib/vendor-loader")
        .then(({ loadArTooling }) => loadArTooling())
        .then((arMod) =>
          arMod.rebuildForDimFix(api.getPhoto, path, p, baseEdits, () => {
            status.textContent = "Rebuilding AR preview… (true size, takes a few seconds)";
          }),
        )
        .then((fix) => {
          const next = editMod.patchPainting(content, fix.edits);
          return api
            .commitFiles(`Edit painting: ${title}`, [{ path, blob: next }, ...fix.files])
            .then(() => {
              status.textContent =
                fix.note === null ? "Saved." : `Saved — but ${fix.note}`;
            });
        })
        .catch((err) => {
          status.textContent = err instanceof Error ? err.message : "Save failed.";
        });
    });
    document.getElementById("ae-del").addEventListener("click", (e) => {
      const btn = e.currentTarget;
      const status = document.getElementById("ae-status");
      if (!(btn instanceof HTMLButtonElement) || status === null) return;
      if (btn.dataset.armed !== "1") {
        btn.dataset.armed = "1";
        btn.textContent = "Tap again to delete";
        status.textContent = `This removes "${p.title}" from the site. Tap again to confirm.`;
        return;
      }
      btn.disabled = true;
      status.textContent = `Deleting "${p.title}"… (gone in a few minutes)`;
      const livePath = readPageData().mdPath;
      void import("../../lib/painting-edit")
        .then((editMod) =>
          api.deleteFiles(`Delete painting: ${p.title}`, editMod.paintingFilePaths(livePath, p)),
        )
        .then(() => {
          status.textContent = `Deleted "${p.title}" — recoverable from repo history.`;
        })
        .catch((err) => {
          btn.disabled = false;
          btn.dataset.armed = "";
          btn.textContent = "Delete…";
          status.textContent = err instanceof Error ? err.message : "Delete failed.";
        });
    });
  }

  function initDetail() {
    initAr();
    initAdmin();
    // Browsers without Background Sync (iPhones) never replay the outbox
    // on their own — flush on reconnect and page load instead.
    void import("../../lib/queue").then(({ armOutboxFlush }) => armOutboxFlush());
    // Inquiries go straight to the artist's email — nothing is stored.
    // Spam: honeypot first, Cloudflare Turnstile when configured.
    const form = document.getElementById("inquiry-form");
    if (form !== null && form.dataset.wired !== "1") {
      form.dataset.wired = "1";
      loadTurnstile();
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        if ((data.get("website") ?? "") !== "") return; // honeypot
        const status = document.getElementById("inquiry-status");
        status.textContent = "Sending…";
        const live = readPageData();
        void import("../../lib/queue").then(({ queuePost }) =>
          queuePost("/api/inquiries", {
            paintingTitle: live.title,
            priceCents: live.priceCents,
            name: String(data.get("name") ?? ""),
            email: String(data.get("email") ?? ""),
            message: String(data.get("message") ?? ""),
            website: "",
            turnstileToken,
          }).then((result) => {
            status.textContent =
              result === "sent"
                ? "Thanks! The artist will reply by email."
                : result === "queued"
                  ? "Saved — it will send automatically when you're back online."
                  : "That didn't go through — check your email address and try again.";
            if (result === "sent") form.reset();
          }),
        );
      });
    }

    // "Interested?" reveals the form (shown openly without JS).
    const reveal = document.getElementById("inquiry-reveal");
    if (reveal !== null && form !== null && reveal.dataset.wired !== "1") {
      reveal.dataset.wired = "1";
      form.hidden = true;
      reveal.hidden = false;
      reveal.addEventListener("click", () => {
        form.hidden = false;
        form.classList.add("revealed");
        reveal.hidden = true;
        const name = form.querySelector('input[name="name"]');
        if (name !== null) name.focus();
      });
    }

    // Tap photo → fullscreen overlay. Document-level listeners are registered
    // once per browser session — the elements they act on are re-queried live.
    if (window.__detailDocWired !== true) {
      window.__detailDocWired = true;
      const close = () => {
        if (document.fullscreenElement !== null) {
          document.exitFullscreen().catch(() => undefined);
        }
        const box = document.getElementById("lightbox");
        if (box !== null) box.hidden = true;
      };
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const box = document.getElementById("lightbox");
          if (box !== null && !box.hidden) close();
        }
      });
      document.addEventListener("fullscreenchange", () => {
        if (document.fullscreenElement === null) {
          const box = document.getElementById("lightbox");
          if (box !== null) box.hidden = true;
        }
      });
    }

    const wrap = document.getElementById("photo-wrap");
    const box = document.getElementById("lightbox");
    const full = document.getElementById("lightbox-img");
    const photo = wrap !== null ? wrap.querySelector("img") : null;
    if (wrap !== null && box !== null && full !== null && photo != null && wrap.dataset.wired !== "1") {
      wrap.dataset.wired = "1";
      wrap.addEventListener("click", () => {
        full.src = photo.currentSrc === "" ? photo.src : photo.currentSrc;
        full.alt = photo.alt;
        box.hidden = false;
        if (typeof box.requestFullscreen === "function" && document.fullscreenEnabled) {
          box.requestFullscreen().catch(() => undefined);
        }
      });
      box.addEventListener("click", () => {
        if (document.fullscreenElement !== null) {
          document.exitFullscreen().catch(() => undefined);
        }
        box.hidden = true;
      });
    }
  }

  initDetail();
  document.addEventListener("astro:page-load", initDetail);
</script>

<style>
  .detail { max-width: 76rem; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  .crumbs { margin: 0 0 1.5rem; font-size: 0.92rem; }
  .crumbs a {
    color: var(--muted); text-decoration: underline transparent;
    text-underline-offset: 4px; transition: color 0.2s ease, text-decoration-color 0.25s ease;
  }
  .crumbs a:hover { color: var(--accent); text-decoration-color: currentColor; }
  .crumbs a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 0.25rem; }
  /* Admin-mode toolbar: quiet bar, same link treatment as the header. */
  #admin-bar {
    display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;
    margin: 0 0 1.5rem; padding: 0.6rem 1rem;
    border: 1px solid var(--line); border-radius: 0.75rem;
    background: var(--card); font-size: 0.88rem;
  }
  #admin-bar[hidden] { display: none; }
  #admin-bar span { font-weight: 600; }
  #admin-bar button {
    font: inherit; font-size: 0.85rem; font-weight: 600;
    padding: 0.35rem 0.8rem; border-radius: 0.6rem;
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
    cursor: pointer;
  }
  #admin-bar button:hover { border-color: var(--ink); }
  #admin-bar a { color: var(--muted); }
  #admin-edit {
    display: grid; gap: 0.6rem; margin: 0 0 1.5rem; padding: 1rem;
    border: 1px solid var(--line); border-radius: 0.75rem; background: var(--card);
  }
  #admin-edit[hidden] { display: none; }
  /* The edit panel is built by script after load, so its nodes never
     carry the scope attribute — whole-selector :global keeps them styled. */
  :global(#admin-edit label) { display: grid; gap: 0.3rem; font-size: 0.85rem; font-weight: 600; }
  :global(#admin-edit input),
  :global(#admin-edit textarea) {
    width: 100%; box-sizing: border-box; font: inherit; font-weight: 400; font-size: 0.9rem;
    padding: 0.55rem 0.7rem; border-radius: 0.5rem;
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
  }
  :global(#admin-edit .ae-row) { display: flex; gap: 0.45rem; flex-wrap: wrap; align-items: end; }
  :global(#admin-edit .ae-row label) { flex: 1 1 8rem; }
  :global(#admin-edit .ae-check) { display: flex; gap: 0.6rem; align-items: center; }
  :global(#admin-edit .ae-check input) { width: auto; accent-color: var(--accent); }
  :global(#admin-edit .btn-primary) { width: auto; margin-top: 0; }
  :global(#ae-status) { font-size: 0.85rem; color: var(--muted); align-self: center; }
  .detail-grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 48rem) {
    .detail-grid { grid-template-columns: 1.15fr 1fr; }
    .info { position: sticky; top: 5.5rem; }
  }
  .frame {
    position: relative; background: var(--card);
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: clamp(0.7rem, 2vw, 1.1rem);
    box-shadow: var(--shadow);
    cursor: zoom-in;
  }
  .frame img { width: 100%; height: auto; display: block; border-radius: 0.25rem; }
  .badge {
    position: absolute; top: 1.2rem; right: 1.2rem;
    padding: 0.3rem 0.8rem; border-radius: 999px;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em;
    background: rgb(20 18 15 / 0.82); color: #fff;
  }
  .badge.sold { background: rgb(140 29 24 / 0.9); }
  #lightbox { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.94); display: grid; place-items: center; z-index: 50; cursor: zoom-out; animation: lb-in 0.25s ease; }
  #lightbox[hidden] { display: none; }
  @keyframes lb-in { from { opacity: 0; } }
  #lightbox img { max-width: 100vw; max-height: 100vh; object-fit: contain; border-radius: 0; }
  .eyebrow {
    margin: 0 0 0.6rem; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
  }
  h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 500; margin: 0 0 0.75rem; text-wrap: balance; }
  .price { font-family: Georgia, serif; font-size: 1.6rem; color: var(--accent); margin: 0; }
  .price-note { font-size: 0.92rem; color: var(--muted); margin: 0.3rem 0 0; }
