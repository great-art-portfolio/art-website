---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { slugifyTitle } from "../../lib/site";
import "../../components/studio.css";

// Baked in at build time so every painting has a row even with no
// analytics backend. Counts arrive client-side, after the rows.
// Drafts never opened for a buyer, so they get no row — trashed
// paintings are gone too.
const seed = (await getCollection("paintings"))
  .filter((p) => p.data.trash !== true && p.data.draft !== true)
  .map((p) => ({
    slug: slugifyTitle(p.data.title),
    title: p.data.title,
    sold: p.data.sold,
    draft: p.data.draft === true,
  }))
  .filter((r) => r.title !== "");
const seedJson = JSON.stringify(seed).replace(/</g, "\\u003c");
---

<Layout title="Metrics — Studio" wordmark="admin">
  <main class="admin" id="main">
    <section id="sec-views">
      <h2>Metrics</h2>
      <p class="hint">
        Which paintings visitors open most — past 30 days, most watched first.
      </p>
      <p class="hint" id="stats-note"></p>
      <table id="stats-table">
        <thead>
          <tr
            ><th scope="col">Painting</th><th scope="col">Status</th><th
              scope="col"
              class="num">Views</th
            ></tr
          >
        </thead>
        <tbody id="stats-body"></tbody>
        <tfoot>
          <tr
            ><th scope="row" colspan="2">Total</th><td
              class="num"
              id="stats-total">—</td
            ></tr
          >
        </tfoot>
      </table>
      <script
        is:inline
        type="application/json"
        id="stats-seed"
        set:html={seedJson}
      />
    </section>
  </main>
</Layout>

<script src="../../components/StatsPanel.ts"></script>

<style>
  #stats-note:empty {
    display: none;
  }
  #stats-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    font-size: 0.92rem;
  }
  #stats-table th,
  #stats-table td {
    text-align: left;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  #stats-table .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  #stats-table tfoot th,
  #stats-table tfoot td {
    border-bottom: none;
    font-weight: 700;
  }
  #stats-table tbody tr {
    transition: background-color 0.2s ease;
  }
  #stats-table tbody tr:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    #stats-table tbody tr {
      transition: none;
    }
  }
</style>
