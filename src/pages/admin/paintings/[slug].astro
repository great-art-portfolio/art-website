---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PaintingDetail, { type PaintingDetailData } from "../../../components/PaintingDetail.astro";
import { formatDimensions } from "../../../lib/dims";
import { slugifyTitle } from "../../../lib/site";

// Every painting — published or draft — gets a studio room. Drafts never
// get public buyer pages (see paintings/[id]), only these.
export async function getStaticPaths() {
  const paintings = await getCollection("paintings");
  return paintings.map((painting) => ({
    params: { slug: slugifyTitle(painting.data.title) },
    props: { painting },
  }));
}

const { painting } = Astro.props;
const meta = [painting.data.medium, formatDimensions(
  painting.data.widthIn ?? null,
  painting.data.heightIn ?? null,
  painting.data.depthIn ?? null,
)]
  .filter((s) => s !== undefined && s !== "")
  .join(" · ");
const data: PaintingDetailData = {
  title: painting.data.title,
  price: painting.data.price,
  sold: painting.data.sold,
  medium: painting.data.medium ?? "",
  meta,
  alt: painting.data.alt,
  description: painting.body,
  widthIn: painting.data.widthIn === undefined ? "" : String(painting.data.widthIn),
  heightIn: painting.data.heightIn === undefined ? "" : String(painting.data.heightIn),
  depthIn: painting.data.depthIn === undefined ? "" : String(painting.data.depthIn),
  image: painting.data.image,
  modelGlb: painting.data.modelGlb ?? "",
  modelUsdz: painting.data.modelUsdz ?? "",
  mdPath: `src/content/paintings/${painting.id.endsWith(".md") ? painting.id : `${painting.id}.md`}`,
  slug: slugifyTitle(painting.data.title),
  draft: painting.data.draft === true,
};
---

<Layout title={`${painting.data.title} — Studio`} wordmark="admin" description={`Edit ${painting.data.title} in the studio.`}>
  <PaintingDetail mode="edit" data={data} backHref="/admin" backLabel="← Back to the studio" />
</Layout>

<script src="../../../components/StudioPainting.ts"></script>
