---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { readdirSync } from "node:fs";
import {
  compareGalleryOrder,
  groupByAvailability,
  slugifyTitle,
} from "../lib/site";
import { studioRowHtml } from "../lib/studio-rows";
import "../components/studio.css";

// Astro lowercases content ids (img_5667.md), but repo paths are
// case-sensitive (IMG_5667.md). Resolve the real filename at build time so
// baked rows match API rows and deletes target a file that exists.
const diskNames = new Map(
  readdirSync("src/content/paintings").map((f) => [f.toLowerCase(), f]),
);
const mdFile = (id: string): string => {
  const withExt = id.endsWith(".md") ? id : `${id}.md`;
  return diskNames.get(withExt.toLowerCase()) ?? withExt;
};

// Baked in at build time so the list works without a publishing backend.
// It includes the editable fields so dev practice edits and deletes work
// without the API.
const localCollection = (await getCollection("paintings")).map((p) => ({
  slug: slugifyTitle(p.data.title),
  title: p.data.title,
  price: p.data.price,
  sold: p.data.sold,
  alt: p.data.alt,
  description: p.body,
  widthIn: p.data.widthIn ?? null,
  heightIn: p.data.heightIn ?? null,
  depthIn: p.data.depthIn ?? null,
  draft: p.data.draft === true,
  publishOn: p.data.publishOn ?? "",
  trash: p.data.trash === true,
  trashedAt: p.data.trashedAt ?? "",
  image: p.data.image.src,
  order: p.data.order ?? null,
  mdPath: `src/content/paintings/${mdFile(p.id)}`,
  // View counts load client-side. Zero matches the initial client render.
  views: 0,
}));
const localJson = JSON.stringify(localCollection).replace(/</g, "\\u003c");

// Render the rows as static markup. The client script renders identical HTML
// over them, so loading causes no layout shift.
const byTitle = (a: { title: string }, b: { title: string }): number =>
  a.title.localeCompare(b.title);
const live = localCollection.filter((p) => !p.trash);
const ssrTrash = [...localCollection].filter((p) => p.trash).sort(byTitle);
const ssrDrafts = [...live].filter((p) => p.draft).sort(byTitle);
const ssrGroups = groupByAvailability(live.filter((p) => !p.draft));
const ssrAvailable = [...ssrGroups.available].sort(compareGalleryOrder);
// Sold is reorderable like Available, so sort by `order:` rather than title.
const ssrSold = [...ssrGroups.sold].sort(compareGalleryOrder);
const ssrDraftCount = ssrDrafts.length;
const ssrDraftLabel =
  ssrDraftCount === 1 ? "1 draft" : `${ssrDraftCount} drafts`;
// Uses the client's row renderer so the markup matches exactly.
const availableHtml =
  ssrAvailable.length === 0
    ? `<li class="list-plain">Nothing available right now.</li>`
    : ssrAvailable.map(studioRowHtml).join("");
const draftsHtml = ssrDrafts.map(studioRowHtml).join("");
const soldHtml = ssrSold.map(studioRowHtml).join("");
const soldCount = ssrSold.length;
const soldLabel = soldCount === 1 ? "1 sold" : `${soldCount} sold`;
const trashHtml = ssrTrash.map(studioRowHtml).join("");
const trashCount = ssrTrash.length;
const trashLabel = trashCount === 1 ? "1 trashed" : `${trashCount} trashed`;
---

<Layout title="Admin - Collection" wordmark="admin" backdrop="collection">
  <main class="admin" id="main">
    <h2>
      <span id="collection-title">Available</span>
      <span id="collection-dev" hidden>
        (Development only — changes aren't persisted)
      </span>
      <button type="button" id="collection-refresh" hidden>
        Retry
      </button>
    </h2>
    <ul id="edit-list">
      <li class="list-group" data-group="available">
        <ul class="group-rows" set:html={availableHtml} />
      </li>
      {ssrDrafts.length > 0 && (
        <details class="drafts-fold" data-group="drafts" open>
          <summary>{ssrDraftLabel}</summary>
          <ul class="group-rows" set:html={draftsHtml} />
        </details>
      )}
      {soldCount > 0 && (
        <details class="sold-fold" data-group="sold" open>
          <summary>{soldLabel}</summary>
          <ul class="group-rows" set:html={soldHtml} />
        </details>
      )}
      {trashCount > 0 && (
        <details class="trash-fold" data-group="trash">
          <summary>{trashLabel}</summary>
          <div class="fold-tools">
            <button type="button" class="row-empty">
              Empty trash
            </button>
          </div>
          <p class="hint">
            Anything here over 30 days old clears itself. Deleted forever is
            forever.
          </p>
          <ul class="group-rows" set:html={trashHtml} />
        </details>
      )}
    </ul>
    <button type="button" id="practice-reset" hidden>
      Clear practice changes
    </button>
    <script
      is:inline
      type="application/json"
      id="local-collection"
      set:html={localJson}
    ></script>
    <div id="row-confirm" hidden>
      <div
        role="dialog"
        aria-modal="true"
        aria-labelledby="row-confirm-title"
        class="confirm-card"
      >
        <h2 id="row-confirm-title">Move to trash?</h2>
        <p id="row-confirm-body">
          This removes it from the site. Anything in trash restores in one tap,
          for 30 days.
        </p>
        <div class="confirm-actions">
          <button type="button" id="row-confirm-no">
            Keep it
          </button>
          <button type="button" id="row-confirm-yes" disabled>
            Move to trash
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script src="../components/AdminPanel.ts"></script>

<style>
  /* Collection list, row, and fold styles. Shared studio styles live in
     components/studio.css. */
  /* Dev-only note under the heading, in small muted text. Hidden in
     production. */
  :global(#collection-dev) {
    flex-basis: 100%;
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--muted);
  }
  /* Row view counts after the price. Hidden until the counts load. */
  :global(#edit-list .row-views:empty) {
    display: none;
  }
  :global(#edit-list .row-views) {
    color: var(--muted);
    font-size: 0.85rem;
  }
  /* The drawer script handles reduced motion: height changes are instant
     and the fade still runs. */
  #edit-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  /* On phones the group wrappers flatten into one list. On desktop
     Available becomes a card grid with the folds stacked below. */
  :global(#edit-list .list-group) {
    display: contents;
  }
  :global(#edit-list .group-rows) {
    display: contents;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  /* Folds use the same script-driven drawer as Advanced Settings. These
     are the end states only. The script animates between them. */
  :global(#edit-list .sold-fold > :not(summary)),
  :global(#edit-list .drafts-fold > :not(summary)),
  :global(#edit-list .trash-fold > :not(summary)) {
    opacity: 0;
  }
  :global(#edit-list .sold-fold[open] > :not(summary)),
  :global(#edit-list .drafts-fold[open] > :not(summary)),
  :global(#edit-list .trash-fold[open] > :not(summary)) {
    opacity: 1;
  }
  /* Rows are built by script and lack Astro's scope attribute, so these
     selectors are global. */
  :global(#edit-list li.row-card) {
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 0.7rem 1rem;
    font-size: 0.92rem;
  }
  :global(#edit-list li a),
  :global(#edit-list li a:visited) {
    color: var(--accent);
    text-decoration: underline transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.12s ease;
  }
  :global(#edit-list li a:hover) {
    text-decoration-color: currentColor;
  }
  /* Hovering the photo highlights the title too. */
  :global(#edit-list .row-card:has(.row-photo:hover) .row-title) {
    text-decoration-color: currentColor;
  }
  /* Plain notes in the list, without a card. */
  :global(#edit-list .list-plain) {
    background: none;
    border: none;
    padding: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  /* Per-row delete is a plain text button, since the confirmation modal
     carries the warning. On hover it turns the soft danger red. */
  :global(#edit-list .row-del) {
    font: inherit;
    font-size: 0.85rem;
    background: none;
    border: none;
    padding: 0;
    min-height: 0;
    color: var(--muted);
    text-decoration: underline transparent;
    text-underline-offset: 3px;
    cursor: pointer;
    justify-self: start;
    transition:
      color 0.2s ease,
      text-decoration-color 0.12s ease;
  }
  :global(#edit-list .row-del:hover) {
    color: var(--danger);
    text-decoration-color: currentColor;
  }
  /* Restore uses the same link-button style as Delete. */
  :global(#edit-list .row-restore) {
    font: inherit;
    font-size: 0.85rem;
    background: none;
    border: none;
    padding: 0;
    min-height: 0;
    color: var(--muted);
    text-decoration: underline transparent;
    text-underline-offset: 3px;
    cursor: pointer;
    justify-self: start;
    transition:
      color 0.2s ease,
      text-decoration-color 0.12s ease;
  }
  :global(#edit-list .row-restore:hover) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  :global(#edit-list .row-restore:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  /* Fold toolbars, such as Empty trash, between the count and the rows. */
  :global(#edit-list .fold-tools) {
    margin: 0.75rem 0 0;
  }
  :global(#edit-list .row-empty) {
    min-height: 2.2rem;
    padding: 0.25rem 0.9rem;
    font-size: 0.82rem;
  }
  /* Row delete confirmation modal. It appears without an entrance
     animation. */
  #row-confirm {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.6);
    z-index: 60;
  }
  #row-confirm[hidden] {
    display: none;
  }
  /* Reorder tooltip, built by script so the selector is global. A smaller
     version of the toast, layered above the cards and below the modal. It
     shows and hides instantly and ignores pointer events. */
  :global(#reorder-tip) {
    position: fixed;
    z-index: 50;
    max-width: 15rem;
    margin: 0;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.85rem;
    line-height: 1.4;
    box-shadow: var(--shadow);
    pointer-events: none;
  }
  :global(#reorder-tip[hidden]) {
    display: none;
  }
  .confirm-card {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.5rem;
    max-width: 26rem;
    width: 100%;
    box-sizing: border-box;
  }
  .confirm-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }
  .confirm-card p {
    margin: 0 0 1.25rem;
  }
  .confirm-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }
  #row-confirm-yes:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  :global(#edit-list .row-del:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  /* Rows show a thumbnail so paintings are recognizable at a glance. */
  :global(#edit-list li.row-card) {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }
  :global(#edit-list img.thumb) {
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--line);
    flex-shrink: 0;
    background: var(--card);
  }
  :global(#edit-list .row-body) {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    /* Links size to their text, so the space beside a title isn't
       clickable. */
    justify-items: start;
  }
  :global(#edit-list .row-photo) {
    display: inline-flex;
    border-radius: 0.5rem;
  }
  :global(#edit-list .row-photo:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  :global(#edit-list .row-edit),
  :global(#edit-list .row-qr) {
    font-size: 0.85rem;
  }
  /* Mini QR code shown as an icon beside its link. It has a fixed size
     from first paint so filling it doesn't shift the row. Rows come from
     innerHTML, so the selector is global. */
  :global(#edit-list .qr-mini) {
    width: 0.8125rem;
    height: 0.8125rem;
    flex-shrink: 0;
    align-self: center;
    color: var(--accent);
    background: none;
  }
  :global(#edit-list .qr-mini svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* The generator draws a white background and black modules with
     presentation attributes, which CSS overrides. Drop the background and
     recolor the modules. */
  :global(#edit-list .qr-mini svg rect) {
    fill: none;
  }
  :global(#edit-list .qr-mini svg path) {
    fill: currentColor;
  }
  /* Row actions sit side by side and wrap when Restore is added. The QR
     icon is inside its link, so tapping either one works. */
  :global(#edit-list .row-actions) {
    display: flex;
    gap: 0.4rem 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }
  :global(#edit-list .row-edit),
  :global(#edit-list .row-qr),
  :global(#edit-list .row-del),
  :global(#edit-list .row-restore) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  :global(#edit-list .ico) {
    flex-shrink: 0;
  }
  /* Fade-in for deferred reveals. Opacity-only, so reduced motion keeps it. */
  .fade-in {
    animation: fade-in 0.4s ease;
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  #practice-reset {
    margin-top: 0.75rem;
  }
  #practice-reset[hidden] {
    display: none;
  }
  /* The collection stacks full width: Available, then Drafts, then Sold. */
  @media (min-width: 60rem) {
    #edit-list {
      gap: 1.5rem;
    }
    /* Drafts and Sold each get a full-width row, open by default. */
    :global(#edit-list .sold-fold),
    :global(#edit-list .drafts-fold),
    :global(#edit-list .trash-fold) {
      border-top: 1px solid var(--line);
      padding-top: 1rem;
    }
    :global(#edit-list .sold-fold summary),
    :global(#edit-list .drafts-fold summary) {
      font-family: Georgia, "Iowan Old Style", Charter, serif;
      font-size: 1.4rem;
      font-weight: 500;
      cursor: pointer;
      -webkit-user-select: none;
      user-select: none;
      border-radius: 0.25rem;
      /* Fold counts use the h2 style without its bottom border. */
      padding-bottom: 0;
      border-bottom: none;
      margin-bottom: 1rem;
    }
    :global(#edit-list .trash-fold summary) {
      font-family: Georgia, "Iowan Old Style", Charter, serif;
      font-size: 1.05rem;
      font-weight: 500;
      cursor: pointer;
      -webkit-user-select: none;
      user-select: none;
      width: fit-content;
      border-radius: 0.25rem;
      border-bottom: none;
    }
    :global(#edit-list .sold-fold summary:focus-visible),
    :global(#edit-list .drafts-fold summary:focus-visible),
    :global(#edit-list .trash-fold summary:focus-visible) {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    :global(#edit-list .sold-fold .group-rows),
    :global(#edit-list .drafts-fold .group-rows),
    :global(#edit-list .trash-fold .group-rows) {
      margin-top: 0.75rem;
    }
    /* Drag-to-reorder: grab cursor on cards, and an accent edge where the
       card will land. Script-built classes need global selectors. */
    :global(#edit-list [draggable="true"]) {
      cursor: grab;
    }
    :global(#edit-list [draggable="true"]:active) {
      cursor: grabbing;
    }
    :global(#edit-list .row-card.drop-before) {
      box-shadow: inset 0 3px 0 var(--accent);
    }
    :global(#edit-list .row-card.drop-after) {
      box-shadow: inset 0 -3px 0 var(--accent);
    }
    /* In a grid row, drops mark the left or right edge instead of top or
       bottom. */
    :global(#edit-list .row-card.drop-left) {
      box-shadow: inset 3px 0 0 var(--accent);
    }
    :global(#edit-list .row-card.drop-right) {
      box-shadow: inset -3px 0 0 var(--accent);
    }
    :global(#edit-list .list-group) {
      display: grid;
      gap: 0.5rem;
      align-content: start;
      min-width: 0;
    }
    /* Card grid with the photo on top, up to four across. Five made the
       photos and drag targets too small. */
    :global(#edit-list .group-rows) {
      display: grid;
      gap: 0.75rem;
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    }
    :global(#edit-list li.row-card) {
      display: grid;
      align-content: start;
      gap: 0.6rem;
    }
    :global(#edit-list img.thumb) {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
    }
    /* Trash uses compact rows with small thumbnails instead of cards.
       Drafts use the same cards as Available. */
    :global(#edit-list .trash-fold .group-rows) {
      grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    }
    :global(#edit-list .trash-fold li.row-card) {
      display: flex;
      gap: 0.6rem;
      align-items: center;
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
    }
    :global(#edit-list .trash-fold img.thumb) {
      width: 3rem;
      height: 3rem;
    }
  }
</style>
