---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
import { ARTIST_LOCATION, ARTIST_NAME } from "../lib/site";
import { isExpired, localToday, parseAnnouncement } from "../lib/banner";
import bannerRaw from "../content/announcement.txt?raw";

// One sentence says who, what and where. The paintings below do the rest.
const headline =
  ARTIST_NAME !== null
    ? `${ARTIST_NAME} paints nature and abstraction in ${ARTIST_LOCATION}.`
    : `Nature and abstract paintings from ${ARTIST_LOCATION}.`;

// The studio note, set from /admin. Empty means hidden. Notes expired at
// build time aren't rendered, and the script below hides notes that expire
// between deploys.
const banner = parseAnnouncement(bannerRaw);
const announcement = isExpired(banner.expires, localToday()) ? "" : banner.text;
---

<Layout>
  <main id="main">
    <section class:list={["hero", announcement !== "" && "hero-note"]}>
      <div class="hero-main">
        <h1>{headline}</h1>
        <p class="lede">
          Every painting here is an original, sold directly from the studio.
        </p>
      </div>
      {announcement !== "" && (
        <aside class="announce" data-expires={banner.expires ?? ""}>
          {announcement}
        </aside>
      )}
    </section>

    <Gallery />

    <section class="about" id="about">
      <h2>About the studio</h2>
      <p>
        Prairie light, quiet water, and colour studies that sit somewhere
        between landscape and feeling. Each painting is one of a kind, and most
        are also available as prints.
      </p>
      <p>
        The listed price is the full price, and shipping is arranged with you
        after purchase. To ask about a painting, open it and tap{" "}
        <strong>Interested?</strong> Your note goes straight to the artist.
      </p>
    </section>
  </main>
</Layout>

<script>
  // Hide studio notes past their end date so they don't linger until the
  // next deploy. In dev the baked note and the preview can both be present.
  const notes = document.querySelectorAll(".announce[data-expires]");
  const now = new Date();
  const today =
    now.getFullYear() +
    "-" +
    String(now.getMonth() + 1).padStart(2, "0") +
    "-" +
    String(now.getDate()).padStart(2, "0");
  for (const note of notes) {
    const end = note.getAttribute("data-expires");
    if (end !== null && end !== "" && today > end) note.remove();
  }
  // Dev-only banner preview. Without a publishing backend the studio
  // stores the banner in this browser, and it renders here in the same
  // card as the real note.
  try {
    const raw = window.localStorage.getItem("studio-banner-preview-v1");
    if (raw !== null) {
      const preview = JSON.parse(raw);
      const text =
        preview !== null && typeof preview === "object"
          ? String(preview.text ?? "")
          : "";
      const expires =
        preview !== null && typeof preview === "object"
          ? String(preview.expires ?? "")
          : "";
      const now = new Date();
      const today =
        now.getFullYear() +
        "-" +
        String(now.getMonth() + 1).padStart(2, "0") +
        "-" +
        String(now.getDate()).padStart(2, "0");
      if (text.trim() !== "" && (expires === "" || today <= expires)) {
        let el = document.querySelector(".announce");
        if (el === null) {
          const hero = document.querySelector("#main .hero");
          const main = document.querySelector("#main .hero-main");
          if (hero !== null && main !== null) {
            el = document.createElement("aside");
            el.className = "announce";
            hero.classList.add("hero-note");
            main.insertAdjacentElement("afterend", el);
          }
        }
        if (el !== null) {
          el.textContent = text.trim().slice(0, 280);
          if (expires !== "") el.setAttribute("data-expires", expires);
          else el.removeAttribute("data-expires");
        }
      }
    }
  } catch {
    // No stored preview, so the baked note stays.
  }
</script>

<style>
  .hero {
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem 2.25rem;
  }
  /* With a studio note the intro splits into text on the left and the
     note on the right. */
  .hero-note {
    display: grid;
    gap: 2rem;
    align-content: start;
  }
  @media (min-width: 60rem) {
    .hero-note {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 0 3rem;
      align-items: center;
    }
  }
  /* The studio note, styled as paper with a tape strip. It stays cream in
     every color scheme. Keep in sync with the studio preview. */
  .announce {
    position: relative;
    margin: 0.9rem 0 0;
    max-width: 24rem;
    box-sizing: border-box;
    justify-self: center;
    rotate: -0.8deg;
    border-radius: 2px;
    background: linear-gradient(180deg, #fffdf8, #fdf6e9);
    padding: 1.4rem 1.25rem 1.1rem;
    color: #23201b;
    font-family: "Caveat", "Segoe Print", cursive;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.4;
    box-shadow:
      0 1px 2px rgb(35 32 27 / 0.1),
      0 10px 24px -14px rgb(35 32 27 / 0.35);
  }
  /* Translucent tape, slightly narrower than the note and slightly
     rotated. */
  .announce::before {
    content: "";
    position: absolute;
    top: -0.75rem;
    left: 50%;
    width: 5.5rem;
    height: 1.5rem;
    translate: -50% 0;
    rotate: -2deg;
    background: linear-gradient(
      180deg,
      rgb(233 220 196 / 0.9),
      rgb(226 210 182 / 0.75)
    );
    box-shadow: 0 1px 2px rgb(35 32 27 / 0.14);
  }
  /* Layout's heading font is scoped to Layout, so pages set their own. */
  .hero h1 {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    margin: 0 0 0.4rem;
    font-weight: 400;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.2;
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    font-size: 1.05rem;
    max-width: 46ch;
  }

  .about {
    max-width: 76rem;
    box-sizing: border-box;
    margin: 2.5rem auto 0;
    padding: 0 1.5rem 3.5rem;
    scroll-margin-top: 5rem;
  }
  .about h2 {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    margin: 0 0 0.6rem;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 400;
  }
  .about p {
    margin: 0 0 1rem;
    max-width: 38rem;
  }
  .about p:last-child {
    margin-bottom: 0;
  }
</style>
