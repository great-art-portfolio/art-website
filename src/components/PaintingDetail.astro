---
/** One painting in buy, edit, or draft mode. All three share one layout so
 * the editor matches the buyer page. The inline script skips any part whose
 * elements are absent. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { PHOTO_WIDTHS, photoSizes } from "../lib/responsive-images";
import { SHOW_PAGE_SHARE, SHOW_PRICES } from "../lib/site";

export interface PaintingDetailData {
  title: string;
  price: number;
  sold: boolean;
  /** Scheduled go-live ("YYYY-MM-DD", "" when none). */
  publishOn: string;
  medium: string;
  /** Precomputed "Oil · 24 × 36 in" line, empty when unmeasured. */
  meta: string;
  alt: string;
  description: string;
  /** Dimensions as display strings, "" when unmeasured. */
  widthIn: string;
  heightIn: string;
  depthIn: string;
  /** Absent in draft mode, where the upload tile replaces the photo. */
  image?: ImageMetadata;
  modelGlb: string;
  modelUsdz: string;
  mdPath: string;
  slug: string;
  draft: boolean;
}

interface Props {
  mode: "buy" | "edit" | "draft";
  data: PaintingDetailData;
  backHref: string;
  backLabel: string;
  /** Buyer pages only: link to this painting's studio room. */
  editHref?: string;
  /** Preview route: the buyer layout with the inquiry form disabled. */
  preview?: boolean;
}

const {
  mode,
  data,
  backHref,
  backLabel,
  editHref = "",
  preview = false,
} = Astro.props;
const studio = mode !== "buy";
const priceLabel = `$${data.price.toFixed(2)} CAD`;
const eyebrow =
  mode === "edit"
    ? // The edit room is under /admin, separate from the public buyer page.
      "EDITING · ONLY YOU CAN SEE THIS"
    : data.draft
      ? "Draft · only you can see this"
      : "Original painting · one of a kind";
---

<main
  class="detail"
  id="main"
  data-mode={mode}
  data-title={data.title}
  data-price-cents={Math.round(data.price * 100)}
  data-glb={data.modelGlb}
  data-usdz={data.modelUsdz}
  data-alt={data.alt}
  data-md-path={data.mdPath}
  data-slug={data.slug}
  data-draft={data.draft ? "1" : ""}
  data-image={data.image?.src ?? ""}
>
  <p class="crumbs">
    <a href={backHref}>{backLabel}</a>
    {
      mode === "buy" && !preview && SHOW_PAGE_SHARE && (
        <button
          type="button"
          id="pg-share"
          class="crumbs-share"
          aria-label="Share this painting"
          hidden
        >
          <svg
            class="when-idle"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 15V3" />
            <path d="M7 8l5-5 5 5" />
            <path d="M5 12v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8" />
          </svg>
          <svg
            class="when-copied is-parked"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 6L9 17l-5-5" />
          </svg>
        </button>
      )
    }
  </p>
  {
    mode === "buy" && (
      <div id="admin-bar" hidden>
        <span>Admin mode</span>
        <a href={editHref}>Edit in the studio</a>
        <a href="/admin">Studio</a>
      </div>
    )
  }
  <div class="detail-grid">
    <div class="media-col">
      {
        studio && mode === "draft" ? (
          <div>
            <div class="upload-tile">
              <input
                id="de-photo"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/heic"
                capture="environment"
                aria-label="Upload photo"
              />
              <span id="de-photo-empty" aria-hidden="true">
                Upload photo
              </span>
              <img id="de-photo-preview" alt="Photo preview" hidden />
            </div>
            <div class="tile-row" id="de-photo-tools" hidden>
              <button type="button" id="de-rotate-90">
                Rotate ↻
              </button>
              <button type="button" id="de-rotate-270">
                Rotate ↺
              </button>
            </div>
            <p class="hint" id="de-photo-meta" />
          </div>
        ) : (
          <div>
            <div class="frame" id="photo-wrap" title="Tap to view fullscreen">
              {data.image !== undefined && (
                <Image
                  src={data.image}
                  alt={data.alt}
                  width={1200}
                  widths={PHOTO_WIDTHS}
                  sizes={photoSizes()}
                  format="webp"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              )}
              {data.sold && <span class="badge sold">Sold</span>}
            </div>
            {studio && (
              <div class="tile-row">
                <button type="button" id="de-replace">
                  Replace photo
                </button>
                <input
                  id="de-replace-file"
                  type="file"
                  accept="image/jpeg,image/png,image/webp,image/heic"
                  capture="environment"
                  aria-label="Replace photo"
                  hidden
                />
              </div>
            )}
          </div>
        )
      }
      {
        studio && !data.sold && (
          <div id="ar-mount">
            <h2>3D Model Preview</h2>
            {data.modelGlb !== "" ? (
              <>
                <p class="hint">
                  About true size — on your phone, point it at the wall where it
                  would hang.
                </p>
                <div id="ar-stage">
                  <div class="ar-skeleton" aria-hidden="true" />
                </div>
              </>
            ) : (
              <>
                <div class="ar-waiting" id="de-ar-waiting">
                  <p>
                    Waiting for a photo — once one arrives, the 3D model takes
                    about 5 seconds to build. You'll see it here, and on a phone
                    you can also view it in AR.
                  </p>
                </div>
                <div id="ar-stage" hidden />
              </>
            )}
          </div>
        )
      }
      {
        mode === "edit" && !data.draft && (
          <section
            class="share"
            id="de-share"
            aria-labelledby="de-share-title"
            hidden
          >
            <h2 id="de-share-title">Tell social media</h2>
            <p class="hint" id="de-share-hint" />
            <textarea
              id="de-share-text"
              rows="3"
              maxlength="2000"
              autocomplete="off"
              aria-label="Words for the post"
            />
            <div class="share-actions">
              <button type="button" id="de-share-send" class="btn-primary">
                Share
              </button>
              <button type="button" id="de-share-photo">
                Save photo
              </button>
              <button type="button" id="de-share-copy">
                Copy
              </button>
            </div>
            <p class="hint" id="de-share-status" role="status" />
          </section>
        )
      }
    </div>
    <div
      id="lightbox"
      hidden
      role="dialog"
      aria-modal="true"
      aria-label="Painting fullscreen view"
    >
      <img id="lightbox-img" alt="" />
    </div>
    <div class="info">
      <p class="eyebrow">{eyebrow}</p>
      {
        studio ? (
          <>
            <h1 id="pv-title">{data.title === "" ? "Untitled" : data.title}</h1>
            <p class="price" id="pv-price">
              {data.price > 0 ? priceLabel : "Price?"}
            </p>
            <p class="art-meta" id="pv-meta">
              {data.meta}
            </p>
            <div class="desc" id="pv-desc" />
            <div class="studio-fields">
              <h2>Painting details</h2>
              <label>
                Title
                <input
                  id="de-title"
                  type="text"
                  maxlength="120"
                  autocomplete="off"
                  value={data.title}
                />
              </label>
              <label>
                Price (CAD)
                <input
                  id="de-price"
                  type="number"
                  min="1"
                  step="0.01"
                  inputmode="decimal"
                  value={data.price > 0 ? String(data.price) : ""}
                />
              </label>
              <div class="de-row">
                <label>
                  Width (in)
                  <input
                    id="de-w"
                    type="number"
                    min="1"
                    step="0.5"
                    inputmode="decimal"
                    value={data.widthIn}
                  />
                </label>
                <label>
                  Height (in)
                  <input
                    id="de-h"
                    type="number"
                    min="1"
                    step="0.5"
                    inputmode="decimal"
                    value={data.heightIn}
                  />
                </label>
                <label>
                  Depth (in)
                  <input
                    id="de-d"
                    type="number"
                    min="0.5"
                    step="0.5"
                    inputmode="decimal"
                    value={data.depthIn}
                  />
                </label>
              </div>
              <p class="hint">
                Measure with a tape — buyers ask, shippers need it, and the wall
                preview needs it for true size.
              </p>
              <label>
                Medium (optional, e.g. Oil on canvas)
                <input
                  id="de-medium"
                  type="text"
                  maxlength="120"
                  autocomplete="off"
                  value={data.medium}
                />
              </label>
              <label>
                Alt text (describe the art)
                <input
                  id="de-alt"
                  type="text"
                  maxlength="200"
                  autocomplete="off"
                  value={data.alt}
                  aria-describedby="de-alt-hint"
                />
              </label>
              <p class="hint" id="de-alt-hint">
                Alt text describes the photo for people who can't see it —
                screen readers read it aloud. It never shows on the page.
              </p>
              <label class="de-desc-label">
                Description
                {/* prettier-ignore */}
                <textarea id="de-desc" rows="4" maxlength="2000">{data.description}</textarea>
              </label>
            </div>
            <div class="studio-toolbar">
              <label class="de-check">
                Publish on
                <input
                  id="de-publish-on"
                  type="date"
                  value={data.publishOn}
                  aria-describedby="de-publish-on-hint"
                />
              </label>
              <label class="de-check">
                <input id="de-sold" type="checkbox" checked={data.sold} /> Sold
              </label>
              <span class="hint" id="de-publish-on-hint">
                Leaving no date will publish right now, after your confirmation.
              </span>
              {mode === "draft" || data.draft ? (
                <span class="de-notify-group">
                  <span class="de-notify-label">On publish, also tell:</span>
                  <label class="de-check">
                    <input id="de-notify-push" type="checkbox" /> Browsers
                  </label>
                  <label class="de-check">
                    <input id="de-notify-email" type="checkbox" /> Email list
                  </label>
                </span>
              ) : null}
              {mode === "draft" ? (
                <>
                  <button type="button" id="de-publish">
                    Publish painting
                  </button>
                  <button type="button" id="de-save-draft" class="btn-primary">
                    Save draft
                  </button>
                </>
              ) : (
                <>
                  <button type="button" id="de-save" class="btn-primary">
                    Save changes
                  </button>
                  <button type="button" id="de-visibility">
                    {data.draft ? "Publish" : "Unpublish"}
                  </button>
                  <a
                    id="de-preview"
                    class="de-preview"
                    href={`/admin/preview/${data.slug}`}
                    target="_blank"
                    rel="noopener"
                  >
                    Preview
                  </a>
                  <button type="button" id="de-del">
                    Delete
                  </button>
                </>
              )}
              <span id="de-status" role="status" />
            </div>
            {mode === "edit" && (
              <div id="de-confirm" hidden>
                <div
                  role="dialog"
                  aria-modal="true"
                  aria-labelledby="de-confirm-title"
                  class="de-confirm-card"
                >
                  <h2 id="de-confirm-title">Move to trash?</h2>
                  <p id="de-confirm-body">
                    This removes it from the site. Anything in trash restores in
                    one tap, for 30 days.
                  </p>
                  <div class="de-confirm-actions">
                    <button type="button" id="de-confirm-no">
                      Keep it
                    </button>
                    <button type="button" id="de-confirm-yes" disabled>
                      Move to trash
                    </button>
                  </div>
                </div>
              </div>
            )}
          </>
        ) : (
          <>
            <h1>{data.title}</h1>
            {data.sold ? (
              <p class="sold-note">This piece has found a home.</p>
            ) : SHOW_PRICES ? (
              <p class="price">{priceLabel}</p>
            ) : (
              <p class="price-note">
                Price on request — send a note below and the artist will reply.
              </p>
            )}
            {data.meta !== "" && <p class="art-meta">{data.meta}</p>}
            <div class="desc">
              <slot />
            </div>
          </>
        )
      }
      {
        !data.sold && !studio && !preview && (
          <>
            <button
              type="button"
              id="inquiry-reveal"
              class="btn-primary"
              hidden
            >
              Interested?
            </button>
            <form id="inquiry-form">
              <h2>Ask about this painting</h2>
              <p class="ship-note">
                Shipping arranged with the artist after purchase.
              </p>
              <label>
                Name{" "}
                <input name="name" type="text" required autocomplete="name" />
              </label>
              <label>
                Email{" "}
                <input
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                />
              </label>
              <label>
                Message{" "}
                <textarea
                  name="message"
                  rows="3"
                  placeholder="Hi, I love this piece…"
                />
              </label>
              <input
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
                class="hp"
                aria-hidden="true"
              />
              <div id="turnstile-mount" />
              <button type="submit" class="btn-primary">
                Send inquiry
              </button>
              <p id="inquiry-status" role="status" />
            </form>
          </>
        )
      }
      {
        !studio && !data.sold && data.modelGlb !== "" && (
          <div id="ar-mount">
            <h2>Try it on your wall</h2>
            <p class="hint">
              About true size — on your phone, point it at the wall where it
              would hang.
            </p>
            <div id="ar-stage">
              <div class="ar-skeleton" aria-hidden="true" />
            </div>
          </div>
        )
      }
    </div>
  </div>
</main>

<script>
  // Page data comes from #main data-* attributes. define:vars isn't used
  // because it skips bundling and breaks dynamic imports. View Transitions
  // keep this script alive across pages, so read dataset on each use.
  function readPageData() {
    const pageData = document.getElementById("main")?.dataset;
    return {
      title: pageData?.title ?? "",
      priceCents: Number(pageData?.priceCents ?? "0"),
      glb: pageData?.glb ?? "",
      usdz: pageData?.usdz ?? "",
      alt: pageData?.alt ?? "",
      mdPath: pageData?.mdPath ?? "",
    };
  }
  /** Turnstile spam check, shared with the collector modal. Each send
   * takes its own single-use token. */
  function loadTurnstile() {
    void import("../lib/turnstile-widget").then(({ ensureTurnstile }) =>
      ensureTurnstile("#turnstile-mount"),
    );
  }

  async function inquiryToken() {
    const { takeTurnstileToken } = await import("../lib/turnstile-widget");
    return await takeTurnstileToken("#turnstile-mount");
  }

  /** "View on your wall" AR viewer, rendered only when models exist. */
  function initAr() {
    const mount = document.getElementById("ar-mount");
    if (mount === null) return;
    const { glb, usdz, alt, title } = readPageData();
    if (glb === "" || mount.dataset.wiredSrc === glb) return;
    mount.dataset.wiredSrc = glb;
    const stage = document.getElementById("ar-stage");
    if (stage === null) return;
    // Load the ~1.5MB viewer and models only once the stage scrolls into
    // view. Until then the photo stands in.
    const photo = document.querySelector("#photo-wrap img");
    const poster =
      photo instanceof HTMLImageElement
        ? photo.currentSrc === ""
          ? photo.src
          : photo.currentSrc
        : "";
    if (poster !== "") {
      const img = document.createElement("img");
      img.src = poster;
      img.alt = "";
      img.loading = "lazy";
      img.decoding = "async";
      img.style.width = "100%";
      img.style.height = "20rem";
      img.style.objectFit = "contain";
      img.style.borderRadius = "1rem";
      stage.replaceChildren(img);
    }
    const build = () => {
      // Loaded with a script tag because Vite dev won't serve /public files
      // as modules.
      void import("../lib/vendor-loader")
        .then(({ loadModelViewer }) => loadModelViewer())
        .then(() => {
          if (!document.contains(mount)) return;
          const liveStage = document.getElementById("ar-stage");
          if (liveStage === null) return;
          const el = document.createElement("model-viewer");
          el.setAttribute("src", glb);
          if (usdz !== "") el.setAttribute("ios-src", usdz);
          if (poster !== "") el.setAttribute("poster", poster);
          el.setAttribute("loading", "lazy");
          el.setAttribute("ar", "");
          el.setAttribute("ar-modes", "webxr scene-viewer quick-look");
          el.setAttribute("ar-scale", "fixed");
          el.setAttribute("ar-placement", "wall");
          el.setAttribute("camera-controls", "");
          // Vertical swipes scroll the page, and horizontal drags rotate
          // the model. Otherwise phones capture the scroll.
          el.setAttribute("touch-action", "pan-y");
          el.setAttribute("alt", alt === "" ? title : alt);
          el.style.width = "100%";
          el.style.height = "20rem";
          el.style.borderRadius = "1rem";
          liveStage.replaceChildren(el);
        })
        .catch(() => {
          mount.hidden = true;
        });
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries, obs) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          obs.disconnect();
          build();
        }
      });
      io.observe(mount);
    } else {
      build();
    }
  }

  // View Transitions don't re-run page scripts, so initDetail() runs
  // immediately and on astro:page-load, guarded against wiring twice.

  /** Shows the studio link when this browser has an admin token. */
  function initAdmin() {
    const bar = document.getElementById("admin-bar");
    if (bar === null || bar.dataset.wired === "1") return;
    let token;
    try {
      // Same lookup as getApiToken in src/lib/api.ts.
      token =
        localStorage.getItem("ADMIN_API_TOKEN") ??
        sessionStorage.getItem("ADMIN_API_TOKEN") ??
        "";
    } catch {
      return;
    }
    if (token === "") return;
    bar.dataset.wired = "1";
    bar.hidden = false;
  }

  // Shows a status message with a fade-in. Default parameter values supply
  // the types, since inline scripts can't use annotations.
  function say(el = document.body, msg = "") {
    el.textContent = msg;
    if (typeof el.animate === "function") {
      el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200 });
    }
  }

  function initDetail() {
    initAr();
    initAdmin();
    initPageShare();
    // iOS has no Background Sync, so flush the outbox on load and reconnect.
    // Notes saved offline get a fresh spam check token here, since the one
    // they were saved with has expired by now.
    void import("../lib/queue").then(({ armOutboxFlush }) =>
      armOutboxFlush(inquiryToken),
    );
    // Inquiries are emailed and not stored. Spam checks are a honeypot field,
    // then Turnstile.
    const formEl = document.getElementById("inquiry-form");
    const form = formEl instanceof HTMLFormElement ? formEl : null;
    if (form !== null && form.dataset.wired !== "1") {
      form.dataset.wired = "1";
      loadTurnstile();
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        if ((data.get("website") ?? "") !== "") return; // honeypot
        const status = document.getElementById("inquiry-status");
        if (status === null) return;
        say(status, "Sending…");
        const live = readPageData();
        void Promise.all([import("../lib/queue"), inquiryToken()]).then(
          ([{ queuePost }, turnstileToken]) =>
            queuePost("/api/inquiries", {
              paintingTitle: live.title,
              priceCents: live.priceCents,
              name: String(data.get("name") ?? ""),
              email: String(data.get("email") ?? ""),
              message: String(data.get("message") ?? ""),
              website: "",
              turnstileToken,
            }).then((result) => {
              say(
                status,
                result === "sent"
                  ? "Thanks! The artist will reply by email."
                  : result === "queued"
                    ? "Saved — it will send automatically when you're back online."
                    : result === "check"
                      ? "One more step — finish the quick check above, then tap Send inquiry again."
                      : "That didn't go through — check your email address and try again.",
              );
              if (result === "sent") form.reset();
            }),
        );
      });
    }

    // "Interested?" reveals the form. Without JS the form is already open.
    const reveal = document.getElementById("inquiry-reveal");
    if (reveal !== null && form !== null && reveal.dataset.wired !== "1") {
      reveal.dataset.wired = "1";
      form.hidden = true;
      reveal.hidden = false;
      reveal.addEventListener("click", () => {
        form.hidden = false;
        form.classList.add("revealed");
        reveal.hidden = true;
        const name = form.querySelector('input[name="name"]');
        if (name instanceof HTMLInputElement) name.focus();
      });
    }

    // Buyer share button. Uses the share sheet where available, otherwise
    // copies the link and shows a check for two seconds. On failure the
    // button gets a text label.
    function initPageShare() {
      const btnEl = document.getElementById("pg-share");
      const btn = btnEl instanceof HTMLButtonElement ? btnEl : null;
      if (btn === null || btn.dataset.wired === "1") return;
      btn.dataset.wired = "1";
      const nativeShare =
        typeof navigator.share === "function" &&
        (typeof navigator.canShare !== "function" ||
          navigator.canShare({ url: window.location.href }));
      if (!nativeShare)
        btn.setAttribute("aria-label", "Copy the link to this painting");
      btn.hidden = false;
      btn.addEventListener("click", () => {
        const live = readPageData();
        void import("../lib/page-share").then(({ sharePaintingPage }) =>
          sharePaintingPage({
            title: live.title,
            priceCents: live.priceCents,
            url: window.location.href,
          }).then((result) => {
            // The share sheet is its own confirmation, so only copies and
            // failures show feedback.
            if (result === "copied") {
              const idle = btn.querySelector(".when-idle");
              const tick = btn.querySelector(".when-copied");
              if (idle === null || tick === null) return;
              idle.classList.add("is-parked");
              tick.classList.remove("is-parked");
              const back =
                btn.getAttribute("aria-label") ?? "Share this painting";
              btn.setAttribute("aria-label", "Copied.");
              window.setTimeout(() => {
                if (!document.contains(btn)) return;
                idle.classList.remove("is-parked");
                tick.classList.add("is-parked");
                btn.setAttribute("aria-label", back);
              }, 2000);
            } else if (result === "failed") {
              btn.setAttribute(
                "aria-label",
                nativeShare
                  ? "Couldn't share — try again."
                  : "Couldn't copy — hold the address bar to copy it.",
              );
            }
          }),
        );
      });
    }

    // Tapping the photo opens it fullscreen. Document listeners register
    // once per session and look up targets on each event.
    if (window.__detailDocWired !== true) {
      window.__detailDocWired = true;
      const close = () => {
        if (document.fullscreenElement !== null) {
          document.exitFullscreen().catch(() => undefined);
        }
        const box = document.getElementById("lightbox");
        if (box !== null) box.hidden = true;
      };
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const box = document.getElementById("lightbox");
          if (box !== null && !box.hidden) close();
        }
      });
      document.addEventListener("fullscreenchange", () => {
        if (document.fullscreenElement === null) {
          const box = document.getElementById("lightbox");
          if (box !== null) box.hidden = true;
        }
      });
    }

    const wrapEl = document.getElementById("photo-wrap");
    const wrap = wrapEl instanceof HTMLElement ? wrapEl : null;
    const box = document.getElementById("lightbox");
    const fullEl = document.getElementById("lightbox-img");
    const full = fullEl instanceof HTMLImageElement ? fullEl : null;
    const photo = wrap !== null ? wrap.querySelector("img") : null;
    if (
      wrap !== null &&
      box !== null &&
      full !== null &&
      photo != null &&
      wrap.dataset.wired !== "1"
    ) {
      wrap.dataset.wired = "1";
      wrap.addEventListener("click", () => {
        full.src = photo.currentSrc === "" ? photo.src : photo.currentSrc;
        full.alt = photo.alt;
        box.hidden = false;
        if (
          typeof box.requestFullscreen === "function" &&
          document.fullscreenEnabled
        ) {
          box.requestFullscreen().catch(() => undefined);
        }
      });
      box.addEventListener("click", () => {
        if (document.fullscreenElement !== null) {
          document.exitFullscreen().catch(() => undefined);
        }
        box.hidden = true;
      });
    }
  }

  initDetail();
  document.addEventListener("astro:page-load", initDetail);
</script>

