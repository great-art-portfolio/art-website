---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PaintingDetail, {
  type PaintingDetailData,
} from "../../components/PaintingDetail.astro";
import { formatDimensions } from "../../lib/dims";
import { modelGlbOrEmpty } from "../../lib/model-files";
import {
  ARTIST_NAME,
  isPublished,
  SITE_URL,
  slugifyTitle,
} from "../../lib/site";

export async function getStaticPaths() {
  const paintings = (await getCollection("paintings")).filter((p) =>
    isPublished(p.data),
  );
  // Old links keep working after a rename, with one alias page per history
  // entry. An alias that collides with a current slug is skipped, since
  // duplicate paths break the build.
  const claimed = new Set(paintings.map((p) => slugifyTitle(p.data.title)));
  const paths = paintings.map((painting) => ({
    params: { id: slugifyTitle(painting.data.title) },
    props: { painting },
  }));
  for (const painting of paintings) {
    const history = (painting.data.slugHistory ?? "")
      .split(",")
      .map((s) => s.trim().toLowerCase())
      .filter((s) => /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(s));
    for (const alias of history) {
      if (claimed.has(alias)) continue;
      claimed.add(alias);
      paths.push({ params: { id: alias }, props: { painting } });
    }
  }
  return paths;
}

const { painting } = Astro.props;
const { Content } = await render(painting);
// Without a model file, omit the wall preview instead of showing an empty
// viewer.
const modelGlb = modelGlbOrEmpty(painting.data.modelGlb);
const meta = [
  painting.data.medium,
  formatDimensions(
    painting.data.widthIn ?? null,
    painting.data.heightIn ?? null,
    painting.data.depthIn ?? null,
  ),
]
  .filter((s) => s !== undefined && s !== "")
  .join(" · ");
const data: PaintingDetailData = {
  title: painting.data.title,
  price: painting.data.price,
  sold: painting.data.sold,
  publishOn: "",
  medium: painting.data.medium ?? "",
  meta,
  alt: painting.data.alt,
  description: painting.body ?? "",
  widthIn:
    painting.data.widthIn === undefined ? "" : String(painting.data.widthIn),
  heightIn:
    painting.data.heightIn === undefined ? "" : String(painting.data.heightIn),
  depthIn:
    painting.data.depthIn === undefined ? "" : String(painting.data.depthIn),
  image: painting.data.image,
  modelGlb,
  modelUsdz: modelGlb === "" ? "" : (painting.data.modelUsdz ?? ""),
  mdPath: `src/content/paintings/${painting.id.endsWith(".md") ? painting.id : `${painting.id}.md`}`,
  slug: slugifyTitle(painting.data.title),
  draft: false,
};
const pageUrl = new URL(`/paintings/${data.slug}`, SITE_URL).href;
// Search engines want the photo itself here, not the page it sits on.
const paintingJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: painting.data.title,
  url: pageUrl,
  image: new URL(painting.data.image.src, SITE_URL).href,
  description: painting.data.alt,
  ...(ARTIST_NAME === null
    ? {}
    : { brand: { "@type": "Brand", name: ARTIST_NAME } }),
  offers: {
    "@type": "Offer",
    url: pageUrl,
    priceCurrency: "CAD",
    price: painting.data.price.toFixed(2),
    availability: painting.data.sold
      ? "https://schema.org/SoldOut"
      : "https://schema.org/InStock",
  },
};
---

<Layout
  title={`${painting.data.title}${ARTIST_NAME === null ? "" : ` by ${ARTIST_NAME}`} — ${painting.data.sold ? "Sold" : "Original Painting"}`}
  description={painting.data.alt}
  canonical={`/paintings/${data.slug}`}
  image={painting.data.image.src}
>
  <PaintingDetail
    mode="buy"
    data={data}
    backHref="/"
    backLabel="← Back to the collection"
    editHref={`/admin/paintings/${data.slug}`}
  >
    <Content />
  </PaintingDetail>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(paintingJsonLd)}
  />
</Layout>
