---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Layout from "../layouts/Layout.astro";
import { CREDITS } from "../lib/credits";
import { t } from "../i18n";
import type { Locale } from "../i18n/locales";

interface Props {
  locale?: Locale | undefined;
}
const { locale = "en" } = Astro.props;
const s = t(locale);

// Full licence texts from the installed packages, read once at build.
// Direct dependencies sit at node_modules/<name>, pnpm included.
const credits = CREDITS.map((c) => ({
  ...c,
  text:
    c.text ??
    readFileSync(
      join(process.cwd(), "node_modules", c.pkg ?? "", "LICENSE"),
      "utf8",
    ).trim(),
}));
---

<Layout
  title={s.credits.title}
  description={s.credits.description}
  locale={locale}
  alternates="/credits"
>
  <main class="credits" id="main">
    <h1>{s.credits.title}</h1>
    <p>{s.credits.intro}</p>
    {locale !== "en" && <p class="note">{s.credits.licenceNote}</p>}
    <ul>
      {credits.map((c) => (
        <li>
          <h2>
            <a href={c.url} rel="noopener">
              {c.name}
            </a>
          </h2>
          <p>{s.credits.uses[c.key]}</p>
          <details>
            <summary>{c.licence}</summary>
            <pre lang="en">{c.text}</pre>
          </details>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .credits {
    max-width: 44rem;
    margin: 0 auto;
    padding: 1rem 1.25rem 4rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1.75rem;
  }
  h2 {
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
  }
  h2 a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.2em;
  }
  .note {
    color: var(--muted);
    font-size: 0.9rem;
  }
  li p {
    margin: 0 0 0.35rem;
  }
  summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    width: fit-content;
  }
  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
</style>
