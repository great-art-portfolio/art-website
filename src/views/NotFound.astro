---
import Layout from "../layouts/Layout.astro";
import { ENABLED, t } from "../i18n";
import { LOCALES, localePath, type Locale } from "../i18n/locales";

interface Props {
  locale?: Locale | undefined;
}
const { locale = "en" } = Astro.props;
const s = t(locale).notFound;
// A language she has switched off has no pages left; its links go to the
// English page instead of this one.
const off = LOCALES.map((l) => l.code).filter(
  (c) => c !== "en" && !(ENABLED as readonly string[]).includes(c),
);
---

<Layout
  title={s.title}
  description={s.description}
  noindex
  noCanonical
  locale={locale}
>
  <main class="missing" id="main" data-off={off.join(" ")}>
    <p class="eyebrow">{s.eyebrow}</p>
    <h1>{s.heading}</h1>
    <p>{s.body}</p>
    <p>
      <a href={localePath(locale, "/#collection")} class="btn-primary">
        {s.browse}
      </a>
    </p>
  </main>
</Layout>

<style>
  .missing {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-weight: 500;
    margin: 0 0 1rem;
  }
  /* The home link uses the primary button style in both themes. */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    min-height: 3rem;
    border-radius: 0.75rem;
    padding: 0.7rem 1.5rem;
    font-weight: 600;
    background: var(--primary);
    color: var(--primary-ink);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }
  .btn-primary:hover {
    background: var(--primary-hover);
    color: var(--primary-ink);
  }
  .btn-primary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  p {
    color: var(--muted);
  }
</style>

<script>
  // /de/paintings/x after German was switched off: same page in English.
  const off = (document.getElementById("main")?.dataset.off ?? "")
    .split(" ")
    .filter((c) => c !== "");
  const m = window.location.pathname.match(/^\/([a-z]{2})(\/.*)?$/);
  if (m !== null && off.includes(m[1] ?? "")) {
    window.location.replace(
      (m[2] ?? "/") + window.location.search + window.location.hash,
    );
  }
</script>
