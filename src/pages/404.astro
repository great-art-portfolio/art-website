---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Not found — Barbara Straka Original Paintings"
  description="This page doesn't exist. Browse the collection of original paintings instead."
>
  <main class="missing" id="main">
    <p class="eyebrow">Off the wall — 404</p>
    <h1>That wall is empty.</h1>
    <p>
      The page you're looking for isn't here — it may have moved. The collection
      is this way:
    </p>
    <p>
      <a href="/#collection" class="btn-primary">Browse the collection</a>
    </p>
  </main>
</Layout>

<style>
  .missing {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-weight: 500;
    margin: 0 0 1rem;
  }
  /* The way home wears the primary button, both themes at once. */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    min-height: 3rem;
    border-radius: 0.75rem;
    padding: 0.7rem 1.5rem;
    font-weight: 600;
    background: var(--primary);
    color: var(--primary-ink);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }
  .btn-primary:hover {
    background: var(--primary-hover);
    color: var(--accent-ink);
  }
  .btn-primary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  p {
    color: var(--muted);
  }
</style>
