---
import Layout from "../../layouts/Layout.astro";
import "../../components/studio.css";
---

<Layout title="Admin - Banner" wordmark="admin" backdrop="banner">
  <main class="admin" id="main">
    <section id="sec-banner" class="prose">
      <h2>Homepage banner</h2>
      <aside id="banner-preview" hidden></aside>
      <label
        >Announcement
        <input
          id="f-announce"
          type="text"
          maxlength="280"
          autocomplete="off"
          placeholder="Find me at the Lilac Festival this Sunday!"
        />
      </label>
      <div class="row banner-line">
        <label
          >Show until
          <select id="f-duration">
            <option value="">No end date</option>
            <option value="1">1 day</option>
            <option value="3">3 days</option>
            <option value="7" selected>7 days</option>
            <option value="14">2 weeks</option>
          </select>
        </label>
        <div class="row banner-actions">
          <button type="button" id="announce-save" class="primary"
            >Update banner</button
          >
          <button type="button" id="announce-clear" hidden>
            Remove banner
          </button>
          <p class="hint" id="announce-meta"></p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script src="../../components/AdminPanel.ts"></script>

<style>
  /* Banner status rides beside the buttons, never below them — the row
     wraps on narrow phones, so it can still fall underneath there. */
  #announce-meta {
    margin: 0;
    align-self: center;
  }
  #announce-meta:empty {
    display: none;
  }
  /* Duration, buttons, and status share one line on desktop: the actions
     sit level with the dropdown, and the row wraps on narrow phones. */
  #sec-banner .banner-line {
    margin-top: 1.25rem;
    align-items: end;
  }
  #sec-banner .banner-line > label {
    flex: 0 0 auto;
  }
  #sec-banner .banner-actions {
    margin-block: 0;
  }
  /* Three words at most ("No end date") — no reason to span the
     column. The label is a grid, so auto width alone still stretches:
     park it to the start. */
  #f-duration {
    width: auto;
    max-width: 100%;
    justify-self: start;
  }
  /* The label itself hugs the dropdown too: a full-width label
     forwards hover to the select from anywhere in the row, so the
     control answers the pointer from empty space. */
  #sec-banner label:has(#f-duration) {
    width: fit-content;
  }
  /* Author display:inline-flex beats the UA [hidden] rule — re-hide the
     Remove button until a banner exists to remove. */
  #announce-clear[hidden] {
    display: none;
  }
  /* The live preview wears the homepage note's look — the taped-up card,
     not a full-width bar — so what she types is what buyers will see.
     Empty means nothing showing, so the note stays out of the way. */
  #banner-preview {
    position: relative;
    width: fit-content;
    max-width: 22rem;
    box-sizing: border-box;
    margin: 1.75rem 0 2rem;
    transform: rotate(-1.2deg);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    box-shadow: var(--shadow);
    padding: 1.4rem 1.3rem 1.1rem;
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    font-size: 1.08rem;
  }
  #banner-preview[hidden] {
    display: none;
  }
  /* One masking-tape strip holding the note up. */
  #banner-preview::before {
    content: "";
    position: absolute;
    top: -0.7rem;
    left: 50%;
    width: 5.5rem;
    height: 1.4rem;
    transform: translateX(-50%) rotate(-4deg);
    background: color-mix(in srgb, var(--accent) 28%, transparent);
    opacity: 0.85;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
  }
  /* Reduced motion keeps the note planted straight. */
  @media (prefers-reduced-motion: reduce) {
    #banner-preview {
      transform: none;
    }
  }
</style>
