---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Artist Studio — Admin" wordmark="admin">
  <main class="admin" id="main">
    <p id="admin-status" role="status" data-tone="ok"></p>

    <div class="admin-grid">
    <section class="card" id="sec-add">
      <h2>Add a painting</h2>
      <button type="button" id="add-toggle" class="primary">Add new painting</button>
      <p class="hint" id="add-preview-note" hidden></p>
      <form id="upload-form" hidden>
        <label>Title
          <input id="f-title" name="title" type="text" autocomplete="off" required maxlength="120" />
        </label>
        <label>Price (CAD)
          <input id="f-price" name="price" type="number" min="1" step="0.01" inputmode="decimal" required />
        </label>
        <div class="row">
          <label>Width (in)
            <input id="f-w" name="width" type="number" min="1" step="0.5" inputmode="decimal" placeholder="24" />
          </label>
          <label>Height (in)
            <input id="f-h" name="height" type="number" min="1" step="0.5" inputmode="decimal" placeholder="36" />
          </label>
          <label>Depth (in)
            <input id="f-d" name="depth" type="number" min="0.5" step="0.5" inputmode="decimal" placeholder="1.5" />
          </label>
        </div>
        <p class="hint">Measure with a tape — buyers ask, shippers need it, and the wall preview needs it for true size.</p>
        <label class="check"><input id="f-ar" type="checkbox" checked /> Build a 3D “view on your wall” preview (recommended)</label>
        <div id="ar-try-row" hidden>
          <div class="row">
            <button type="button" id="ar-try">Try the wall preview</button>
          </div>
          <p class="hint">Builds the true-size preview from the photo above — nothing publishes until Save.</p>
        </div>
        <div id="ar-preview" hidden></div>
        <label>Alt text (describe the art)
          <input id="f-alt" name="alt" type="text" autocomplete="off" maxlength="200" />
        </label>
        <label>Description
          <textarea id="f-desc" name="description" rows="3" maxlength="2000"></textarea>
        </label>
        <label>Photo from your phone
          <input id="photo-file" type="file" accept="image/jpeg,image/png,image/webp,image/heic" capture="environment" />
        </label>
        <div class="row" id="photo-tools" hidden>
          <button type="button" id="rotate-90">Rotate ↻</button>
          <button type="button" id="rotate-270">Rotate ↺</button>
        </div>
        <figure>
          <img id="photo-preview" alt="Photo preview" hidden />
          <figcaption id="photo-meta"></figcaption>
        </figure>
        <div id="add-preview" hidden>
          <p class="hint">Preview — roughly how the gallery card will look.</p>
          <div class="pv-mat"><img id="pv-img" alt="" /></div>
          <p class="pv-title" id="pv-title"></p>
          <p class="pv-sub" id="pv-sub"></p>
        </div>
        <button type="submit" class="primary">Save painting</button>
      </form>
    </section>

    <section class="card" id="share-panel" hidden>
      <h2>Tell social media</h2>
      <textarea id="share-caption" rows="8"></textarea>
      <div class="row">
        <button type="button" id="share-native" class="primary">Share…</button>
        <button type="button" id="share-copy">Copy caption</button>
        <button type="button" id="notify-collectors">Notify collectors</button>
      </div>
      <p class="hint" id="collectors-hint"></p>
      <p class="hint">
        “Share…” opens the iPhone/iPad share sheet — post straight to Instagram or Facebook.
        No business account needed.
        “Notify collectors” is separate: it sends a phone alert to visitors who tapped
        “Notify me” — not email, and nothing to do with the inbox notes buyers send you.
      </p>
    </section>

    <section class="card" id="sec-collection">
      <h2>Collection <button type="button" id="collection-refresh" hidden>Retry</button></h2>
      <p class="hint"><a href="/#collection">Open the collection</a> to see what buyers see — then come back here and tap Edit here on any piece below.</p>
      <ul id="edit-list"><li>Loading…</li></ul>
    </section>

    <section class="card" id="sec-banner">
      <h2>Homepage banner</h2>
      <p class="hint">One banner at a time under the gallery — markets, holidays, “studio open”. Saving replaces it; empty hides it. Banners usually end on their own, so a forgotten one doesn't linger.</p>
      <label>Announcement
        <input id="f-announce" type="text" maxlength="280" placeholder="Find me at the Lilac Festival this Sunday!" />
      </label>
      <label>Show until
        <select id="f-duration">
          <option value="">No end date</option>
          <option value="1">1 day</option>
          <option value="3">3 days</option>
          <option value="7" selected>7 days</option>
          <option value="14">2 weeks</option>
        </select>
      </label>
      <p class="hint" id="announce-meta"></p>
      <button type="button" id="announce-save" class="primary">Update banner</button>
    </section>

    <section class="card" id="sec-views">
      <h2>Most viewed <button type="button" id="views-refresh" hidden>Retry</button></h2>
      <p class="hint">Past 30 days, from Cloudflare Analytics.</p>
      <ul id="views-list"><li>Loading…</li></ul>
    </section>

    <section class="card" id="sec-info">
      <h2>Good to know</h2>
      <p class="hint">When a buyer taps Send on a painting page, their note arrives straight in your inbox — just reply to it like any email (the reply goes to the buyer). Nothing is kept on the site, so there is no inbox here. After shipping, open the piece and mark it sold.</p>
      <ul>
        <li><a href="https://chitchats.com/" rel="noopener">Chit Chats</a> — cheapest tracked Canada/US shipping from Calgary.</li>
        <li><a href="https://www.pirateship.com/" rel="noopener">Pirate Ship</a> — backup for US labels.</li>
      </ul>
      <p class="hint" id="ship-flags">In-house Shippo labels are <span id="flag-shippo">…</span>; Stripe checkout is <span id="flag-stripe">…</span>.</p>
      <details>
        <summary>Advanced</summary>
        <p class="hint">
          Email alerts <span id="flag-email">…</span> · iOS push <span id="flag-push">…</span> ·
          auto-post <span id="flag-social">…</span>
        </p>
        <label>Local API token (only needed on this device if Access is off)
          <input id="admin-token" type="password" autocomplete="off" />
        </label>
        <p class="hint">
          This browser can keep working offline: <span id="cap-sw">…</span> ·
          sending in the background: <span id="cap-sync">…</span> ·
          network: <span id="cap-net">…</span>
        </p>
      </details>
    </section>
    </div>
  </main>
</Layout>

<script src="../components/AdminPanel.ts"></script>

<style>
  .admin { max-width: 64rem; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  #admin-status {
    margin: 0 0 1.5rem; padding: 0.8rem 1.1rem; border-radius: var(--radius);
    border: 1px solid var(--line); background: var(--card);
    font-size: 0.95rem;
    /* Errors land where she is looking, not at the top of a long page. */
    position: sticky; bottom: 1rem; z-index: 6; box-shadow: var(--shadow);
  }
  #admin-status[data-tone="error"] {
    border-color: rgb(140 29 24 / 0.4); background: rgb(140 29 24 / 0.08); color: inherit;
  }
  /* The status line starts empty (no blurb) and only appears once the
     studio has something to say. */
  #admin-status:empty { display: none; }
  /* Collapsed Settings ("Advanced" drawer): the summary wears the h2 style
     so the closed card still reads as a section header. */
  .card summary {
    font-family: Georgia, "Iowan Old Style", Charter, serif; font-weight: 500;
    font-size: 1.4rem; cursor: pointer; border-radius: 0.25rem;
    padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); margin-bottom: 1rem;
    list-style: none;
  }
  .card summary::-webkit-details-marker { display: none; }
  /* Custom disclosure mark: a chevron that turns down when open. */
  .card summary::before {
    content: ">"; color: var(--accent); font-weight: 700;
    margin-right: 0.6rem; display: inline-block;
    transition: transform 0.2s ease;
  }
  .card details[open] summary::before { transform: rotate(90deg); }
  @media (prefers-reduced-motion: reduce) {
    .card summary::before { transition: none; }
  }
  .card summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .card {
    background: var(--card); border: 1px solid var(--line);
    border-radius: 1rem; box-shadow: var(--shadow);
    padding: clamp(1.25rem, 3vw, 2rem);
    margin-block: 1.5rem;
  }
  .card h2 {
    font-family: Georgia, "Iowan Old Style", Charter, serif; font-weight: 500;
    margin: 0 0 0.75rem;
    font-size: 1.4rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
    padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); margin-bottom: 1rem;
  }
  label { display: grid; gap: 0.35rem; margin-block: 0.75rem; font-size: 0.9rem; font-weight: 600; }
  input, textarea, select {
    width: 100%; box-sizing: border-box; font: inherit; font-weight: 400; font-size: 0.95rem;
    padding: 0.65rem 0.8rem; border-radius: 0.6rem;
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
    min-height: 3rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  input:hover, textarea:hover, select:hover { border-color: var(--muted); }
  /* The picker is a button, not a text field: size + cursor say so. */
  input[type="file"] { width: auto; max-width: 100%; cursor: pointer; }
  /* Author flex beats the UA [hidden] rule — re-hide like the h2 buttons. */
  #photo-tools[hidden] { display: none; }
  /* Studio links animate; visited never goes browser-blue. */
  .admin a { transition: color 0.2s ease; }
  .admin a:hover { color: var(--ink); }
  /* View bars: one accent row per painting, scaled to the top piece. */
  .view-bar {
    display: block; height: 0.45rem; margin-top: 0.35rem;
    border-radius: 999px; background: rgb(255 255 255 / 0.08);
    overflow: hidden;
  }
  .view-bar > span { display: block; height: 100%; background: var(--accent); border-radius: 999px; }
  input:focus-visible, textarea:focus-visible, select:focus-visible, button:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 2px;
  }
  input:focus, textarea:focus { border-color: var(--accent); }
  .row { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-block: 0.75rem; align-items: center; }
  .row label { flex: 1 1 8rem; margin-block: 0; }
  button {
    font: inherit; font-size: 0.92rem; font-weight: 600;
    min-height: 2.9rem; padding: 0.55rem 1.2rem;
    border-radius: 0.75rem; border: 1px solid var(--line);
    background: var(--paper); color: var(--ink); cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background-color 0.25s ease, border-color 0.25s ease,
      color 0.25s ease, transform 0.2s ease;
  }
  button:hover { border-color: var(--ink); transform: translateY(-1px); }
  button:active { transform: none; }
  button.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  button.primary:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .card h2 button { min-height: 2.2rem; padding: 0.25rem 0.9rem; font-size: 0.82rem; margin-left: auto; }
  /* Author display:inline-flex beats the UA [hidden] rule — re-hide. */
  .card h2 button[hidden] { display: none; }
  #photo-preview {
    max-width: 100%; border-radius: 0.6rem; margin-top: 0.5rem;
    border: 1px solid var(--line);
  }
  figure { margin: 0.75rem 0 0; }
  figcaption { font-size: 0.85rem; color: var(--muted); margin-top: 0.35rem; }
  figcaption:empty { display: none; }
  .hint { font-size: 0.88rem; color: var(--muted); }
  .check { display: flex; gap: 0.6rem; align-items: center; font-weight: 600; }
  .check input { width: auto; min-height: 1.4rem; accent-color: var(--accent); }
  #ar-preview { margin-top: 0.75rem; }
  #views-list, #edit-list { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; gap: 0.5rem; }
  #views-list li, #edit-list li {
    list-style: none; background: var(--paper);
    border: 1px solid var(--line); border-radius: 0.75rem;
    padding: 0.7rem 1rem; font-size: 0.92rem;
  }
  #edit-list label { display: grid; gap: 0.3rem; margin-block: 0.6rem; font-size: 0.85rem; font-weight: 600; }
  #edit-list input, #edit-list textarea {
    width: 100%; box-sizing: border-box; font: inherit; font-weight: 400; font-size: 0.9rem;
    padding: 0.55rem 0.7rem; border-radius: 0.5rem;
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
  }
  #edit-list .row { display: flex; gap: 0.45rem; flex-wrap: wrap; margin: 0.6rem 0 0; }
  #edit-list .row label { flex: 1 1 8rem; margin-block: 0; }
  #edit-list .check { display: flex; gap: 0.6rem; align-items: center; font-weight: 600; }
  #edit-list .check input { width: auto; accent-color: var(--accent); }
  /* Add-form preview: quiet echo of the gallery card. */
  #add-preview { margin: 0.75rem 0 0; max-width: 22rem; }
  #add-preview .hint { margin: 0 0 0.5rem; }
  #add-preview .pv-mat {
    background: var(--card); border: 1px solid var(--line);
    border-radius: 0.5rem; padding: 0.75rem;
    box-shadow: var(--shadow);
  }
  #add-preview .pv-mat img { display: block; width: 100%; height: auto; border-radius: 0.25rem; }
  /* Author display beats the UA [hidden] rule — re-hide the empty preview. */
  #add-preview .pv-mat img[hidden] { display: none; }
  #add-preview .pv-title {
    margin: 0.6rem 0 0.15rem;
    font-family: Georgia, "Iowan Old Style", Charter, serif; font-size: 1.2rem;
  }
  #add-preview .pv-sub { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .card ul a { color: var(--accent); }
  /* No browser-blue links anywhere in the studio: visited matches unvisited. */
  .admin a, .admin a:visited { color: var(--accent); }
  /* Dashboard grid: one column on phones, two on desktop with the wide
     working sections (Add, share, Collection) spanning both. */
  @media (min-width: 60rem) {
    .admin-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 0 1.5rem; align-items: start;
    }
    #share-panel, #sec-collection { grid-column: 1 / -1; }
  }
  .card { scroll-margin-top: 7rem; }
</style>
