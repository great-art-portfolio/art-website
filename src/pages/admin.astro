---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { groupByAvailability, slugifyTitle } from "../lib/site";
import { studioRowHtml } from "../lib/studio-rows";

// Baked in at build time so the list and links work everywhere, even with
// no publishing backend (dev). The full editable fields ride along so the
// dev list supports practice edits and deletes without any API.
const localCollection = (await getCollection("paintings")).map((p) => ({
  slug: slugifyTitle(p.data.title),
  title: p.data.title,
  price: p.data.price,
  sold: p.data.sold,
  alt: p.data.alt,
  description: p.body,
  widthIn: p.data.widthIn ?? null,
  heightIn: p.data.heightIn ?? null,
  depthIn: p.data.depthIn ?? null,
  draft: p.data.draft === true,
  image: p.data.image.src,
  mdPath: `src/content/paintings/${p.id.endsWith(".md") ? p.id : `${p.id}.md`}`,
  // View counts arrive client-side, after the rows — zero here keeps the
  // static markup identical to the first hydrated render.
  views: 0,
}));
const localJson = JSON.stringify(localCollection).replace(/</g, "\\u003c");

// First paint renders these rows as static markup — the script hydrates
// over identical HTML, so loading never grows the card or shoves the page
// (no skeleton flash, no cumulative layout shift).
const flatCollection = [...localCollection].sort((a, b) =>
  a.title.localeCompare(b.title),
);
const ssrDrafts = flatCollection.filter((p) => p.draft);
const ssrGroups = groupByAvailability(flatCollection.filter((p) => !p.draft));
// Row HTML comes from the same renderer the client uses, so hydration
// swaps identical markup.
const availableHtml =
  ssrGroups.available.length === 0
    ? `<li class="list-plain">Nothing available right now.</li>`
    : ssrGroups.available.map(studioRowHtml).join("");
const draftsHtml = ssrDrafts.map(studioRowHtml).join("");
const soldHtml = ssrGroups.sold.map(studioRowHtml).join("");
---

<Layout title="Artist Studio — Admin" wordmark="admin">
  <main class="admin" id="main">
    <p id="admin-status" role="status" data-tone="ok"></p>

    <div class="admin-grid">
      <section class="card" id="share-panel" hidden>
        <h2>Tell social media</h2>
        <textarea id="share-caption" rows="8"></textarea>
        <div class="row">
          <button type="button" id="share-native" class="primary">Share…</button
          >
          <button type="button" id="share-copy">Copy caption</button>
          <button type="button" id="notify-collectors">Notify collectors</button
          >
        </div>
        <p class="hint" id="collectors-hint"></p>
        <p class="hint">
          “Share…” opens the iPhone/iPad share sheet — post straight to
          Instagram or Facebook. No business account needed. “Notify collectors”
          is separate: one tap alerts the whole collectors list — a phone alert
          for “Notify me” taps, an email for the email list. Nothing to do with
          the inbox notes buyers send you.
        </p>
      </section>

      <section class="card" id="sec-collection">
        <h2>
          <span id="collection-title">Collection</span>
          <span id="collection-dev" hidden
            >(Development only — changes aren't persisted)</span
          >
          <button type="button" id="collection-refresh" hidden>Retry</button>
        </h2>
        <ul id="edit-list">
          <li class="list-group" data-group="available">
            <div class="list-sub"><h3>Available</h3></div>
            <ul class="group-rows" set:html={availableHtml} />
          </li>
          {
            (ssrDrafts.length > 0 || ssrGroups.sold.length > 0) && (
              <li class="list-group" data-group="later">
                {ssrDrafts.length > 0 && (
                  <>
                    <div class="list-sub">
                      <h3>Drafts</h3>
                    </div>
                    <ul class="group-rows" set:html={draftsHtml} />
                  </>
                )}
                {ssrGroups.sold.length > 0 && (
                  <>
                    <div class="list-sub">
                      <h3>Sold</h3>
                    </div>
                    <ul class="group-rows" set:html={soldHtml} />
                  </>
                )}
              </li>
            )
          }
        </ul>
        <button type="button" id="practice-reset" hidden
          >Clear practice changes</button
        >
        <script
          is:inline
          type="application/json"
          id="local-collection"
          set:html={localJson}
        />
        <div id="row-confirm" hidden>
          <div
            role="dialog"
            aria-modal="true"
            aria-labelledby="row-confirm-title"
            class="confirm-card"
          >
            <h2 id="row-confirm-title">Delete this painting?</h2>
            <p id="row-confirm-body">
              This removes it from the site. It stays recoverable in the repo
              history.
            </p>
            <div class="confirm-actions">
              <button type="button" id="row-confirm-no">Keep it</button>
              <button type="button" id="row-confirm-yes" disabled>Delete</button
              >
            </div>
          </div>
        </div>
      </section>

      <section class="card" id="sec-banner">
        <h2>Homepage banner</h2>
        <p class="hint">
          One banner at a time under the gallery — markets, holidays, “studio
          open”. Saving replaces it; empty hides it. Banners usually end on
          their own, so a forgotten one doesn't linger.
        </p>
        <label
          >Announcement
          <input
            id="f-announce"
            type="text"
            maxlength="280"
            placeholder="Find me at the Lilac Festival this Sunday!"
          />
        </label>
        <label
          >Show until
          <select id="f-duration">
            <option value="">No end date</option>
            <option value="1">1 day</option>
            <option value="3">3 days</option>
            <option value="7" selected>7 days</option>
            <option value="14">2 weeks</option>
          </select>
        </label>
        <div class="row">
          <button type="button" id="announce-save" class="primary"
            >Update banner</button
          >
          <p class="hint" id="announce-meta"></p>
        </div>
      </section>

      <section class="card" id="sec-info">
        <h2>Good to know</h2>
        <p class="hint">
          When a buyer taps Send on a painting page, their note lands straight
          in your inbox — hit reply and it goes to them. Send it from your
          author@barbart.ca email address. After shipping, open the piece and
          mark it sold.
        </p>
        <ul>
          <li>
            <a href="https://chitchats.com/" rel="noopener">Chit Chats</a> — cheapest
            tracked Canada/US shipping.
          </li>
          <li>
            <a href="https://www.pirateship.com/" rel="noopener">Pirate Ship</a> —
            backup for US labels.
          </li>
        </ul>
        <p class="hint" id="ship-flags" hidden>
          In-house Shippo labels are <span id="flag-shippo">…</span>; Stripe
          checkout is <span id="flag-stripe">…</span>.
        </p>
        <details>
          <summary>Advanced Settings</summary>
          <p class="hint">
            Email alerts <span id="flag-email">…</span> · iOS push <span
              id="flag-push">…</span
            > · auto-post <span id="flag-social">…</span>
          </p>
          <label
            >Local API token (only needed on this device if Access is off)
            <input id="admin-token" type="password" autocomplete="off" />
          </label>
          <p class="hint">
            This browser can keep working offline: <span id="cap-sw">…</span> · sending
            in the background: <span id="cap-sync">…</span> · network: <span
              id="cap-net">…</span
            >
          </p>
        </details>
      </section>
    </div>
  </main>
</Layout>

<script src="../components/AdminPanel.ts"></script>

<style>
  .admin {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  /* Toast fixed to the viewport: errors find her wherever she is
     scrolled. Empty (no message) means gone entirely. */
  #admin-status {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    bottom: max(1rem, env(safe-area-inset-bottom, 1rem));
    width: min(36rem, calc(100% - 2rem));
    z-index: 40;
    margin: 0;
    padding: 0.8rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--card);
    font-size: 0.95rem;
    box-shadow: var(--shadow);
  }
  /* Gentle rise on every new message, re-triggered from the panel. */
  #admin-status.toast-in {
    animation: toast-in 0.25s ease;
  }
  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translate(-50%, 0.5rem);
    }
  }
  /* The Add form arrives as one calm motion: the card expands and fades,
     with no per-field stagger to fall out of sync on the way back out. */
  #admin-status[data-tone="error"] {
    border-color: rgb(140 29 24 / 0.4);
    background: rgb(140 29 24 / 0.08);
    color: inherit;
  }
  /* The status line starts empty (no blurb) and only appears once the
     studio has something to say. */
  #admin-status:empty {
    display: none;
  }
  /* Collapsed Settings ("Advanced" drawer): the summary wears the h2 style
     so the closed card still reads as a section header. */
  .card summary {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    font-weight: 500;
    font-size: 1.4rem;
    cursor: pointer;
    border-radius: 0.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    margin: 1.5rem 0 1rem;
    list-style: none;
  }
  .card summary::-webkit-details-marker {
    display: none;
  }
  /* Custom disclosure mark: a chevron that turns down when open. */
  .card summary::before {
    content: ">";
    color: var(--accent);
    font-weight: 700;
    margin-right: 0.6rem;
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .card details[open] summary::before {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .card summary::before {
      transition: none;
    }
  }
  .card summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Advanced drawer eases open where the browser allows it; elsewhere it
     simply appears, as before. */
  #sec-info details {
    interpolate-size: allow-keywords;
  }
  #sec-info details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.35s ease,
      content-visibility 0.35s ease;
    transition-behavior: allow-discrete;
  }
  #sec-info details[open]::details-content {
    block-size: auto;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 1rem;
    box-shadow: var(--shadow);
    padding: clamp(1.25rem, 3vw, 2rem);
    margin-block: 1.5rem;
  }
  .card h2 {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    font-weight: 500;
    margin: 0 0 0.75rem;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1rem;
  }
  label {
    display: grid;
    gap: 0.35rem;
    margin-block: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  input,
  textarea,
  select {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    font-weight: 400;
    font-size: 0.95rem;
    padding: 0.65rem 0.8rem;
    border-radius: 0.6rem;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    min-height: 3rem;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  input:hover,
  textarea:hover,
  select:hover {
    border-color: var(--muted);
  }
  /* Browsers forward label hover to the field — hovering "Announcement"
     must not warm its box. Only the field itself earns the hover. */
  label:hover input:not(:hover),
  label:hover textarea:not(:hover),
  label:hover select:not(:hover) {
    border-color: var(--line);
  }
  /* The dropdown is a choice, not typing — it gets the pointer finger. */
  select {
    cursor: pointer;
  }
  /* Studio links behave exactly like the footer: accent always, only
     the underline fades in on hover — never a color flash. */
  .admin a {
    transition: text-decoration-color 0.12s ease;
    text-decoration: underline transparent;
    text-underline-offset: 3px;
  }
  .admin a:hover {
    text-decoration-color: currentColor;
  }
  /* Row view counts: quiet follow-on to the price, gone entirely
     until the counts arrive (no flash, no shove). */
  :global(#edit-list .row-views:empty) {
    display: none;
  }
  :global(#edit-list .row-views) {
    color: var(--muted);
    font-size: 0.85rem;
  }
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* One ring only: inputs show this outline on any focus, so it never
     doubles up with a border change (which is why this rule replaces it). */
  input:focus,
  textarea:focus,
  select:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-block: 0.75rem;
    align-items: center;
  }
  .row label {
    flex: 1 1 8rem;
    margin-block: 0;
  }
  button {
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    min-height: 2.9rem;
    padding: 0.55rem 1.2rem;
    border-radius: 0.75rem;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.2s ease;
  }
  button:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
  }
  button:active {
    transform: none;
  }
  button.primary {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  button.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .card h2 button {
    min-height: 2.2rem;
    padding: 0.25rem 0.9rem;
    font-size: 0.82rem;
    margin-left: auto;
  }
  /* Author display:inline-flex beats the UA [hidden] rule — re-hide. */
  .card h2 button[hidden] {
    display: none;
  }
  /* Reduced motion kills movement, not gentle fades: lifts go instant,
     while color and opacity transitions still run — snapping colors is
     itself jarring. */
  @media (prefers-reduced-motion: reduce) {
    #admin-status.toast-in {
      animation: none;
    }
    button:hover {
      transform: none;
    }
    #sec-info details::details-content {
      transition: none;
    }
  }
  .hint {
    font-size: 0.88rem;
    color: var(--muted);
  }
  /* Banner status sits beside its button, never above it. */
  #announce-meta {
    margin: 0;
  }
  #announce-meta:empty {
    display: none;
  }
  #edit-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  /* Group shells vanish on phones so every row flows in one list;
     on desktop they become the two equal-height columns. */
  :global(#edit-list .list-group) {
    display: contents;
  }
  :global(#edit-list .group-rows) {
    display: contents;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  #sec-info ul {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  /* Rows and fields are built by script after load, so they never carry
     the scope attribute — whole-selector :global keeps them styled. */
  :global(#edit-list li.row-card) {
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 0.7rem 1rem;
    font-size: 0.92rem;
  }
  :global(#edit-list li a),
  :global(#edit-list li a:visited) {
    color: var(--accent);
    text-decoration: underline transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.12s ease;
  }
  :global(#edit-list li a:hover) {
    text-decoration-color: currentColor;
  }
  /* Subheadings and plain notes sit in the list unboxed. */
  :global(#edit-list .list-sub),
  :global(#edit-list .list-plain) {
    background: none;
    border: none;
    padding: 0.5rem 0 0;
  }
  :global(#edit-list .list-sub h3) {
    font-family: Georgia, "Iowan Old Style", Charter, serif;
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0;
  }
  :global(#edit-list .list-plain) {
    color: var(--muted);
    font-size: 0.92rem;
  }
  /* Per-row delete: a quiet text button, never a red box — the
     confirmation modal carries the warning in words. */
  :global(#edit-list .row-del) {
    font: inherit;
    font-size: 0.85rem;
    background: none;
    border: none;
    padding: 0;
    min-height: 0;
    color: var(--muted);
    text-decoration: underline transparent;
    text-underline-offset: 3px;
    cursor: pointer;
    justify-self: start;
    transition:
      color 0.2s ease,
      text-decoration-color 0.12s ease;
  }
  :global(#edit-list .row-del:hover) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  /* Row delete confirmation: a plain-words modal in the middle of the
     screen. It appears instantly under every motion setting — no
     entrance animation to wait through or disable. */
  #row-confirm {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.6);
    z-index: 60;
  }
  #row-confirm[hidden] {
    display: none;
  }
  .confirm-card {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.5rem;
    max-width: 26rem;
    width: 100%;
    box-sizing: border-box;
  }
  .confirm-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }
  .confirm-card p {
    margin: 0 0 1.25rem;
  }
  .confirm-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }
  #row-confirm-yes:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  :global(#edit-list .row-del:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  /* Rows carry a thumbnail, so she sees the piece without remembering
     its name. Practice rows (dev) reuse the same shape. */
  :global(#edit-list li.row-card) {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }
  :global(#edit-list img.thumb) {
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--line);
    flex-shrink: 0;
    background: var(--card);
  }
  :global(#edit-list .row-body) {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    /* Links hug their text: empty space beside a title stays dead. */
    justify-items: start;
  }
  :global(#edit-list .row-photo) {
    display: inline-flex;
    border-radius: 0.5rem;
  }
  :global(#edit-list .row-photo:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  :global(#edit-list .row-edit) {
    font-size: 0.85rem;
  }
  /* Edit and Delete ride side by side, each with its own small icon. */
  :global(#edit-list .row-actions) {
    display: flex;
    gap: 1.2rem;
    align-items: center;
  }
  :global(#edit-list .row-edit),
  :global(#edit-list .row-del) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  :global(#edit-list .ico) {
    flex-shrink: 0;
  }
  /* Deferred reveals fade in instead of snapping. Opacity-only, so it
     stays gentle under reduced motion too. */
  .fade-in {
    animation: fade-in 0.4s ease;
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  #practice-reset {
    margin-top: 0.75rem;
  }
  #practice-reset[hidden] {
    display: none;
  }
  .card ul a {
    color: var(--accent);
  }
  /* No browser-blue links anywhere in the studio: visited matches unvisited. */
  .admin a,
  .admin a:visited {
    color: var(--accent);
  }
  /* Dashboard grid: one column on phones, two on desktop with the wide
     working sections (share, Collection) spanning both. */
  @media (min-width: 60rem) {
    .admin-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 1.5rem;
      align-items: start;
    }
    #share-panel,
    #sec-collection {
      grid-column: 1 / -1;
    }
    /* Collection groups sit side by side — Available on the left,
       Drafts/Sold on the right — as equal-height columns split by one
       hairline. Grid stretch keeps them level whatever each holds. */
    #edit-list {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      align-items: stretch;
    }
    /* One group alone takes the whole card — no empty half. */
    :global(#edit-list .list-group:only-child) {
      grid-column: 1 / -1;
    }
    :global(#edit-list .list-group) {
      display: grid;
      gap: 0.5rem;
      align-content: start;
      min-width: 0;
    }
    /* A real grid of paintings, not a 1D list: roomy cards with the
       photo on top, flowing into as many columns as fit. */
    :global(#edit-list .group-rows) {
      display: grid;
      gap: 0.75rem;
      grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    }
    :global(#edit-list li.row-card) {
      display: grid;
      align-content: start;
      gap: 0.6rem;
    }
    :global(#edit-list img.thumb) {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
    }
    :global(#edit-list .list-group[data-group="later"]) {
      border-left: 1px solid var(--line);
      padding-left: 1.5rem;
    }
  }
  .card {
    scroll-margin-top: 7rem;
  }
</style>
