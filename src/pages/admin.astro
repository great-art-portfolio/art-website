---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { readdirSync } from "node:fs";
import {
  compareGalleryOrder,
  groupByAvailability,
  slugifyTitle,
} from "../lib/site";
import { studioRowHtml } from "../lib/studio-rows";
import "../components/studio.css";

// Astro lowercases content ids (img_5667.md) while the repo path stays
// case-sensitive (IMG_5667.md). Resolve the true filename at build time
// so baked rows match the API rows exactly — no re-render flicker — and
// row deletes point at a file that exists.
const diskNames = new Map(
  readdirSync("src/content/paintings").map((f) => [f.toLowerCase(), f]),
);
const mdFile = (id: string): string => {
  const withExt = id.endsWith(".md") ? id : `${id}.md`;
  return diskNames.get(withExt.toLowerCase()) ?? withExt;
};

// Baked in at build time so the list and links work everywhere, even with
// no publishing backend (dev). The full editable fields ride along so the
// dev list supports practice edits and deletes without any API.
const localCollection = (await getCollection("paintings")).map((p) => ({
  slug: slugifyTitle(p.data.title),
  title: p.data.title,
  price: p.data.price,
  sold: p.data.sold,
  alt: p.data.alt,
  description: p.body,
  widthIn: p.data.widthIn ?? null,
  heightIn: p.data.heightIn ?? null,
  depthIn: p.data.depthIn ?? null,
  draft: p.data.draft === true,
  publishOn: p.data.publishOn ?? "",
  trash: p.data.trash === true,
  trashedAt: p.data.trashedAt ?? "",
  image: p.data.image.src,
  order: p.data.order ?? null,
  mdPath: `src/content/paintings/${mdFile(p.id)}`,
  // View counts arrive client-side, after the rows — zero here keeps the
  // static markup identical to the first hydrated render.
  views: 0,
}));
const localJson = JSON.stringify(localCollection).replace(/</g, "\\u003c");

// First paint renders these rows as static markup — the script hydrates
// over identical HTML, so loading never grows the card or shoves the page
// (no skeleton flash, no cumulative layout shift).
const byTitle = (a: { title: string }, b: { title: string }): number =>
  a.title.localeCompare(b.title);
const live = localCollection.filter((p) => !p.trash);
const ssrTrash = [...localCollection].filter((p) => p.trash).sort(byTitle);
const ssrDrafts = [...live].filter((p) => p.draft).sort(byTitle);
const ssrGroups = groupByAvailability(live.filter((p) => !p.draft));
const ssrAvailable = [...ssrGroups.available].sort(compareGalleryOrder);
// Sold drags just like Available, so the static rows already follow the
// drag order (frontmatter `order:`), not the alphabet.
const ssrSold = [...ssrGroups.sold].sort(compareGalleryOrder);
const ssrDraftCount = ssrDrafts.length;
const ssrDraftLabel =
  ssrDraftCount === 1 ? "1 draft" : `${ssrDraftCount} drafts`;
// Row HTML comes from the same renderer the client uses, so hydration
// swaps identical markup.
const availableHtml =
  ssrAvailable.length === 0
    ? `<li class="list-plain">Nothing available right now.</li>`
    : ssrAvailable.map(studioRowHtml).join("");
const draftsHtml = ssrDrafts.map(studioRowHtml).join("");
const soldHtml = ssrSold.map(studioRowHtml).join("");
const soldCount = ssrSold.length;
const soldLabel = soldCount === 1 ? "1 sold" : `${soldCount} sold`;
const trashHtml = ssrTrash.map(studioRowHtml).join("");
const trashCount = ssrTrash.length;
const trashLabel = trashCount === 1 ? "1 trashed" : `${trashCount} trashed`;
---

<Layout title="Artist Studio — Admin" wordmark="admin">
  <main class="admin" id="main">
    <h2>
      <span id="collection-title">Available</span>
      <span id="collection-dev" hidden
        >(Development only — changes aren't persisted)</span
      >
      <button type="button" id="collection-refresh" hidden>Retry</button>
    </h2>
    <ul id="edit-list">
      <li class="list-group" data-group="available">
        <ul class="group-rows" set:html={availableHtml} />
      </li>
      {
        ssrDrafts.length > 0 && (
          <details class="drafts-fold" data-group="drafts" open>
            <summary>{ssrDraftLabel}</summary>
            <ul class="group-rows" set:html={draftsHtml} />
          </details>
        )
      }
      {
        soldCount > 0 && (
          <details class="sold-fold" data-group="sold" open>
            <summary>{soldLabel}</summary>
            <ul class="group-rows" set:html={soldHtml} />
          </details>
        )
      }
      {
        trashCount > 0 && (
          <details class="trash-fold" data-group="trash">
            <summary>{trashLabel}</summary>
            <div class="fold-tools">
              <button type="button" class="row-empty">
                Empty trash
              </button>
            </div>
            <p class="hint">
              Anything here over 30 days old clears itself. Deleted forever is
              forever.
            </p>
            <ul class="group-rows" set:html={trashHtml} />
          </details>
        )
      }
    </ul>
    <button type="button" id="practice-reset" hidden
      >Clear practice changes</button
    >
    <script
      is:inline
      type="application/json"
      id="local-collection"
      set:html={localJson}
    />
    <div id="row-confirm" hidden>
      <div
        role="dialog"
        aria-modal="true"
        aria-labelledby="row-confirm-title"
        class="confirm-card"
      >
        <h2 id="row-confirm-title">Move to trash?</h2>
        <p id="row-confirm-body">
          This removes it from the site. Anything in trash restores in one tap,
          for 30 days.
        </p>
        <div class="confirm-actions">
          <button type="button" id="row-confirm-no">Keep it</button>
          <button type="button" id="row-confirm-yes" disabled
            >Move to trash</button
          >
        </div>
      </div>
    </div>
  </main>
</Layout>

<script src="../components/AdminPanel.ts"></script>

<style>
  /* Collection page keeps its own list/row/fold styles below. Shared
     studio primitives (headings, forms, buttons, drawer summaries)
     live in components/studio.css; the header owns the section nav
     and the toast. */
  /* Dev-only suffix rides under the heading as small muted words,
     never a second headline — and never in production (hidden). */
  :global(#collection-dev) {
    flex-basis: 100%;
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--muted);
  }
  /* Row view counts: quiet follow-on to the price, gone entirely
     until the counts arrive (no flash, no shove). */
  :global(#edit-list .row-views:empty) {
    display: none;
  }
  :global(#edit-list .row-views) {
    color: var(--muted);
    font-size: 0.85rem;
  }
  /* Reduced motion kills movement, not gentle fades — folds open
     instantly here; color and opacity transitions still run. */
  @media (prefers-reduced-motion: reduce) {
    :global(#edit-list .sold-fold::details-content),
    :global(#edit-list .drafts-fold::details-content),
    :global(#edit-list .trash-fold::details-content) {
      transition: none;
    }
  }
  #edit-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  /* Group shells vanish on phones so every row flows in one list;
     on desktop Available becomes the card grid, with the Drafts and
     Sold folds stacked below it. */
  :global(#edit-list .list-group) {
    display: contents;
  }
  :global(#edit-list .group-rows) {
    display: contents;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  /* Folds unfold instead of snapping — the same allow-keywords ease the
     Advanced drawer uses. Where the browser can't interpolate, opening
     and closing simply appear, as before. */
  :global(#edit-list .sold-fold),
  :global(#edit-list .drafts-fold),
  :global(#edit-list .trash-fold) {
    interpolate-size: allow-keywords;
  }
  :global(#edit-list .sold-fold::details-content),
  :global(#edit-list .drafts-fold::details-content),
  :global(#edit-list .trash-fold::details-content) {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.35s ease,
      content-visibility 0.35s ease;
    transition-behavior: allow-discrete;
  }
  :global(#edit-list .sold-fold[open]::details-content),
  :global(#edit-list .drafts-fold[open]::details-content),
  :global(#edit-list .trash-fold[open]::details-content) {
    block-size: auto;
  }
  /* Rows and fields are built by script after load, so they never carry
     the scope attribute — whole-selector :global keeps them styled. */
  :global(#edit-list li.row-card) {
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 0.7rem 1rem;
    font-size: 0.92rem;
  }
  :global(#edit-list li a),
  :global(#edit-list li a:visited) {
    color: var(--accent);
    text-decoration: underline transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.12s ease;
  }
  :global(#edit-list li a:hover) {
    text-decoration-color: currentColor;
  }
  /* Hovering the photo lights the title too — one piece, one hover. */
  :global(#edit-list .row-card:has(.row-photo:hover) .row-title) {
    text-decoration-color: currentColor;
  }
  /* Plain notes sit in the list unboxed. */
  :global(#edit-list .list-plain) {
    background: none;
    border: none;
    padding: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  /* Per-row delete: a quiet text button, never a red box — the
     confirmation modal carries the warning in words. On hover the word
     and its trash can warm to a soft clay red (never the brand orange,
     never alarm red). */
  :global(#edit-list .row-del) {
    font: inherit;
    font-size: 0.85rem;
    background: none;
    border: none;
    padding: 0;
    min-height: 0;
    color: var(--muted);
    text-decoration: underline transparent;
    text-underline-offset: 3px;
    cursor: pointer;
    justify-self: start;
    transition:
      color 0.2s ease,
      text-decoration-color 0.12s ease;
  }
  :global(#edit-list .row-del:hover) {
    color: var(--danger);
    text-decoration-color: currentColor;
  }
  /* Restore wears the same quiet link-button shape as Delete. */
  :global(#edit-list .row-restore) {
    font: inherit;
    font-size: 0.85rem;
    background: none;
    border: none;
    padding: 0;
    min-height: 0;
    color: var(--muted);
    text-decoration: underline transparent;
    text-underline-offset: 3px;
    cursor: pointer;
    justify-self: start;
    transition:
      color 0.2s ease,
      text-decoration-color 0.12s ease;
  }
  :global(#edit-list .row-restore:hover) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  :global(#edit-list .row-restore:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  /* Fold toolbars (Empty trash) sit between the count and the rows. */
  :global(#edit-list .fold-tools) {
    margin: 0.75rem 0 0;
  }
  :global(#edit-list .row-empty) {
    min-height: 2.2rem;
    padding: 0.25rem 0.9rem;
    font-size: 0.82rem;
  }
  /* Row delete confirmation: a plain-words modal in the middle of the
     screen. It appears instantly under every motion setting — no
     entrance animation to wait through or disable. */
  #row-confirm {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.6);
    z-index: 60;
  }
  #row-confirm[hidden] {
    display: none;
  }
  /* Reorder tooltip (script-built, so a whole-selector twin): the toast's
     inverted pill, smaller, above the cards but below the modal. Instant
     show/hide — no motion to reduce — and never interactive. */
  :global(#reorder-tip) {
    position: fixed;
    z-index: 50;
    max-width: 15rem;
    margin: 0;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.85rem;
    line-height: 1.4;
    box-shadow: var(--shadow);
    pointer-events: none;
  }
  :global(#reorder-tip[hidden]) {
    display: none;
  }
  .confirm-card {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.5rem;
    max-width: 26rem;
    width: 100%;
    box-sizing: border-box;
  }
  .confirm-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }
  .confirm-card p {
    margin: 0 0 1.25rem;
  }
  .confirm-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }
  #row-confirm-yes:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  :global(#edit-list .row-del:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  /* Rows carry a thumbnail, so she sees the piece without remembering
     its name. Practice rows (dev) reuse the same shape. */
  :global(#edit-list li.row-card) {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }
  :global(#edit-list img.thumb) {
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--line);
    flex-shrink: 0;
    background: var(--card);
  }
  :global(#edit-list .row-body) {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    /* Links hug their text: empty space beside a title stays dead. */
    justify-items: start;
  }
  :global(#edit-list .row-photo) {
    display: inline-flex;
    border-radius: 0.5rem;
  }
  :global(#edit-list .row-photo:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  :global(#edit-list .row-edit) {
    font-size: 0.85rem;
  }
  /* Edit and Delete ride side by side, each with its own small icon —
     wrapping when a third action (Restore) joins them. */
  :global(#edit-list .row-actions) {
    display: flex;
    gap: 0.4rem 1.2rem;
    align-items: center;
    flex-wrap: wrap;
  }
  :global(#edit-list .row-edit),
  :global(#edit-list .row-del),
  :global(#edit-list .row-restore) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  :global(#edit-list .ico) {
    flex-shrink: 0;
  }
  /* Deferred reveals fade in instead of snapping. Opacity-only, so it
     stays gentle under reduced motion too. */
  .fade-in {
    animation: fade-in 0.4s ease;
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  #practice-reset {
    margin-top: 0.75rem;
  }
  #practice-reset[hidden] {
    display: none;
  }
  /* Collection stacks full-width on every screen: Available on top,
     then the Drafts and Sold folds below, in that order. */
  @media (min-width: 60rem) {
    #edit-list {
      gap: 1.5rem;
    }
    /* Drafts and Sold each get their own full-width row below, folded
       open by default — one tap on the count folds it away. */
    :global(#edit-list .sold-fold),
    :global(#edit-list .drafts-fold),
    :global(#edit-list .trash-fold) {
      border-top: 1px solid var(--line);
      padding-top: 1rem;
    }
    :global(#edit-list .sold-fold summary),
    :global(#edit-list .drafts-fold summary) {
      font-family: Georgia, "Iowan Old Style", Charter, serif;
      font-size: 1.4rem;
      font-weight: 500;
      cursor: pointer;
      border-radius: 0.25rem;
      /* Fold counts wear the h2 shape, minus its old hairline:
         whitespace separates the groups, not lines. */
      padding-bottom: 0;
      border-bottom: none;
      margin-bottom: 1rem;
    }
    :global(#edit-list .trash-fold summary) {
      font-family: Georgia, "Iowan Old Style", Charter, serif;
      font-size: 1.05rem;
      font-weight: 500;
      cursor: pointer;
      width: fit-content;
      border-radius: 0.25rem;
      /* Trash stays a quiet archive header: no hairline. */
      border-bottom: none;
    }
    :global(#edit-list .sold-fold summary:focus-visible),
    :global(#edit-list .drafts-fold summary:focus-visible),
    :global(#edit-list .trash-fold summary:focus-visible) {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    :global(#edit-list .sold-fold .group-rows),
    :global(#edit-list .drafts-fold .group-rows),
    :global(#edit-list .trash-fold .group-rows) {
      margin-top: 0.75rem;
    }
    /* Drag-to-reorder: grabbable cards, one accent edge where the
       card will land. Script-built classes get whole-selector twins. */
    :global(#edit-list [draggable="true"]) {
      cursor: grab;
    }
    :global(#edit-list [draggable="true"]:active) {
      cursor: grabbing;
    }
    :global(#edit-list .row-card.drop-before) {
      box-shadow: inset 0 3px 0 var(--accent);
    }
    :global(#edit-list .row-card.drop-after) {
      box-shadow: inset 0 -3px 0 var(--accent);
    }
    :global(#edit-list .list-group) {
      display: grid;
      gap: 0.5rem;
      align-content: start;
      min-width: 0;
    }
    /* A real grid of paintings, not a 1D list: roomy cards with the
       photo on top, flowing into as many columns as fit. */
    :global(#edit-list .group-rows) {
      display: grid;
      gap: 0.75rem;
      grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    }
    :global(#edit-list li.row-card) {
      display: grid;
      align-content: start;
      gap: 0.6rem;
    }
    :global(#edit-list img.thumb) {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
    }
    /* Trash is a waiting shelf, not the show: compact horizontal rows
       with small thumbs — never the big photo-on-top cards. Drafts
       wear the same cards as Available: they are future inventory. */
    :global(#edit-list .trash-fold .group-rows) {
      grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    }
    :global(#edit-list .trash-fold li.row-card) {
      display: flex;
      gap: 0.6rem;
      align-items: center;
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
    }
    :global(#edit-list .trash-fold img.thumb) {
      width: 3rem;
      height: 3rem;
    }
  }
</style>
